<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%- title %> | <%- schoolName %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body>
  <!-- Sidebar -->
  <div class="wrapper d-flex">
    <nav class="sidebar" id="sidebar">
      <div class="sidebar-header">
        <div class="logo-wrap d-flex align-items-center">
          <img src="/img/logo.png" alt="Logo" class="rounded-circle bg-white p-1 shadow-sm flex-shrink-0" style="width: 44px; height: 44px; object-fit: contain;">
          <div class="ms-2">
            <div class="fw-bold" style="font-size:0.82rem;line-height:1.2;color:#fff;"><%- schoolName %></div>
            <div style="font-size:0.65rem;color:#a8b8d8;line-height:1.2;margin-top:2px;">
              <i class="fa-solid fa-location-dot me-1"></i><%- schoolAddress %>
            </div>
          </div>
        </div>
      </div>

      <% if(user && user.role === 'admin') { %>
      <ul class="sidebar-nav">
        <li><a href="/admin"><i class="fa-solid fa-gauge-high"></i> Dashboard</a></li>
        <li class="nav-header">Academic</li>
        <li><a href="/admin/students"><i class="fa-solid fa-user-graduate"></i> Students</a></li>
        <li><a href="/admin/students/promote"><i class="fa-solid fa-graduation-cap"></i> Academic Transition &amp; Promote</a></li>
        <li><a href="/admin/teachers"><i class="fa-solid fa-chalkboard-user"></i> Teachers</a></li>
        <li><a href="/admin/classes"><i class="fa-solid fa-door-open"></i> Classes</a></li>
        <li><a href="/admin/classes/student-list"><i class="fa-solid fa-list-check"></i> Class Student List</a></li>
        <li><a href="/admin/subjects"><i class="fa-solid fa-book"></i> Subjects</a></li>
        <li><a href="/admin/homework"><i class="fa-solid fa-book-open"></i> Homework</a></li>
        <li class="nav-header">Operations</li>
        <li><a href="/admin/attendance"><i class="fa-solid fa-clipboard-check"></i> Attendance</a></li>
        <li><a href="/admin/attendance/report"><i class="fa-solid fa-chart-bar"></i> Att. Report</a></li>
        <li><a href="/admin/leaves"><i class="fa-solid fa-envelope-open-text"></i> Student Leaves</a></li>
        <li><a href="/admin/contact-requests"><i class="fa-solid fa-user-pen"></i> Contact Updates</a></li>
        <li class="nav-header">Finance</li>
        <li><a href="/admin/fees"><i class="fa-solid fa-indian-rupee-sign"></i> Fee Structure</a></li>
        <li><a href="/admin/fees/collect"><i class="fa-solid fa-hand-holding-dollar"></i> Collect Fees</a></li>
        <li><a href="/admin/fees/history"><i class="fa-solid fa-clock-rotate-left"></i> Fee Payment History</a></li>
        <li><a href="/admin/fees/pending"><i class="fa-solid fa-circle-exclamation"></i> Pending Fees</a></li>
        <li class="nav-header">Results</li>
        <li><a href="/admin/results"><i class="fa-solid fa-file-pen"></i> Results &amp; Exams</a></li>
        <li><a href="/admin/results/class-marks"><i class="fa-solid fa-table-list"></i> Class Marks Sheet</a></li>
        <li class="nav-header">Media &amp; Notice</li>
        <li><a href="/admin/gallery"><i class="fa-solid fa-images"></i> School Gallery</a></li>
        <li><a href="/admin/notices"><i class="fa-solid fa-bullhorn"></i> Notices</a></li>
        <li class="nav-header">System &amp; Settings</li>
        <li><a href="/admin/settings"><i class="fa-solid fa-sliders"></i> School Settings</a></li>
        <li><a href="/admin/change-password"><i class="fa-solid fa-key"></i> Change Password</a></li>
      </ul>
      <% } else if(user && user.role === 'teacher') { %>
      <ul class="sidebar-nav">
        <li><a href="/teacher"><i class="fa-solid fa-gauge-high"></i> Dashboard</a></li>
        <li class="nav-header">My Work</li>
        <li><a href="/teacher/attendance"><i class="fa-solid fa-clipboard-check"></i> Mark Attendance</a></li>
        <li><a href="/teacher/attendance/report"><i class="fa-solid fa-chart-bar"></i> Att. Report</a></li>
        <li><a href="/teacher/homework"><i class="fa-solid fa-book-open"></i> Homework &amp; Tasks</a></li>
        <li><a href="/teacher/results"><i class="fa-solid fa-file-pen"></i> Results Entry</a></li>
        <li><a href="/teacher/students"><i class="fa-solid fa-users"></i> My Students</a></li>
        <li class="nav-header">Media</li>
        <li><a href="/teacher/gallery"><i class="fa-solid fa-images"></i> School Gallery</a></li>
      </ul>
      <% } else if(user && user.role === 'student') { %>
      <ul class="sidebar-nav">
        <li><a href="/student"><i class="fa-solid fa-gauge-high"></i> Dashboard</a></li>
        <li class="nav-header">My Information</li>
        <li><a href="/student/profile"><i class="fa-solid fa-id-card"></i> My Full Profile</a></li>
        <li><a href="/student/history"><i class="fa-solid fa-clock-rotate-left"></i> Academic &amp; Fee History</a></li>
        <li><a href="/student/attendance"><i class="fa-solid fa-clipboard-check"></i> My Attendance</a></li>
        <li class="nav-header">Academics</li>
        <li><a href="/student/homework"><i class="fa-solid fa-book-open"></i> Homework &amp; Tasks</a></li>
        <li><a href="/student/timetable"><i class="fa-solid fa-calendar-week"></i> School Timetable</a></li>
        <li><a href="/student/notices"><i class="fa-solid fa-bullhorn"></i> Announcements</a></li>
        <li><a href="/student/events"><i class="fa-solid fa-calendar-days"></i> Holidays &amp; Events</a></li>
        <li class="nav-header">Fees &amp; Requests</li>
        <li><a href="/student/fees"><i class="fa-solid fa-indian-rupee-sign"></i> Pending Fees &amp; Receipts</a></li>
        <li><a href="/student/gallery"><i class="fa-solid fa-images"></i> Photo Gallery</a></li>
        <li><a href="/student/leaves"><i class="fa-solid fa-envelope-open-text"></i> Leave Application</a></li>
        <li><a href="/student/contact-update"><i class="fa-solid fa-user-pen"></i> Update Contact Info</a></li>
        <li><a href="/student/contact"><i class="fa-solid fa-headset"></i> Contact School / Teacher</a></li>
      </ul>
      <% } %>

      <div class="sidebar-footer">
        <form action="/logout" method="POST">
          <button type="submit" class="btn btn-outline-danger w-100 btn-sm">
            <i class="fa-solid fa-right-from-bracket me-1"></i> Logout
          </button>
        </form>
      </div>
    </nav>

    <!-- Content -->
    <div class="main-content flex-grow-1 d-flex flex-column">
      <!-- Topbar -->
      <div class="topbar d-flex align-items-center px-4">
        <button class="btn btn-sm btn-outline-secondary me-3" id="sidebarToggle">
          <i class="fa-solid fa-bars"></i>
        </button>
        <div class="me-auto">
          <h6 class="mb-0 fw-semibold text-primary"><%- title %></h6>
          <small class="text-muted d-none d-md-inline">
            <i class="fa-solid fa-school me-1"></i><%- schoolName %>
          </small>
        </div>
        <div class="user-info d-flex align-items-center gap-2">
          <% if(user && user.role === 'admin') { %>
          <a href="/admin/settings" class="btn btn-sm btn-outline-secondary" title="School Settings">
            <i class="fa-solid fa-gear me-1"></i>Settings
          </a>
          <% } %>
          <span class="badge bg-primary"><%- user ? user.role.charAt(0).toUpperCase() + user.role.slice(1) : '' %></span>
          <i class="fa-solid fa-user-circle fa-lg text-muted"></i>
          <span class="fw-semibold"><%- user ? user.name : 'Guest' %></span>
        </div>
      </div>

      <div class="page-content p-4 flex-grow-1">
        <!-- Flash messages -->
        <% if(success_msg && success_msg.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <i class="fa-solid fa-circle-check me-2"></i><%- success_msg %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
        <% } %>
        <% if(error_msg && error_msg.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <i class="fa-solid fa-circle-xmark me-2"></i><%- error_msg %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
        <% } %>

        <%- body %>
      </div>

      <!-- Footer -->
      <footer class="app-footer">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
          <div>
            <i class="fa-solid fa-school me-1 text-warning"></i>
            <strong><%- schoolName %></strong>
            <span class="text-muted ms-2">
              <i class="fa-solid fa-location-dot me-1"></i><%- schoolAddress %>
            </span>
          </div>
          <div class="text-muted small">
            <i class="fa-solid fa-code me-1"></i>Developed by
            <strong class="text-primary"><%- developedBy %></strong>
            &nbsp;&bull;&nbsp; &copy; <%- new Date().getFullYear() %>
          </div>
        </div>
      </footer>
    </div>
  </div>

  <% if (user) { %>
  <!-- Inactivity Warning Modal -->
  <div class="modal fade" id="sessionExpiryModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="sessionExpiryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content shadow-lg border-warning" style="border-width: 2px;">
        <div class="modal-header bg-warning bg-opacity-10 py-3">
          <h6 class="modal-title fw-bold text-dark mb-0" id="sessionExpiryModalLabel">
            <i class="fa-solid fa-triangle-exclamation text-warning me-2 fa-lg"></i> Session Inactivity Warning
          </h6>
        </div>
        <div class="modal-body py-4">
          <p class="text-secondary mb-3">
            You have been inactive for several minutes. For your security, you will be automatically signed out in:
          </p>
          <div class="text-center my-3">
            <span id="sessionCountdownBadge" class="badge bg-danger px-3 py-2 fs-5">
              <i class="fa-regular fa-clock me-1"></i> <span id="sessionCountdownSeconds">120</span>s
            </span>
          </div>
          <p class="small text-muted text-center mb-0">
            Click <strong>Stay Signed In</strong> below or interact with the page to keep working.
          </p>
        </div>
        <div class="modal-footer bg-light py-2">
          <form action="/logout" method="POST" class="d-inline">
            <button type="submit" class="btn btn-outline-secondary btn-sm">
              <i class="fa-solid fa-right-from-bracket me-1"></i> Logout Now
            </button>
          </form>
          <button type="button" class="btn btn-primary btn-sm px-3" id="btnStaySignedIn">
            <i class="fa-solid fa-arrow-rotate-right me-1"></i> Stay Signed In
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
  (function () {
    // Session Inactivity & Security Guard
    const userRole = '<%- user.role %>';
    const inactivityLimitMinutes = <%- sessionTimeoutMinutes || 15 %>;
    const INACTIVITY_LIMIT_MS = inactivityLimitMinutes * 60 * 1000;
    const WARNING_BEFORE_EXPIRY_MS = 2 * 60 * 1000; // Show warning 2 mins before expiry
    const WARNING_TRIGGER_MS = INACTIVITY_LIMIT_MS - WARNING_BEFORE_EXPIRY_MS;

    let lastActivityTime = Date.now();
    let warningModalInstance = null;
    let countdownInterval = null;
    let isWarningShown = false;
    let lastServerPingTime = Date.now();

    function getModal() {
      if (!warningModalInstance && window.bootstrap) {
        const el = document.getElementById('sessionExpiryModal');
        if (el) warningModalInstance = new bootstrap.Modal(el);
      }
      return warningModalInstance;
    }

    function pingServerKeepalive() {
      lastServerPingTime = Date.now();
      fetch('/api/session-ping')
        .then(res => {
          if (res.status === 401) {
            window.location.href = '/login/' + userRole + '?reason=expired';
          }
        })
        .catch(() => {});
    }

    function resetActivity(triggerServerPing = false) {
      lastActivityTime = Date.now();
      if (isWarningShown) {
        hideWarning();
      }
      // Throttle client-to-server keepalives: at most once every 60 seconds of continuous usage
      if (triggerServerPing || (Date.now() - lastServerPingTime > 60 * 1000)) {
        pingServerKeepalive();
      }
    }

    function showWarning() {
      isWarningShown = true;
      const modal = getModal();
      if (modal) modal.show();

      updateCountdownDisplay();
      if (countdownInterval) clearInterval(countdownInterval);
      countdownInterval = setInterval(updateCountdownDisplay, 1000);
    }

    function hideWarning() {
      isWarningShown = false;
      if (countdownInterval) {
        clearInterval(countdownInterval);
        countdownInterval = null;
      }
      const modal = getModal();
      if (modal) modal.hide();
    }

    function updateCountdownDisplay() {
      const now = Date.now();
      const elapsed = now - lastActivityTime;
      const remainingMs = Math.max(0, INACTIVITY_LIMIT_MS - elapsed);
      const remainingSec = Math.ceil(remainingMs / 1000);

      const countEl = document.getElementById('sessionCountdownSeconds');
      if (countEl) countEl.textContent = remainingSec;

      if (remainingMs <= 0) {
        hideWarning();
        window.location.href = '/login/' + userRole + '?reason=inactivity';
      }
    }

    // Monitor user interaction events
    const interactionEvents = ['mousemove', 'mousedown', 'keydown', 'scroll', 'touchstart'];
    let eventThrottleTimer = null;
    interactionEvents.forEach(evt => {
      window.addEventListener(evt, () => {
        if (!eventThrottleTimer) {
          eventThrottleTimer = setTimeout(() => {
            eventThrottleTimer = null;
            if (!isWarningShown) {
              lastActivityTime = Date.now();
            }
          }, 1000);
        }
      }, { passive: true });
    });

    // Stay Signed In button
    const stayBtn = document.getElementById('btnStaySignedIn');
    if (stayBtn) {
      stayBtn.addEventListener('click', () => {
        resetActivity(true);
      });
    }

    // Main ticker: checks every 2 seconds
    setInterval(() => {
      const elapsed = Date.now() - lastActivityTime;
      if (elapsed >= INACTIVITY_LIMIT_MS) {
        hideWarning();
        window.location.href = '/login/' + userRole + '?reason=inactivity';
      } else if (elapsed >= WARNING_TRIGGER_MS && !isWarningShown) {
        showWarning();
      }
    }, 2000);
  })();
  </script>
  <% } %>

  <script>
  // Anti-Bfcache guard: Force reload if navigated via browser Back/Forward cache
  window.addEventListener('pageshow', function (event) {
    if (event.persisted || (window.performance && window.performance.getEntriesByType && window.performance.getEntriesByType('navigation')[0] && window.performance.getEntriesByType('navigation')[0].type === 'back_forward')) {
      window.location.reload();
    }
  });
  </script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
