<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%- title %> | <%- schoolName %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/style.css"/>
  <style>
    body { font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif; }
  </style>
</head>
<body class="auth-body">
  <%- body %>

  <!-- Auth Footer -->
  <div class="text-center mt-3 pb-2 text-white-50" style="font-size:0.78rem; position:relative; z-index:2;">
    <div>
      <i class="fa-solid fa-code me-1 text-warning"></i>Developed by <strong class="text-white"><%- developedBy %></strong>
      &nbsp;&bull;&nbsp; &copy; <%- new Date().getFullYear() %> <%- schoolName %>
    </div>
    <div class="small text-white-50 mt-1 opacity-75">
      <i class="fa-solid fa-shield-halved me-1"></i>Secure Institutional Management System
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
