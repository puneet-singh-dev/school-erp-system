<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%- title %> | <%- schoolName %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body class="auth-body">
  <%- body %>
  <!-- Auth Footer -->
  <div class="text-center mt-3 pb-3" style="color:rgba(255,255,255,0.5);font-size:0.75rem;">
    <i class="fa-solid fa-code me-1"></i>Developed by <strong style="color:rgba(255,255,255,0.75);"><%- developedBy %></strong>
    &nbsp;&bull;&nbsp; &copy; <%- new Date().getFullYear() %> <%- schoolName %>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
