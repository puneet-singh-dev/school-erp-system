<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2 d-print-none">
  <div>
    <h5 class="fw-bold mb-1"><i class="fa-solid fa-list-check text-primary me-2"></i>Class Report &amp; Student List</h5>
    <p class="text-muted small mb-0">View, print, and download official student roll lists for any class.</p>
  </div>
  <div class="d-flex flex-wrap gap-2">
    <% if(selectedClass) { %>
      <a href="/admin/students/promote" class="btn btn-warning text-dark fw-bold">
        <i class="fa-solid fa-graduation-cap me-1"></i>Academic Year Transition
      </a>
      <a href="/admin/classes/student-list-pdf/<%- selectedClass.id %>" target="_blank" class="btn btn-danger">
        <i class="fa-solid fa-file-pdf me-1"></i>Download Official PDF
      </a>
      <button onclick="window.print()" class="btn btn-outline-secondary">
        <i class="fa-solid fa-print me-1"></i>Print Sheet
      </button>
    <% } %>
    <a href="/admin/classes" class="btn btn-outline-primary">
      <i class="fa-solid fa-door-open me-1"></i>Manage Classes
    </a>
  </div>
</div>

<!-- Class Selector Card (Hidden on Print) -->
<div class="card shadow-sm border-0 mb-4 d-print-none">
  <div class="card-body">
    <form method="GET" action="/admin/classes/student-list" class="row g-3 align-items-end">
      <div class="col-md-5">
        <label class="form-label fw-semibold">Select Class &amp; Section <span class="text-danger">*</span></label>
        <select name="class_id" class="form-select" onchange="this.form.submit()">
          <option value="">-- Choose a Class --</option>
          <% classes.forEach(c => { %>
            <option value="<%- c.id %>" <%- selectedClass && selectedClass.id === c.id ? 'selected' : '' %>>
              <%- c.name %> - Section <%- c.section %> (<%- c.academic_year || '2026-27' %>)
            </option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-3">
        <button type="submit" class="btn btn-primary w-100">
          <i class="fa-solid fa-filter me-1"></i>Load Student List
        </button>
      </div>
      <% if(selectedClass) { %>
        <div class="col-md-4 text-md-end text-muted small pt-2">
          Class Teacher: <strong class="text-dark"><%- selectedClass.teacher_name || 'Not assigned' %></strong>
        </div>
      <% } %>
    </form>
  </div>
</div>

<!-- Print-Only Official Header -->
<div class="d-none d-print-block mb-4 text-center border-bottom pb-3">
  <h3 class="fw-bold mb-1 text-uppercase"><%- schoolName %></h3>
  <div class="small text-muted"><%- schoolAddress %> | Mobile: <%- schoolPhone %></div>
  <h5 class="fw-bold mt-2 text-decoration-underline">OFFICIAL CLASS STUDENT LIST &amp; ROLL SHEET</h5>
  <% if(selectedClass) { %>
    <div class="d-flex justify-content-between align-items-center mt-2 px-2 small fw-bold">
      <span>Class: <%- selectedClass.name %> - <%- selectedClass.section %></span>
      <span>Session: <%- selectedClass.academic_year || '2026-27' %></span>
      <span>Class Teacher: <%- selectedClass.teacher_name || 'Not assigned' %></span>
      <span>Total Enrolled: <%- students.length %></span>
      <span>Date: <%- new Date().toLocaleDateString('en-IN') %></span>
    </div>
  <% } %>
</div>

<% if(selectedClass) { %>
  <!-- Stats Row (Screen Only) -->
  <div class="row g-3 mb-4 d-print-none">
    <div class="col-sm-6 col-lg-3">
      <div class="card bg-primary text-white border-0 shadow-sm p-3">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <div class="small opacity-75 text-uppercase fw-semibold">Total Students</div>
            <h3 class="fw-bold mb-0"><%- students.length %></h3>
          </div>
          <i class="fa-solid fa-users fa-2x opacity-50"></i>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card bg-info text-white border-0 shadow-sm p-3">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <div class="small opacity-75 text-uppercase fw-semibold">Boys / Girls</div>
            <h3 class="fw-bold mb-0">
              <%- students.filter(s => (s.gender||'').toLowerCase() === 'male').length %> / 
              <%- students.filter(s => (s.gender||'').toLowerCase() === 'female').length %>
            </h3>
          </div>
          <i class="fa-solid fa-venus-mars fa-2x opacity-50"></i>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card bg-success text-white border-0 shadow-sm p-3">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <div class="small opacity-75 text-uppercase fw-semibold">School Van / Transport</div>
            <h3 class="fw-bold mb-0"><%- students.filter(s => s.uses_transport == 1 || s.uses_transport === true).length %></h3>
          </div>
          <i class="fa-solid fa-van-shuttle fa-2x opacity-50"></i>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card bg-warning text-dark border-0 shadow-sm p-3">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <div class="small opacity-75 text-uppercase fw-semibold">Previous Balance</div>
            <h3 class="fw-bold mb-0"><%- students.filter(s => parseFloat(s.previous_balance || 0) > 0).length %></h3>
          </div>
          <i class="fa-solid fa-clock-rotate-left fa-2x opacity-50"></i>
        </div>
      </div>
    </div>
  </div>

  <!-- Students Table -->
  <div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center d-print-none">
      <h6 class="fw-bold mb-0">
        <i class="fa-solid fa-users-viewfinder text-primary me-2"></i>
        Enrolled Students in <%- selectedClass.name %> - Section <%- selectedClass.section %>
        <span class="badge bg-primary ms-2"><%- students.length %></span>
      </h6>
      <div class="small text-muted">
        Class Teacher: <strong class="text-dark"><%- selectedClass.teacher_name || 'Not assigned' %></strong>
      </div>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle mb-0">
          <thead class="table-dark">
            <tr>
              <th class="text-center" style="width: 45px;">#</th>
              <th class="text-center" style="width: 70px;">Roll No</th>
              <th style="width: 110px;">Adm No</th>
              <th>Student Name</th>
              <th>Father's Name</th>
              <th>Mother's Name</th>
              <th>Mobile / Phone</th>
              <th>Van / Route</th>
              <th>DOB</th>
              <th class="text-center">Gender</th>
              <th class="text-end d-print-none" style="width: 140px;">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if(students.length > 0) { %>
              <% students.forEach((s, idx) => { %>
                <tr>
                  <td class="text-center fw-semibold text-muted"><%- idx + 1 %></td>
                  <td class="text-center">
                    <span class="badge bg-secondary px-2"><%- s.roll_number != null ? s.roll_number : '-' %></span>
                  </td>
                  <td>
                    <span class="fw-semibold text-primary"><%- s.admission_no || '-' %></span>
                  </td>
                  <td>
                    <div class="fw-bold text-dark"><%- s.name %></div>
                    <% if(parseFloat(s.previous_balance || 0) > 0) { %>
                      <span class="badge bg-warning text-dark small" title="Previous Class Balance">
                        Prev Bal: ₹<%- parseFloat(s.previous_balance).toLocaleString('en-IN') %>
                      </span>
                    <% } %>
                  </td>
                  <td><%- s.father_name || '-' %></td>
                  <td><%- s.mother_name || '-' %></td>
                  <td>
                    <% if(s.phone) { %>
                      <a href="tel:<%- s.phone %>" class="text-decoration-none text-dark">
                        <i class="fa-solid fa-phone text-success small me-1"></i><%- s.phone %>
                      </a>
                    <% } else if(s.guardian_phone) { %>
                      <%- s.guardian_phone %>
                    <% } else { %>
                      <span class="text-muted">-</span>
                    <% } %>
                  </td>
                  <td>
                    <% if(s.uses_transport == 1 || s.uses_transport === true) { %>
                      <span class="badge bg-info text-dark">
                        <i class="fa-solid fa-van-shuttle me-1"></i><%- s.transport_route || 'Adopted' %>
                      </span>
                    <% } else { %>
                      <span class="text-muted small">Self</span>
                    <% } %>
                  </td>
                  <td class="small">
                    <%- s.date_of_birth ? new Date(s.date_of_birth).toLocaleDateString('en-IN') : '-' %>
                  </td>
                  <td class="text-center">
                    <% if((s.gender||'').toLowerCase() === 'male') { %>
                      <span class="badge bg-light text-primary border">M</span>
                    <% } else if((s.gender||'').toLowerCase() === 'female') { %>
                      <span class="badge bg-light text-danger border">F</span>
                    <% } else { %>
                      <span class="text-muted">-</span>
                    <% } %>
                  </td>
                  <td class="text-end d-print-none">
                    <a href="/admin/students/history/<%- s.id %>" class="btn btn-sm btn-outline-info" title="Academic & Fee History">
                      <i class="fa-solid fa-clock-rotate-left"></i>
                    </a>
                    <a href="/admin/fees/collect?class_id=<%- selectedClass.id %>&student_id=<%- s.id %>" class="btn btn-sm btn-outline-success" title="Fees">
                      <i class="fa-solid fa-indian-rupee-sign"></i>
                    </a>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="11" class="text-center py-5 text-muted">
                  <i class="fa-solid fa-user-slash fa-2x mb-2 d-block opacity-50"></i>
                  No students are enrolled in this class yet.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Print-Only Signatures -->
  <div class="d-none d-print-block mt-5 pt-4">
    <div class="d-flex justify-content-between text-center px-4">
      <div style="width: 200px; border-top: 1px solid #333; padding-top: 5px;">
        <strong>Class Teacher's Signature</strong>
      </div>
      <div style="width: 200px; border-top: 1px solid #333; padding-top: 5px;">
        <strong>Checked By / Incharge</strong>
      </div>
      <div style="width: 200px; border-top: 1px solid #333; padding-top: 5px;">
        <strong>Principal's Seal &amp; Signature</strong>
      </div>
    </div>
  </div>

<% } else { %>
  <div class="card shadow-sm border-0 py-5 text-center">
    <div class="card-body">
      <i class="fa-solid fa-chalkboard-user fa-3x text-secondary opacity-50 mb-3"></i>
      <h5 class="fw-bold">Please Select a Class</h5>
      <p class="text-muted small">Choose any class and section from the dropdown above to load the student list and download the report.</p>
    </div>
  </div>
<% } %>

<style>
@media print {
  .app-sidebar, .topbar, .app-footer, .btn, .d-print-none {
    display: none !important;
  }
  .main-content {
    margin: 0 !important;
    padding: 0 !important;
  }
  .card {
    border: none !important;
    box-shadow: none !important;
  }
  table {
    font-size: 11px !important;
  }
  th, td {
    padding: 4px 6px !important;
  }
}
</style>
