<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h5 class="fw-bold mb-1"><i class="fa-solid fa-user-pen text-primary me-2"></i>Student Contact Update Requests</h5>
    <small class="text-muted">Review and approve changes to student phone numbers, emergency contacts, and addresses</small>
  </div>
  <a href="/admin" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-arrow-left me-1"></i>Back to Dashboard</a>
</div>

<div class="card shadow-sm border-0">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Student</th>
            <th>Class</th>
            <th>Current Info</th>
            <th>Requested Changes</th>
            <th>Status</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if(requests && requests.length > 0) { %>
            <% requests.forEach(r => { %>
              <tr>
                <td>
                  <div class="fw-bold text-dark"><%- r.student_name %></div>
                  <small class="text-muted">Adm: <%- r.admission_no %></small>
                </td>
                <td>
                  <span class="badge bg-light text-dark border"><%- r.class_name %> - <%- r.section %></span>
                </td>
                <td class="small">
                  <div><strong>Phone:</strong> <%- r.current_phone || 'None' %></div>
                  <div><strong>Emergency:</strong> <%- r.current_emergency || 'None' %></div>
                  <div class="text-truncate" style="max-width: 180px;"><strong>Address:</strong> <%- r.current_address || 'None' %></div>
                </td>
                <td class="small">
                  <% if(r.new_phone) { %><div class="text-primary"><strong>New Phone:</strong> <%- r.new_phone %></div><% } %>
                  <% if(r.new_emergency_contact) { %><div class="text-primary"><strong>New Emergency:</strong> <%- r.new_emergency_contact %></div><% } %>
                  <% if(r.new_address) { %><div class="text-primary"><strong>New Address:</strong> <%- r.new_address %></div><% } %>
                  <% if(r.message) { %><div class="text-muted fst-italic">Reason: <%- r.message %></div><% } %>
                </td>
                <td>
                  <% if(r.status === 'Approved') { %>
                    <span class="badge bg-success"><i class="fa-solid fa-check me-1"></i>Approved</span>
                  <% } else if(r.status === 'Rejected') { %>
                    <span class="badge bg-danger"><i class="fa-solid fa-xmark me-1"></i>Rejected</span>
                  <% } else { %>
                    <span class="badge bg-warning text-dark"><i class="fa-solid fa-hourglass-half me-1"></i>Pending</span>
                  <% } %>
                </td>
                <td class="text-end">
                  <% if(r.status === 'Pending') { %>
                    <div class="btn-group btn-group-sm">
                      <form action="/admin/contact-requests/<%- r.id %>/approve" method="POST" class="d-inline">
                        <button type="submit" class="btn btn-outline-success btn-sm me-1" title="Approve &amp; Update Record">
                          <i class="fa-solid fa-check me-1"></i>Approve
                        </button>
                      </form>
                      <form action="/admin/contact-requests/<%- r.id %>/reject" method="POST" class="d-inline">
                        <button type="submit" class="btn btn-outline-danger btn-sm" title="Reject Request">
                          <i class="fa-solid fa-xmark me-1"></i>Reject
                        </button>
                      </form>
                    </div>
                  <% } else { %>
                    <small class="text-muted">Reviewed</small>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="6" class="text-center text-muted py-5">
                <i class="fa-solid fa-inbox fs-2 mb-2 d-block opacity-25"></i>
                No contact update requests pending.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
