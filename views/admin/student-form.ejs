<div class="d-flex justify-content-between align-items-center mb-4">
  <h5 class="fw-bold mb-0"><i class="fa-solid fa-user-graduate text-primary me-2"></i><%- student ? 'Edit Student' : 'Add New Student' %></h5>
  <a href="/admin/students" class="btn btn-outline-secondary"><i class="fa-solid fa-arrow-left me-1"></i>Back</a>
</div>

<div class="card shadow-sm">
  <div class="card-body">
    <form action="<%- student ? '/admin/students/edit/' + student.id : '/admin/students/add' %>" method="POST" enctype="multipart/form-data">
      
      <!-- Student Photo & Identification -->
      <h6 class="fw-bold text-primary mb-3"><i class="fa-solid fa-camera me-1"></i> Profile Photo</h6>
      <div class="row g-3 mb-4">
        <div class="col-md-12">
          <div class="d-flex align-items-center gap-4 p-3 bg-light rounded border">
            <div class="position-relative">
              <img id="photoPreview" 
                   src="<%- student && student.profile_photo && student.profile_photo !== 'default.png' ? '/uploads/students/' + student.profile_photo : 'https://ui-avatars.com/api/?name=' + encodeURIComponent(student ? student.name : 'Student') + '&size=128&background=0D8ABC&color=fff' %>" 
                   alt="Profile Photo" 
                   class="rounded-circle border border-3 border-white shadow-sm" 
                   style="width: 90px; height: 90px; object-fit: cover;">
            </div>
            <div class="flex-grow-1" style="max-width: 420px;">
              <label class="form-label fw-semibold mb-1">Upload Student Photo</label>
              <input type="file" name="profile_photo" id="photoInput" class="form-control" accept="image/*" onchange="previewPhoto(this)">
              <small class="text-muted">Accepted formats: JPG, PNG, WEBP (Max: 5MB)</small>
            </div>
          </div>
        </div>
      </div>

      <!-- Personal Information -->
      <h6 class="fw-bold text-primary mb-3"><i class="fa-solid fa-user me-1"></i> Personal Information</h6>
      <div class="row g-3 mb-4">
        <div class="col-md-4">
          <label class="form-label">Full Name *</label>
          <input type="text" name="name" class="form-control" value="<%- student ? student.name : '' %>" required>
        </div>
        <div class="col-md-4">
          <label class="form-label">Email <small class="text-muted">(Optional)</small></label>
          <input type="email" name="email" class="form-control" value="<%- student ? student.email : '' %>" placeholder="Optional (auto-generated if empty)">
        </div>
        <div class="col-md-4">
          <label class="form-label">Registered Mobile Phone *</label>
          <input type="text" name="phone" class="form-control" value="<%- student ? student.phone : '' %>" placeholder="10-digit mobile number (used as login password)">
        </div>
        <% if(!student) { %>
        <div class="col-md-4">
          <label class="form-label">Password <small class="text-muted">(default: Mobile No)</small></label>
          <input type="password" name="password" class="form-control" placeholder="Leave blank to use Mobile No">
        </div>
        <% } %>
        <div class="col-md-4">
          <label class="form-label">Date of Birth</label>
          <input type="date" name="date_of_birth" class="form-control" value="<%- student && student.date_of_birth ? new Date(student.date_of_birth).toISOString().split('T')[0] : '' %>">
        </div>
        <div class="col-md-4">
          <label class="form-label">Gender</label>
          <select name="gender" class="form-select">
            <option value="">Select Gender</option>
            <% ['Male','Female','Other'].forEach(g => { %>
            <option <%- student && student.gender === g ? 'selected' : '' %>><%- g %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-4">
          <label class="form-label">Blood Group</label>
          <select name="blood_group" class="form-select">
            <option value="">Select Blood Group</option>
            <% ['A+', 'A-', 'B+', 'B-', 'O+', 'O-', 'AB+', 'AB-'].forEach(bg => { %>
            <option value="<%- bg %>" <%- student && student.blood_group === bg ? 'selected' : '' %>><%- bg %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-4">
          <label class="form-label">Category</label>
          <select name="category" class="form-select">
            <option value="">Select Category</option>
            <% ['General', 'OBC', 'SC', 'ST', 'EWS'].forEach(cat => { %>
            <option value="<%- cat %>" <%- student && student.category === cat ? 'selected' : '' %>><%- cat %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-4">
          <label class="form-label">Aadhaar Number</label>
          <input type="text" name="aadhaar_no" class="form-control" value="<%- student && student.aadhaar_no ? student.aadhaar_no : '' %>" placeholder="12-digit UIDAI number" maxlength="16">
        </div>
        <div class="col-md-12">
          <label class="form-label">Residential Address</label>
          <textarea name="address" class="form-control" rows="2" placeholder="Full residential address"><%- student ? student.address : '' %></textarea>
        </div>
      </div>

      <!-- Academic Information -->
      <h6 class="fw-bold text-primary mb-3"><i class="fa-solid fa-school me-1"></i> Academic Information</h6>
      <div class="row g-3 mb-4">
        <div class="col-md-4">
          <label class="form-label">
            Admission No
            <% if(!student) { %><span class="badge bg-info ms-1">Auto-generated if blank</span><% } %>
          </label>
          <div class="input-group">
            <input type="text" name="admission_no" id="admissionNo" class="form-control"
              value="<%- student ? student.admission_no : '' %>"
              placeholder="<%- student ? '' : 'e.g. ADM260001 (auto)' %>"
              <%- student ? 'readonly' : '' %>>
            <% if(!student) { %>
            <button type="button" class="btn btn-outline-secondary" onclick="previewAdmNo()" title="Preview next number">
              <i class="fa-solid fa-wand-magic-sparkles"></i>
            </button>
            <% } %>
          </div>
        </div>
        <div class="col-md-4">
          <label class="form-label">Class</label>
          <select name="class_id" id="classSelect" class="form-select" onchange="previewRoll(this.value)">
            <option value="">Select Class</option>
            <% classes.forEach(c => { %>
            <option value="<%- c.id %>" <%- student && student.class_id == c.id ? 'selected' : '' %>><%- c.name %> - <%- c.section %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-4">
          <label class="form-label">
            Roll Number
            <% if(!student) { %><span class="badge bg-info ms-1">Auto-assigned if blank</span><% } %>
          </label>
          <input type="number" name="roll_number" id="rollNo" class="form-control"
            value="<%- student ? student.roll_number : '' %>"
            placeholder="<%- student ? '' : 'Auto after class selection' %>">
        </div>
        <div class="col-md-4">
          <label class="form-label">Admission Date</label>
          <input type="date" name="admission_date" class="form-control" value="<%- student && student.admission_date ? new Date(student.admission_date).toISOString().split('T')[0] : new Date().toISOString().split('T')[0] %>">
        </div>

        <!-- Optional Subject Selection for UP Board (Class 9, 10, 11, 12) -->
        <div class="col-md-8" id="optionalSubjectContainer">
          <label class="form-label fw-semibold">
            <i class="fa-solid fa-shapes text-primary me-1"></i>Optional Subject (UP Board)
            <span class="badge bg-warning text-dark ms-1" id="optionalSubjectBadge">For Class 9, 10, 11, 12</span>
          </label>
          <select name="optional_subject" id="optionalSubjectSelect" class="form-select">
            <option value="">-- Select Optional Subject --</option>
            <optgroup label="Class 9 &amp; 10 (High School)">
              <option value="Drawing" <%- student && /drawing|art|chitrakala/i.test(student.optional_subject || '') ? 'selected' : '' %>>Drawing / Art (चित्रकला)</option>
              <option value="Sanskrit" <%- student && /sanskrit/i.test(student.optional_subject || '') ? 'selected' : '' %>>Sanskrit (संस्कृत)</option>
              <option value="Commerce" <%- student && /commerce/i.test(student.optional_subject || '') ? 'selected' : '' %>>Commerce (वाणिज्य)</option>
              <option value="Computer" <%- student && /computer/i.test(student.optional_subject || '') ? 'selected' : '' %>>Computer / IT</option>
            </optgroup>
            <optgroup label="Class 11 &amp; 12 (Intermediate)">
              <option value="Mathematics" <%- student && (/math/i.test(student.optional_subject || '') && !/applied/i.test(student.optional_subject || '')) ? 'selected' : '' %>>Mathematics (गणित)</option>
              <option value="Biology" <%- student && /bio|biology/i.test(student.optional_subject || '') ? 'selected' : '' %>>Biology (जीव विज्ञान)</option>
              <option value="Commerce with Math" <%- student && /commerce.*math/i.test(student.optional_subject || '') ? 'selected' : '' %>>Commerce with Mathematics</option>
              <option value="Commerce with IP" <%- student && /commerce.*ip/i.test(student.optional_subject || '') ? 'selected' : '' %>>Commerce with IP / PE</option>
              <option value="Arts / Humanities" <%- student && /arts|humanities/i.test(student.optional_subject || '') ? 'selected' : '' %>>Arts / Humanities</option>
            </optgroup>
            <option value="None" <%- student && student.optional_subject === 'None' ? 'selected' : '' %>>None / Not Applicable (Class 1-8)</option>
          </select>
          <div class="form-text small" id="optionalSubjectHint">
            <strong>Class 9 &amp; 10:</strong> Choose <em>Drawing (Art)</em> or <em>Sanskrit</em>. &bull; <strong>Class 11 &amp; 12:</strong> Choose <em>Mathematics</em> or <em>Biology</em>.
          </div>
        </div>
      </div>

      <!-- Parents & Guardian Information -->
      <h6 class="fw-bold text-primary mb-3"><i class="fa-solid fa-people-roof me-1"></i> Parents & Guardian Information</h6>
      <div class="row g-3 mb-4">
        <div class="col-md-6">
          <label class="form-label">Father's Name *</label>
          <input type="text" name="father_name" class="form-control" value="<%- student ? (student.father_name || student.guardian_name || '') : '' %>" placeholder="Father's full name" required>
        </div>
        <div class="col-md-6">
          <label class="form-label">Mother's Name *</label>
          <input type="text" name="mother_name" class="form-control" value="<%- student ? (student.mother_name || '') : '' %>" placeholder="Mother's full name" required>
        </div>
        <div class="col-md-6">
          <label class="form-label">Guardian Phone / WhatsApp</label>
          <input type="text" name="guardian_phone" class="form-control" value="<%- student ? (student.guardian_phone || '') : '' %>" placeholder="Primary contact for SMS & calls">
        </div>
        <div class="col-md-6">
          <label class="form-label">Emergency Contact Number</label>
          <input type="text" name="emergency_contact" class="form-control" value="<%- student && student.emergency_contact ? student.emergency_contact : '' %>" placeholder="Alternative emergency phone">
        </div>
      </div>

      <!-- Previous Class / Session Fee Balance (Arrears) -->
      <h6 class="fw-bold text-danger mb-3"><i class="fa-solid fa-clock-rotate-left me-1"></i> Previous Class / Session Fee Balance</h6>
      <div class="row g-3 mb-4 p-3 bg-light rounded border border-danger-subtle">
        <div class="col-md-5">
          <label class="form-label fw-semibold text-danger">Previous Balance Due (₹)</label>
          <div class="input-group">
            <span class="input-group-text bg-danger text-white">₹</span>
            <input type="number" step="0.01" min="0" name="previous_balance" class="form-control fw-bold"
              value="<%- student && student.previous_balance ? parseFloat(student.previous_balance).toFixed(2) : '0.00' %>"
              placeholder="0.00">
          </div>
          <small class="text-muted">Enter any unpaid fee carried forward from previous class or session.</small>
        </div>
        <div class="col-md-7">
          <label class="form-label fw-semibold">Balance Details / Remarks</label>
          <input type="text" name="previous_balance_remarks" class="form-control"
            value="<%- student && student.previous_balance_remarks ? student.previous_balance_remarks : '' %>"
            placeholder="e.g. Dues from Class 8, Session 2025-26 pending fee">
          <small class="text-muted">Optional note explaining the source of the previous balance.</small>
        </div>
      </div>

      <!-- School Transport / Van Facility -->
      <h6 class="fw-bold text-success mb-3"><i class="fa-solid fa-van-shuttle me-1"></i> School Transport / Van Facility</h6>
      <div class="row g-3 mb-4 p-3 bg-light rounded border border-success-subtle">
        <div class="col-md-3">
          <label class="form-label fw-semibold">Avails School Van / Transport?</label>
          <select name="uses_transport" id="usesTransportSelect" class="form-select" onchange="toggleTransportFields(this.value)">
            <option value="0" <%- !student || !student.uses_transport ? 'selected' : '' %>>No (Own Transport)</option>
            <option value="1" <%- student && student.uses_transport ? 'selected' : '' %>>Yes (School Van)</option>
          </select>
          <small class="text-muted d-block mt-1">Select Yes if student uses school van.</small>
        </div>
        <div class="col-md-5">
          <label class="form-label fw-semibold">Pickup / Drop Route or Stop</label>
          <input type="text" name="transport_route" id="transportRouteInput" class="form-control"
            value="<%- student && student.transport_route ? student.transport_route : '' %>"
            placeholder="e.g. Karma Bazar / Vijay Nagar / Route No. 2">
          <small class="text-muted">Specify the stop name or van route number.</small>
        </div>
        <div class="col-md-4">
          <label class="form-label fw-semibold text-success">Monthly Transport Fee (₹)</label>
          <div class="input-group">
            <span class="input-group-text bg-success text-white">₹</span>
            <input type="number" step="0.01" min="0" name="transport_fee" id="transportFeeInput" class="form-control fw-bold"
              value="<%- student && student.transport_fee ? parseFloat(student.transport_fee).toFixed(2) : '0.00' %>"
              placeholder="0.00">
            <span class="input-group-text small text-muted">/mo</span>
          </div>
          <small class="text-muted">Monthly van fee charged to this student.</small>
        </div>
      </div>

      <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary px-4">
          <i class="fa-solid fa-save me-1"></i><%- student ? 'Update Student' : 'Add Student' %>
        </button>
        <a href="/admin/students" class="btn btn-outline-secondary px-4">Cancel</a>
      </div>
    </form>
  </div>
</div>

<script>
function previewPhoto(input) {
  if (input.files && input.files[0]) {
    const reader = new FileReader();
    reader.onload = function(e) {
      document.getElementById('photoPreview').src = e.target.result;
    };
    reader.readAsDataURL(input.files[0]);
  }
}

function toggleTransportFields(val) {
  const isYes = val === '1' || val === 1 || val === true;
  const select = document.getElementById('usesTransportSelect');
  if (select) select.value = isYes ? '1' : '0';
  if (!isYes) {
    const feeInp = document.getElementById('transportFeeInput');
    if (feeInp && parseFloat(feeInp.value) === 0) feeInp.value = '0.00';
  }
}

function updateOptionalSubjectHint(classSelectEl) {
  const selectedText = classSelectEl && classSelectEl.options[classSelectEl.selectedIndex] ? classSelectEl.options[classSelectEl.selectedIndex].text.toLowerCase() : '';
  const badge = document.getElementById('optionalSubjectBadge');
  const hint = document.getElementById('optionalSubjectHint');
  const optSelect = document.getElementById('optionalSubjectSelect');
  if (!badge || !hint || !optSelect) return;

  if (/\b(9|10|ix|x)\b/i.test(selectedText) && !/\b(11|12|xi|xii)\b/i.test(selectedText)) {
    badge.className = 'badge bg-primary text-white ms-1';
    badge.textContent = 'Required for Class 9 & 10 (Drawing or Sanskrit)';
    hint.innerHTML = '<span class="text-primary fw-bold"><i class="fa-solid fa-circle-info me-1"></i>UP Board High School Rule:</span> Choose <strong>Drawing / Art (चित्रकला)</strong> or <strong>Sanskrit (संस्कृत)</strong>.';
  } else if (/\b(11|12|xi|xii)\b/i.test(selectedText)) {
    badge.className = 'badge bg-success text-white ms-1';
    badge.textContent = 'Required for Class 11 & 12 (Math or Biology)';
    hint.innerHTML = '<span class="text-success fw-bold"><i class="fa-solid fa-circle-info me-1"></i>UP Board Intermediate Rule:</span> Choose <strong>Mathematics (गणित)</strong> or <strong>Biology (जीव विज्ञान)</strong>.';
  } else if (selectedText) {
    badge.className = 'badge bg-light text-muted border ms-1';
    badge.textContent = 'Not required for Class 1 to 8';
    hint.innerHTML = '<span class="text-muted">All subjects are compulsory in Class 1 to 8 common curriculum. Optional subject set to None.</span>';
  }
}

document.addEventListener('DOMContentLoaded', function () {
  const clsSel = document.getElementById('classSelect');
  if (clsSel) {
    clsSel.addEventListener('change', function () { updateOptionalSubjectHint(this); });
    updateOptionalSubjectHint(clsSel);
  }
});
  const feeInp = document.getElementById('transportFeeInput');
  const routeInp = document.getElementById('transportRouteInput');
  const select = document.getElementById('usesTransportSelect');
  if (feeInp && select) {
    feeInp.addEventListener('input', function () {
      if (parseFloat(this.value) > 0) {
        select.value = '1';
      }
    });
  }
  if (routeInp && select) {
    routeInp.addEventListener('input', function () {
      if (this.value.trim().length > 0) {
        select.value = '1';
      }
    });
  }
});

<% if(!student) { %>
async function previewAdmNo() {
  const r = await fetch('/admin/api/next-ids');
  const d = await r.json();
  document.getElementById('admissionNo').value = d.admission_no;
  document.getElementById('admissionNo').placeholder = '';
}
async function previewRoll(classId) {
  if (!classId) return;
  const r = await fetch('/admin/api/next-ids?class_id=' + classId);
  const d = await r.json();
  if (!document.getElementById('rollNo').value) {
    document.getElementById('rollNo').placeholder = 'Next: ' + d.roll_number;
  }
}
window.addEventListener('load', () => {
  const sel = document.getElementById('classSelect');
  if (sel && sel.value) previewRoll(sel.value);
});
<% } %>
</script>
