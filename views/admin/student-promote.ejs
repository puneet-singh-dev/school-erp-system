<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <div>
    <h5 class="fw-bold mb-1 text-dark">
      <i class="fa-solid fa-graduation-cap text-primary me-2"></i>Academic Year Transition &amp; School-Wide Promotion
    </h5>
    <small class="text-muted">Advance all classes together into the new academic session, keep Class 1 empty for new admissions, archive Class 12 graduates, and handle student repeaters.</small>
  </div>
  <div class="d-flex gap-2">
    <a href="/admin/students" class="btn btn-outline-secondary">
      <i class="fa-solid fa-arrow-left me-1"></i>Back to Students
    </a>
  </div>
</div>

<!-- ==================== SESSION JUMP BANNER ==================== -->
<div class="card shadow-sm border-0 mb-4 overflow-hidden">
  <div class="card-header bg-primary text-white py-3">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
      <div class="d-flex align-items-center gap-2">
        <i class="fa-solid fa-calendar-days fs-5 text-warning"></i>
        <h6 class="mb-0 fw-bold">Academic Session Transition Pipeline</h6>
      </div>
      <span class="badge bg-white text-primary fw-bold px-3 py-2">
        Current Active Session: <%- currentAcademicYear %>
      </span>
    </div>
  </div>
  <div class="card-body p-4 bg-light">
    <!-- Visual Progression Ladder -->
    <div class="p-3 bg-white rounded border mb-4 shadow-xs">
      <div class="small fw-bold text-uppercase text-muted mb-2">
        <i class="fa-solid fa-arrows-split-up-and-left text-primary me-1"></i>Automated School-Wide Promotion Ladder:
      </div>
      <div class="d-flex flex-wrap align-items-center gap-2 font-monospace small">
        <span class="badge bg-dark px-3 py-2">Class 1 &rarr; Class 2</span>
        <i class="fa-solid fa-arrow-right text-muted small"></i>
        <span class="badge bg-dark px-3 py-2">Class 2 &rarr; Class 3</span>
        <i class="fa-solid fa-arrow-right text-muted small"></i>
        <span class="badge bg-secondary px-3 py-2">Class 3 ... Class 7 &rarr; Class 8</span>
        <i class="fa-solid fa-arrow-right text-muted small"></i>
        <span class="badge bg-info text-dark px-3 py-2" title="UP Board Drawing vs Sanskrit">Class 8 &rarr; Class 9</span>
        <i class="fa-solid fa-arrow-right text-muted small"></i>
        <span class="badge bg-info text-dark px-3 py-2">Class 9 &rarr; Class 10</span>
        <i class="fa-solid fa-arrow-right text-muted small"></i>
        <span class="badge bg-success text-white px-3 py-2" title="UP Board Math vs Biology">Class 10 &rarr; Class 11</span>
        <i class="fa-solid fa-arrow-right text-muted small"></i>
        <span class="badge bg-success text-white px-3 py-2">Class 11 &rarr; Class 12</span>
        <i class="fa-solid fa-arrow-right text-muted small"></i>
        <span class="badge bg-warning text-dark px-3 py-2 fw-bold">Class 12 &rarr; Graduated Alumni (<%- currentAcademicYear %>)</span>
      </div>
    </div>

    <!-- Rule Guide Callout -->
    <div class="alert alert-info border-0 shadow-xs mb-0 small">
      <div class="d-flex gap-2">
        <i class="fa-solid fa-circle-info fs-5 text-primary mt-1"></i>
        <div>
          <strong>How Academic Year Transition Works:</strong>
          <ul class="mb-0 ps-3 mt-1">
            <li><strong>All Classes Advance Simultaneously:</strong> Eliminates conflicts where promoting Class 1 overwrote Class 2 students. Every student moves to their new grade at the exact same time.</li>
            <li><strong>Class 1 Becomes Empty:</strong> All Class 1 students jump to Class 2. Class 1 for session <span class="fw-bold text-dark"><%- newAcademicYear %></span> starts with <strong>0 students</strong>, completely empty and ready for fresh admissions!</li>
            <li><strong>Class 12 Graduates:</strong> Class 12 students are safely archived under Class 12 of <span class="fw-bold text-dark"><%- currentAcademicYear %></span>. Their marks, report cards, and receipts are permanently preserved.</li>
            <li><strong>Repeaters / Failed Students / Parent Requests:</strong> If a student failed (below 33%) or their parent requested to keep them in the same class, select <strong>"Retain in Same Class"</strong> &mdash; they will stay in that class for session <%- newAcademicYear %> alongside the new incoming batch.</li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <!-- Stats Strip -->
  <div class="card-footer bg-white py-3 border-top">
    <div class="row g-3 text-center">
      <div class="col-md-3 col-6 border-end">
        <small class="text-muted text-uppercase fw-semibold" style="font-size:0.75rem;">Total Students Enrolled</small>
        <h4 class="fw-bold text-dark mb-0 mt-1"><%- stats.totalSchoolStudents %></h4>
      </div>
      <div class="col-md-3 col-6 border-end">
        <small class="text-muted text-uppercase fw-semibold" style="font-size:0.75rem;">Eligible for Promotion</small>
        <h4 class="fw-bold text-success mb-0 mt-1"><%- stats.totalEligiblePassed %></h4>
      </div>
      <div class="col-md-3 col-6 border-end">
        <small class="text-muted text-uppercase fw-semibold" style="font-size:0.75rem;">Failed / Retained Review</small>
        <h4 class="fw-bold <%- stats.totalFailed > 0 ? 'text-danger' : 'text-muted' %> mb-0 mt-1"><%- stats.totalFailed %></h4>
      </div>
      <div class="col-md-3 col-6">
        <small class="text-muted text-uppercase fw-semibold" style="font-size:0.75rem;">Pending Fees to Carry Forward</small>
        <h4 class="fw-bold <%- stats.totalFeesDue > 0 ? 'text-danger' : 'text-success' %> mb-0 mt-1">₹<%- stats.totalFeesDue.toLocaleString('en-IN') %></h4>
      </div>
    </div>
  </div>
</div>

<!-- ==================== PROMOTION WORKBENCH FORM ==================== -->
<form action="/admin/students/promote" method="POST" id="schoolTransitionForm">
  <input type="hidden" name="current_academic_year" value="<%- currentAcademicYear %>">

  <!-- Top Configuration Bar -->
  <div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
      <div class="row g-3 align-items-center">
        <div class="col-md-4">
          <label class="form-label fw-bold small text-dark mb-1">
            Current Academic Session:
          </label>
          <input type="text" class="form-control form-control-sm bg-light fw-bold" value="<%- currentAcademicYear %>" readonly>
        </div>
        <div class="col-md-4">
          <label class="form-label fw-bold small text-primary mb-1">
            New Academic Session to Transition Into: <span class="text-danger">*</span>
          </label>
          <input type="text" name="new_academic_year" id="newAcademicYearInput" class="form-control form-control-sm fw-bold border-primary" 
                 value="<%- newAcademicYear %>" placeholder="e.g. 2027-28" required>
        </div>
        <div class="col-md-4">
          <label class="form-label fw-bold small text-dark mb-1">
            Fee Dues Carry-Over Preference:
          </label>
          <div class="form-check form-switch mt-1">
            <input class="form-check-input" type="checkbox" id="carryForwardCheck" name="carry_forward_fees" value="1" checked>
            <label class="form-check-label small fw-semibold" for="carryForwardCheck">
              Carry forward unpaid dues into new session balance
            </label>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ==================== CLASS-BY-CLASS PROGRESSION TABS ==================== -->
  <div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-dark text-white p-2">
      <ul class="nav nav-pills nav-fill gap-1 flex-wrap" id="classLadderTabs" role="tablist">
        <% ladder.forEach((item, idx) => { %>
          <li class="nav-item" role="presentation">
            <button class="nav-link <%- idx === 0 ? 'active' : '' %> py-2 px-3 fw-bold text-truncate" 
                    id="tab-<%- item.sourceClass.id %>" data-bs-toggle="tab" 
                    data-bs-target="#pane-<%- item.sourceClass.id %>" type="button" role="tab">
              <span class="me-1"><%- item.sourceClass.name %></span>
              <span class="badge bg-secondary ms-1"><%- item.students.length %></span>
              <% if(item.classFailed > 0) { %>
                <span class="badge bg-danger ms-1" title="<%- item.classFailed %> failed students">!</span>
              <% } %>
            </button>
          </li>
        <% }) %>
      </ul>
    </div>

    <div class="card-body p-0">
      <div class="tab-content" id="classLadderTabContent">
        <% ladder.forEach((item, idx) => { %>
          <div class="tab-pane fade <%- idx === 0 ? 'show active' : '' %> p-4" 
               id="pane-<%- item.sourceClass.id %>" role="tabpanel">

            <!-- Class Header Strip -->
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3 pb-3 border-bottom">
              <div>
                <h5 class="fw-bold mb-1 text-dark">
                  <i class="fa-solid fa-door-open text-primary me-2"></i><%- item.sourceClass.name %> - Section <%- item.sourceClass.section || 'A' %>
                </h5>
                <div class="small text-muted">
                  Current Session: <strong><%- currentAcademicYear %></strong> &bull; 
                  Target Next Grade: 
                  <% if(item.isGraduating) { %>
                    <span class="badge bg-warning text-dark fw-bold">🎓 Class 12 Alumni / Graduated Batch (<%- currentAcademicYear %>)</span>
                  <% } else { %>
                    <span class="badge bg-success text-white fw-bold"><i class="fa-solid fa-arrow-up me-1"></i><%- item.targetGradeName %> - Section <%- item.targetSection %> (<%- newAcademicYear %>)</span>
                  <% } %>
                </div>
              </div>

              <!-- Quick Bulk Action Buttons for this class -->
              <div class="d-flex flex-wrap gap-2 align-items-center">
                <% if(!item.isGraduating) { %>
                  <button type="button" class="btn btn-sm btn-outline-success" onclick="setClassDecisions(<%- item.sourceClass.id %>, 'auto')">
                    <i class="fa-solid fa-wand-magic-sparkles me-1"></i>Auto (Pass &rarr; Next, Fail &rarr; Repeat)
                  </button>
                  <button type="button" class="btn btn-sm btn-outline-primary" onclick="setClassDecisions(<%- item.sourceClass.id %>, 'promote')">
                    <i class="fa-solid fa-check-double me-1"></i>Promote All
                  </button>
                <% } %>
                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="autoSequenceRolls(<%- item.sourceClass.id %>)">
                  <i class="fa-solid fa-arrow-down-1-9 me-1"></i>Auto Roll Nos (1, 2, 3...)
                </button>
                <% if(item.isTargetHigh) { %>
                  <button type="button" class="btn btn-sm btn-outline-info" onclick="setBulkOptional(<%- item.sourceClass.id %>, 'Drawing')">
                    Set Drawing
                  </button>
                  <button type="button" class="btn btn-sm btn-outline-info" onclick="setBulkOptional(<%- item.sourceClass.id %>, 'Sanskrit')">
                    Set Sanskrit
                  </button>
                <% } else if(item.isTargetSenior) { %>
                  <button type="button" class="btn btn-sm btn-outline-success" onclick="setBulkOptional(<%- item.sourceClass.id %>, 'Mathematics')">
                    Set Math
                  </button>
                  <button type="button" class="btn btn-sm btn-outline-success" onclick="setBulkOptional(<%- item.sourceClass.id %>, 'Biology')">
                    Set Biology
                  </button>
                <% } %>
              </div>
            </div>

            <!-- Student Table -->
            <% if(item.students.length > 0) { %>
              <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 class-table" id="table-<%- item.sourceClass.id %>">
                  <thead class="table-light small">
                    <tr>
                      <th class="ps-3 text-center" style="width: 50px;">#</th>
                      <th class="text-center" style="width: 140px;">Roll No (Old &rarr; New)</th>
                      <th>Student Name</th>
                      <th>Father's Name</th>
                      <th>Exam Performance</th>
                      <th>Pending Fee</th>
                      <th style="min-width: 250px;">Transition Decision</th>
                      <% if(item.isTargetHigh || item.isTargetSenior) { %>
                        <th style="min-width: 190px;">UP Board Optional Subject</th>
                      <% } %>
                      <th class="text-center" style="width: 60px;">Record</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% item.students.forEach((s, sIdx) => { %>
                      <tr class="student-row <%- s.isPass ? 'row-passed' : 'row-failed bg-danger-subtle' %>">
                        <td class="ps-3 text-center text-muted fw-bold"><%- sIdx + 1 %></td>

                        <!-- Roll Number Old -> New -->
                        <td class="text-center">
                          <div class="d-flex align-items-center justify-content-center gap-1">
                            <span class="badge bg-secondary" title="Current Roll No"><%- s.roll_number || '-' %></span>
                            <i class="fa-solid fa-arrow-right text-muted small"></i>
                            <input type="number" name="new_roll_numbers[<%- s.id %>]" 
                                   class="form-control form-control-sm text-center fw-bold new-roll-input" 
                                   value="<%- s.suggestedRollNumber %>" 
                                   style="width: 60px;" min="1" max="999">
                          </div>
                        </td>

                        <!-- Name & Adm No -->
                        <td>
                          <div class="d-flex align-items-center gap-2">
                            <% if(s.profile_photo && s.profile_photo !== 'default.png') { %>
                              <img src="/uploads/students/<%- s.profile_photo %>" alt="<%- s.name %>" class="rounded-circle border" style="width: 32px; height: 32px; object-fit: cover;">
                            <% } else { %>
                              <div class="avatar-circle" style="width: 32px; height: 32px; font-size: 0.8rem;"><%- s.name.charAt(0) %></div>
                            <% } %>
                            <div>
                              <strong class="text-dark d-block"><%- s.name %></strong>
                              <small class="text-muted">Adm: <%- s.admission_no %></small>
                            </div>
                          </div>
                        </td>

                        <!-- Father's Name -->
                        <td>
                          <span class="text-secondary small fw-semibold"><%- s.father_name || s.guardian_name || '-' %></span>
                        </td>

                        <!-- Exam Performance (Pass/Fail) -->
                        <td>
                          <% if(s.hasExams) { %>
                            <% if(s.isPass) { %>
                              <span class="badge bg-success-subtle text-success border border-success">
                                <i class="fa-solid fa-check me-1"></i>Passed (<%- s.percentage %>%)
                              </span>
                            <% } else { %>
                              <span class="badge bg-danger text-white" title="Failed in one or more subjects (<33%)">
                                <i class="fa-solid fa-triangle-exclamation me-1"></i>Failed (<%- s.percentage %>%)
                              </span>
                            <% } %>
                            <div class="text-muted small" style="font-size: 0.70rem;">Total: <%- s.totalObtained %>/<%- s.totalMax %></div>
                          <% } else { %>
                            <span class="badge bg-secondary-subtle text-secondary border">
                              <i class="fa-solid fa-info-circle me-1"></i>Eligible (No Exam)
                            </span>
                          <% } %>
                        </td>

                        <!-- Pending Fee Due -->
                        <td>
                          <% if(s.pendingFee > 0) { %>
                            <span class="badge bg-danger-subtle text-danger border border-danger fw-bold">
                              ₹<%- s.pendingFee.toLocaleString('en-IN') %> Due
                            </span>
                            <div class="text-muted small" style="font-size: 0.68rem;">Will carry over</div>
                          <% } else { %>
                            <span class="badge bg-success-subtle text-success border border-success">
                              <i class="fa-solid fa-check me-1"></i>₹0 Cleared
                            </span>
                          <% } %>
                        </td>

                        <!-- Decision Dropdown -->
                        <td>
                          <select name="decision[<%- s.id %>]" class="form-select form-select-sm fw-bold decision-select" 
                                  data-student-id="<%- s.id %>" data-pass="<%- s.isPass ? '1' : '0' %>">
                            <% if(item.isGraduating) { %>
                              <option value="graduate" selected>🎓 Pass Out / Graduate as Alumni</option>
                              <option value="repeat">🔄 Retain / Repeat Class 12 (Board Failure / Parent Request)</option>
                              <option value="left">❌ Left School / TC Issued</option>
                            <% } else { %>
                              <option value="promote" <%- s.defaultDecision === 'promote' ? 'selected' : '' %>>
                                ⬆️ Promote to <%- item.targetGradeName %>
                              </option>
                              <option value="repeat" <%- s.defaultDecision === 'repeat' ? 'selected' : '' %> class="text-danger">
                                🔄 Retain / Repeat <%- item.sourceClass.name %> (Failed / Parent Request)
                              </option>
                              <option value="left">❌ Left School / TC Issued</option>
                            <% } %>
                          </select>
                        </td>

                        <!-- UP Board Optional Subject -->
                        <% if(item.isTargetHigh || item.isTargetSenior) { %>
                          <td>
                            <% if(item.isTargetHigh) { %>
                              <select name="optional_subjects[<%- s.id %>]" class="form-select form-select-sm optional-select">
                                <option value="Drawing" <%- (s.defaultOptSubject === 'Drawing') ? 'selected' : '' %>>चित्रकला (Drawing)</option>
                                <option value="Sanskrit" <%- (s.defaultOptSubject === 'Sanskrit') ? 'selected' : '' %>>संस्कृत (Sanskrit)</option>
                              </select>
                            <% } else if(item.isTargetSenior) { %>
                              <select name="optional_subjects[<%- s.id %>]" class="form-select form-select-sm optional-select">
                                <option value="Mathematics" <%- (s.defaultOptSubject === 'Mathematics') ? 'selected' : '' %>>गणित (Mathematics)</option>
                                <option value="Biology" <%- (s.defaultOptSubject === 'Biology') ? 'selected' : '' %>>जीव विज्ञान (Biology)</option>
                              </select>
                            <% } %>
                          </td>
                        <% } %>

                        <!-- Historical Record Link -->
                        <td class="text-center">
                          <a href="/admin/students/history/<%- s.id %>" target="_blank" class="btn btn-sm btn-outline-info" title="View Full Academic History">
                            <i class="fa-solid fa-clock-rotate-left"></i>
                          </a>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } else { %>
              <div class="py-5 text-center text-muted">
                <i class="fa-solid fa-user-slash fa-2x mb-2 d-block opacity-25"></i>
                No students currently enrolled in <%- item.sourceClass.name %> - Section <%- item.sourceClass.section || 'A' %>.
              </div>
            <% } %>

          </div>
        <% }) %>
      </div>
    </div>
  </div>

  <!-- Global Remarks & Execute Footer -->
  <div class="card shadow-sm border-0 mb-4 bg-light">
    <div class="card-body p-4">
      <div class="row g-3 align-items-center">
        <div class="col-lg-7">
          <label class="form-label fw-bold small text-dark mb-1">Administrative Transition Remarks (Optional):</label>
          <input type="text" name="transition_remarks" class="form-control" 
                 placeholder="e.g. Annual School Promotion: Session <%- currentAcademicYear %> completed &bull; Migrated to <%- newAcademicYear %>">
          <small class="text-muted">This note will be recorded permanently in each student's academic history ledger.</small>
        </div>

        <div class="col-lg-5 text-lg-end">
          <button type="button" class="btn btn-success btn-lg fw-bold px-4 shadow" onclick="openConfirmationModal()">
            <i class="fa-solid fa-graduation-cap me-2"></i>Execute School-Wide Transition
          </button>
        </div>
      </div>
    </div>
  </div>
</form>

<!-- ==================== CONFIRMATION MODAL ==================== -->
<div class="modal fade" id="confirmSchoolTransitionModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-success text-white py-3">
        <h6 class="modal-title fw-bold">
          <i class="fa-solid fa-shield-check me-2"></i>Confirm School-Wide Academic Year Transition
        </h6>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body p-4">
        <div class="text-center mb-3">
          <div class="rounded-circle bg-success-subtle text-success d-inline-flex align-items-center justify-content-center mb-2" style="width: 60px; height: 60px;">
            <i class="fa-solid fa-graduation-cap fa-2x"></i>
          </div>
          <h5 class="fw-bold text-dark mb-1">Advance Whole School to New Session</h5>
          <p class="text-muted small">All classes advance simultaneously, Class 1 becomes empty for fresh admissions, and Class 12 graduates are archived.</p>
        </div>

        <div class="list-group list-group-flush border rounded mb-3 small">
          <div class="list-group-item d-flex justify-content-between">
            <span class="text-muted">Completed Session:</span>
            <strong><%- currentAcademicYear %></strong>
          </div>
          <div class="list-group-item d-flex justify-content-between">
            <span class="text-muted">New Academic Session:</span>
            <strong id="modalTargetSession" class="text-primary fs-6"><%- newAcademicYear %></strong>
          </div>
          <div class="list-group-item d-flex justify-content-between">
            <span class="text-muted">Students Advancing to Next Class:</span>
            <strong id="modalPromoteCount" class="text-success badge bg-success fs-6">0</strong>
          </div>
          <div class="list-group-item d-flex justify-content-between">
            <span class="text-muted">Students Repeating / Retained in Same Class:</span>
            <strong id="modalRepeatCount" class="text-danger badge bg-danger fs-6">0</strong>
          </div>
          <div class="list-group-item d-flex justify-content-between">
            <span class="text-muted">Class 12 Graduating Alumni:</span>
            <strong id="modalGraduateCount" class="badge bg-warning text-dark fs-6">0</strong>
          </div>
          <div class="list-group-item d-flex justify-content-between bg-light">
            <span class="text-muted">Class 1 Status in New Session:</span>
            <span class="text-success fw-bold"><i class="fa-solid fa-circle-check me-1"></i>Completely Empty (Ready for Fresh Admissions)</span>
          </div>
          <div class="list-group-item d-flex justify-content-between bg-light">
            <span class="text-muted">Historical Snapshot Archive:</span>
            <span class="text-success fw-semibold"><i class="fa-solid fa-clock-rotate-left me-1"></i>All past marks, percentages, &amp; receipts permanently preserved</span>
          </div>
        </div>

        <div class="alert alert-warning py-2 small mb-0">
          <i class="fa-solid fa-triangle-exclamation me-1"></i>
          This action will advance all student enrollments and update the system's active academic session.
        </div>
      </div>

      <div class="modal-footer bg-light py-2">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel &amp; Review</button>
        <button type="button" class="btn btn-success fw-bold px-4" onclick="document.getElementById('schoolTransitionForm').submit()">
          <i class="fa-solid fa-check me-1"></i>Execute Transition Now
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  function setClassDecisions(classId, mode) {
    const table = document.getElementById('table-' + classId);
    if (!table) return;
    const selects = table.querySelectorAll('.decision-select');
    selects.forEach(sel => {
      const isPass = (sel.getAttribute('data-pass') === '1');
      if (mode === 'auto') {
        sel.value = isPass ? 'promote' : 'repeat';
      } else if (mode === 'promote') {
        sel.value = 'promote';
      } else if (mode === 'repeat') {
        sel.value = 'repeat';
      }
    });
  }

  function autoSequenceRolls(classId) {
    const table = document.getElementById('table-' + classId);
    if (!table) return;
    const inputs = table.querySelectorAll('.new-roll-input');
    let roll = 1;
    inputs.forEach(inp => {
      inp.value = roll++;
    });
  }

  function setBulkOptional(classId, optVal) {
    const table = document.getElementById('table-' + classId);
    if (!table) return;
    const selects = table.querySelectorAll('.optional-select');
    selects.forEach(sel => {
      sel.value = optVal;
    });
  }

  function openConfirmationModal() {
    const targetSession = document.getElementById('newAcademicYearInput').value;
    document.getElementById('modalTargetSession').textContent = targetSession;

    let promoteCount = 0;
    let repeatCount = 0;
    let graduateCount = 0;

    const allDecisions = document.querySelectorAll('.decision-select');
    allDecisions.forEach(sel => {
      if (sel.value === 'promote') promoteCount++;
      else if (sel.value === 'repeat') repeatCount++;
      else if (sel.value === 'graduate') graduateCount++;
    });

    document.getElementById('modalPromoteCount').textContent = promoteCount;
    document.getElementById('modalRepeatCount').textContent = repeatCount;
    document.getElementById('modalGraduateCount').textContent = graduateCount;

    const modal = new bootstrap.Modal(document.getElementById('confirmSchoolTransitionModal'));
    modal.show();
  }
</script>
