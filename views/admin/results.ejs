<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <div>
    <h5 class="fw-bold mb-1"><i class="fa-solid fa-file-pen text-primary me-2"></i>Examinations & Results Management</h5>
    <span class="text-muted small">Standard 3-Term Academic Structure &bull; Session 2026-27</span>
  </div>
  <div class="d-flex gap-2">
    <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#standardExamsModal">
      <i class="fa-solid fa-wand-magic-sparkles me-1"></i>Setup Standard Exams (1st, 2nd, 3rd & Pre-Board)
    </button>
    <a href="/admin/results/class-marks" class="btn btn-outline-primary">
      <i class="fa-solid fa-table-list me-1"></i>Class Marks Broadsheet
    </a>
  </div>
</div>

<div class="row g-4">
  <!-- Add Exam -->
  <div class="col-md-4">
    <div class="card shadow-sm border-0">
      <div class="card-header bg-primary text-white"><h6 class="mb-0 fw-bold"><i class="fa-solid fa-plus-circle me-1"></i>Create Exam</h6></div>
      <div class="card-body">
        <form action="/admin/exams/add" method="POST">
          <div class="mb-3">
            <label class="form-label fw-semibold">Quick Exam Template</label>
            <select class="form-select form-select-sm" id="examTemplateSelect" onchange="document.getElementById('examNameInput').value = this.value">
              <option value="">-- Choose Template or Type Below --</option>
              <option value="1st Term Examination">1st Term Examination</option>
              <option value="2nd Term Examination">2nd Term Examination</option>
              <option value="3rd Term / Annual Examination">3rd Term / Annual Examination</option>
              <option value="Pre-Board Examination">Pre-Board Examination (Class 10 & 12)</option>
              <option value="Unit Test 1">Unit Test 1</option>
              <option value="Unit Test 2">Unit Test 2</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Exam Name *</label>
            <input type="text" name="name" id="examNameInput" class="form-control" placeholder="e.g. 1st Term Examination" required>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Class *</label>
            <select name="class_id" class="form-select" required>
              <option value="">Select Class</option>
              <% classes.forEach(c => { %><option value="<%- c.id %>"><%- c.name %> - <%- c.section %></option><% }) %>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Exam Date</label>
            <input type="date" name="exam_date" class="form-control">
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Academic Year</label>
            <input type="text" name="academic_year" class="form-control" value="2026-27">
          </div>
          <button type="submit" class="btn btn-primary w-100 fw-semibold"><i class="fa-solid fa-check me-1"></i>Create Exam</button>
        </form>
      </div>
    </div>
  </div>

  <!-- Exams List -->
  <div class="col-md-8">
    <div class="card shadow-sm border-0">
      <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-bold"><i class="fa-solid fa-list-check text-primary me-2"></i>All Scheduled Exams (<%- exams.length %>)</h6>
        <span class="badge bg-light text-dark border">Passing Mark: Min 33%</span>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
              <tr>
                <th>Exam Name</th>
                <th>Class</th>
                <th>Date</th>
                <th>Session</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if(exams.length > 0) { %>
                <% exams.forEach(e => { 
                     const isAnnual = /annual|3rd|third|final/i.test(e.name);
                     const isPreBoard = /pre.*board/i.test(e.name);
                     const isTerm1 = /1st|first/i.test(e.name);
                     const isTerm2 = /2nd|second/i.test(e.name);
                %>
                <tr>
                  <td>
                    <strong><%- e.name %></strong>
                    <% if(isAnnual) { %>
                      <span class="badge bg-warning text-dark ms-1">Annual Final</span>
                    <% } else if(isPreBoard) { %>
                      <span class="badge bg-info text-dark ms-1">Pre-Board</span>
                    <% } else if(isTerm1) { %>
                      <span class="badge bg-primary ms-1">Term 1</span>
                    <% } else if(isTerm2) { %>
                      <span class="badge bg-secondary ms-1">Term 2</span>
                    <% } %>
                  </td>
                  <td><span class="badge bg-light text-dark border"><%- e.class_name %></span></td>
                  <td><%- e.exam_date ? new Date(e.exam_date).toLocaleDateString('en-IN') : '-' %></td>
                  <td><%- e.academic_year || '2026-27' %></td>
                  <td class="text-end">
                    <a href="/admin/results/enter/<%- e.id %>" class="btn btn-sm btn-primary">
                      <i class="fa-solid fa-pen me-1"></i>Enter Marks
                    </a>
                    <a href="/admin/results/class-marks?class_id=<%- e.class_id %>&exam_id=<%- e.id %>" class="btn btn-sm btn-outline-secondary" title="View Broadsheet & Positions">
                      <i class="fa-solid fa-table-list"></i>
                    </a>
                  </td>
                </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="5" class="text-center py-5 text-muted">
                    <i class="fa-solid fa-clipboard-question fa-2x mb-2 d-block"></i>
                    No exams configured yet. Click <strong>"Setup Standard Exams"</strong> to configure 1st Term, 2nd Term, 3rd Term/Annual and Pre-Board in one click!
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal: Setup Standard Exams -->
<div class="modal fade" id="standardExamsModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form action="/admin/exams/setup-standard" method="POST">
        <div class="modal-header bg-success text-white">
          <h5 class="modal-title fw-bold"><i class="fa-solid fa-wand-magic-sparkles me-2"></i>Setup Standard School Exams</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <p class="text-muted small">
            This tool automatically sets up standard examinations according to the school academic curriculum:
          </p>
          <ul class="small mb-3">
            <li><strong>1st Term Examination</strong> (All Classes)</li>
            <li><strong>2nd Term Examination</strong> (All Classes)</li>
            <li><strong>3rd Term / Annual Examination</strong> (All Classes - Consolidated Report Card)</li>
            <li><strong>Pre-Board Examination</strong> (Specifically for Class 10th & Class 12th)</li>
          </ul>

          <div class="mb-3">
            <label class="form-label fw-semibold">Target Class</label>
            <select name="class_id" class="form-select">
              <option value="all">All Classes (Entire School)</option>
              <% classes.forEach(c => { %>
                <option value="<%- c.id %>"><%- c.name %> - <%- c.section %></option>
              <% }) %>
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Academic Year</label>
            <input type="text" name="academic_year" class="form-control" value="2026-27" required>
          </div>

          <div class="alert alert-info py-2 small mb-0">
            <i class="fa-solid fa-circle-info me-1"></i>Existing exams with identical names will not be duplicated.
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-success fw-bold"><i class="fa-solid fa-bolt me-1"></i>Generate Standard Exams</button>
        </div>
      </form>
    </div>
  </div>
</div>
