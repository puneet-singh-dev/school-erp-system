<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h5 class="fw-bold mb-1"><i class="fa-solid fa-images text-primary me-2"></i>School Photo Gallery</h5>
    <small class="text-muted">Upload and manage school campus, sports, events, and festival photographs</small>
  </div>
  <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#uploadPhotoModal">
    <i class="fa-solid fa-cloud-arrow-up me-1"></i>Upload Photo
  </button>
</div>

<!-- Upload Photo Modal -->
<div class="modal fade" id="uploadPhotoModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h6 class="modal-title fw-bold"><i class="fa-solid fa-image me-2"></i>Upload Photo to Gallery</h6>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <form action="/admin/gallery/upload" method="POST" enctype="multipart/form-data">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label fw-semibold">Photo Title / Album Name</label>
            <input type="text" name="title" class="form-control" placeholder="e.g. Annual Sports Meet, Science Fair, Campus">
            <small class="text-muted">Optional. If left blank, photo file names will be used.</small>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Category / Event *</label>
            <input type="text" name="category" class="form-control" list="categoryOptions" placeholder="e.g. Annual Function, Sports, Campus, Republic Day" value="Campus &amp; Facilities" required>
            <datalist id="categoryOptions">
              <option value="Campus &amp; Facilities">
              <option value="Annual Sports Meet">
              <option value="Annual Function">
              <option value="Cultural &amp; Festivals">
              <option value="Classroom &amp; Labs">
              <option value="Examinations">
            </datalist>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold d-flex justify-content-between align-items-center">
              <span>Select Photos *</span>
              <span class="badge bg-primary">Multiple Allowed</span>
            </label>
            <input type="file" name="images" class="form-control" accept="image/*" multiple required>
            <small class="text-muted">Hold <kbd>Ctrl</kbd> or <kbd>Shift</kbd> to select multiple photos at once. (JPG, PNG, WEBP)</small>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Description / Caption (Optional)</label>
            <textarea name="description" rows="2" class="form-control" placeholder="Brief note about the picture..."></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary"><i class="fa-solid fa-cloud-arrow-up me-1"></i>Upload Photo(s)</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Category Filters -->
<div class="mb-4 d-flex flex-wrap gap-2">
  <a href="/admin/gallery" class="btn btn-sm <%- !selectedCategory ? 'btn-primary' : 'btn-outline-primary' %>">
    All Photos
  </a>
  <% if(categories && categories.length > 0) { %>
    <% categories.forEach(cat => { %>
      <a href="/admin/gallery?category=<%- encodeURIComponent(cat) %>" class="btn btn-sm <%- selectedCategory === cat ? 'btn-primary' : 'btn-outline-primary' %>">
        <%- cat %>
      </a>
    <% }) %>
  <% } %>
</div>

<!-- Gallery Grid -->
<div class="row g-4">
  <% if(images && images.length > 0) { %>
    <% images.forEach(img => { %>
      <div class="col-sm-6 col-md-4 col-lg-3">
        <div class="card h-100 shadow-sm border-0 overflow-hidden">
          <div class="position-relative" style="height: 190px; overflow: hidden; background: #f1f5f9;">
            <img src="/uploads/gallery/<%- img.image_path %>" onerror="this.onerror=null; this.src='/img/logo.png';" 
                 alt="<%- img.title %>" 
                 class="w-100 h-100" 
                 style="object-fit: cover;">
            <span class="badge bg-dark bg-opacity-75 position-absolute top-0 end-0 m-2">
              <%- img.category || 'General' %>
            </span>
          </div>
          <div class="card-body p-3 d-flex flex-column">
            <h6 class="fw-bold text-dark mb-1 text-truncate" title="<%- img.title %>"><%- img.title %></h6>
            <% if(img.description) { %>
              <p class="text-muted small mb-2 text-truncate" title="<%- img.description %>"><%- img.description %></p>
            <% } %>
            <div class="mt-auto d-flex justify-content-between align-items-center pt-2 border-top">
              <small class="text-muted"><%- new Date(img.created_at).toLocaleDateString('en-IN') %></small>
              <div class="btn-group btn-group-sm">
                <a href="/uploads/gallery/<%- img.image_path %>" target="_blank" class="btn btn-outline-secondary" title="View Full Image">
                  <i class="fa-solid fa-up-right-from-square"></i>
                </a>
                <form action="/admin/gallery/delete/<%- img.id %>" method="POST" onsubmit="return confirm('Delete this image permanently?');">
                  <button type="submit" class="btn btn-outline-danger" title="Delete Photo">
                    <i class="fa-solid fa-trash"></i>
                  </button>
                </form>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% }) %>
  <% } else { %>
    <div class="col-12 text-center py-5">
      <div class="card shadow-sm border-0 py-5">
        <div class="card-body">
          <i class="fa-solid fa-images text-muted fs-1 mb-3 opacity-50"></i>
          <h5 class="fw-bold text-muted">No gallery photos uploaded yet</h5>
          <p class="text-muted small">Click "Upload Photo" above to add your first photo.</p>
        </div>
      </div>
    </div>
  <% } %>
</div>
