<% if (typeof demoCount !== 'undefined' && demoCount > 0) { %>
<!-- Demo Mode Banner -->
<div class="card border-warning bg-warning bg-opacity-10 shadow-sm mb-4">
  <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3 py-3">
    <div class="d-flex align-items-center">
      <div class="rounded-circle bg-warning text-dark p-2 me-3 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
        <i class="fa-solid fa-flask-vial fs-5"></i>
      </div>
      <div>
        <h6 class="fw-bold mb-1 text-dark">
          Demo Testing Mode Active 
          <span class="badge bg-warning text-dark ms-2"><%- demoCount %> Demo Records</span>
        </h6>
        <p class="text-secondary small mb-0">
          Demo students (with transport/van fees and varied fee payment statuses) and demo teachers are active for testing. You can delete all demo data at any time.
        </p>
      </div>
    </div>
    <div class="d-flex align-items-center gap-2">
      <a href="/admin/backup/download" class="btn btn-outline-dark btn-sm shadow-sm px-3 py-2 fw-semibold" title="Download complete database backup">
        <i class="fa-solid fa-cloud-arrow-down me-1"></i>Database Backup
      </a>
      <form action="/admin/demo/clear" method="POST" onsubmit="return confirm('Are you sure you want to delete and exit all demo students and teachers? All real data will be preserved intact.');" class="m-0">
        <button type="submit" class="btn btn-danger btn-sm shadow-sm px-3 py-2 fw-semibold">
          <i class="fa-solid fa-trash-can me-1"></i>Delete / Exit Demo
        </button>
      </form>
    </div>
  </div>
</div>
<% } else { %>
<!-- Quick Generator & Backup bar -->
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
  <div class="d-flex gap-2">
    <a href="/admin/settings" class="btn btn-outline-primary btn-sm shadow-sm fw-semibold">
      <i class="fa-solid fa-gear me-1"></i>School Settings
    </a>
    <a href="/admin/backup/download" class="btn btn-outline-success btn-sm shadow-sm fw-semibold">
      <i class="fa-solid fa-database me-1"></i>Database Backup (.sql)
    </a>
  </div>
  <form action="/admin/demo/generate" method="POST" class="m-0">
    <button type="submit" class="btn btn-outline-primary btn-sm shadow-sm">
      <i class="fa-solid fa-flask-vial me-1"></i>Load Demo Data (10-15 students/class & teachers)
    </button>
  </form>
</div>
<% } %>

<!-- Stats Cards -->
<div class="row g-4 mb-4">
  <div class="col-xl-3 col-md-6">
    <div class="stat-card bg-primary text-white">
      <div class="stat-icon"><i class="fa-solid fa-user-graduate"></i></div>
      <div><div class="stat-num"><%- totalStudents %></div><div class="stat-label">Total Students</div></div>
    </div>
  </div>
  <div class="col-xl-3 col-md-6">
    <div class="stat-card bg-success text-white">
      <div class="stat-icon"><i class="fa-solid fa-chalkboard-user"></i></div>
      <div><div class="stat-num"><%- totalTeachers %></div><div class="stat-label">Total Teachers</div></div>
    </div>
  </div>
  <div class="col-xl-3 col-md-6">
    <div class="stat-card bg-warning text-dark">
      <div class="stat-icon"><i class="fa-solid fa-door-open"></i></div>
      <div><div class="stat-num"><%- totalClasses %></div><div class="stat-label">Total Classes</div></div>
    </div>
  </div>
  <div class="col-xl-3 col-md-6">
    <div class="stat-card bg-info text-white">
      <div class="stat-icon"><i class="fa-solid fa-indian-rupee-sign"></i></div>
      <div>
        <div class="stat-num">₹<%- parseFloat(feesCollected || 0).toLocaleString('en-IN', { maximumFractionDigits: 0 }) %></div>
        <div class="stat-label">
          Fees This Month
          <% if(typeof totalAllFees !== 'undefined' && totalAllFees > 0) { %>
            <div class="small opacity-75 mt-1"><i class="fa-solid fa-vault me-1"></i>Total: ₹<%- parseFloat(totalAllFees).toLocaleString('en-IN', { maximumFractionDigits: 0 }) %></div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Charts Row -->
<div class="row g-4 mb-4">
  <div class="col-lg-8">
    <div class="card shadow-sm h-100">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-bold"><i class="fa-solid fa-chart-line me-2 text-primary"></i>Fee Collection (Last 6 Months)</h6>
        <div class="d-flex gap-2">
          <a href="/admin/fees/history" class="btn btn-sm btn-outline-primary"><i class="fa-solid fa-clock-rotate-left me-1"></i>Fee History</a>
          <a href="/admin/fees/collect" class="btn btn-sm btn-primary"><i class="fa-solid fa-plus me-1"></i>Collect Fee</a>
        </div>
      </div>
      <div class="card-body">
        <canvas id="feeChart" height="110"></canvas>
      </div>
    </div>
  </div>
  <div class="col-lg-4">
    <div class="card shadow-sm h-100">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-bold"><i class="fa-solid fa-chart-pie me-2 text-success"></i>Attendance This Month</h6>
        <a href="/admin/attendance" class="btn btn-sm btn-outline-success"><i class="fa-solid fa-clipboard-check me-1"></i>Mark</a>
      </div>
      <div class="card-body d-flex flex-column align-items-center justify-content-center p-3">
        <div id="attEmptyState" class="text-center py-4 d-none">
          <div class="text-muted mb-3"><i class="fa-solid fa-clipboard-user fa-3x text-secondary opacity-50"></i></div>
          <h6 class="fw-semibold text-secondary mb-1">No Attendance Records</h6>
          <p class="text-muted small mb-3">No student attendance has been marked for this month yet.</p>
          <a href="/admin/attendance" class="btn btn-sm btn-success"><i class="fa-solid fa-check me-1"></i>Mark Attendance Now</a>
        </div>
        <div id="attCanvasWrapper" style="width: 100%; max-width: 260px; height: 210px; position: relative;">
          <canvas id="attChart"></canvas>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Recent Students & Notices -->
<div class="row g-4">
  <div class="col-lg-8">
    <div class="card shadow-sm">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-bold"><i class="fa-solid fa-user-plus me-2 text-primary"></i>Recent Admissions</h6>
        <a href="/admin/students" class="btn btn-sm btn-outline-primary">View All</a>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="table-light"><tr><th>Name</th><th>Adm. No</th><th>Class</th><th>Date</th></tr></thead>
            <tbody>
              <% recentStudents.forEach(s => { %>
              <tr>
                <td><i class="fa-solid fa-user-circle text-primary me-1"></i><%- s.name %></td>
                <td><span class="badge bg-secondary"><%- s.admission_no %></span></td>
                <td><%- s.class_name || 'N/A' %></td>
                <td><%- new Date(s.admission_date).toLocaleDateString('en-IN') %></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
  <div class="col-lg-4">
    <div class="card shadow-sm">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-bold"><i class="fa-solid fa-bullhorn me-2 text-warning"></i>Recent Notices</h6>
        <a href="/admin/notices" class="btn btn-sm btn-outline-primary">Manage</a>
      </div>
      <div class="card-body">
        <% if(notices.length > 0) { %>
          <% notices.forEach(n => { %>
          <div class="notice-item mb-3">
            <div class="fw-semibold text-dark"><%- n.title %></div>
            <small class="text-muted"><%- new Date(n.created_at).toLocaleDateString('en-IN') %></small>
            <span class="badge bg-light text-dark ms-1"><%- n.target_role %></span>
          </div>
          <% }) %>
        <% } else { %>
          <p class="text-muted text-center">No notices yet</p>
        <% } %>
      </div>
    </div>
  </div>
</div>

<script>
// Fee Chart
const feeData = <%- JSON.stringify(feeMonthly) %>;
new Chart(document.getElementById('feeChart'), {
  type: 'bar',
  data: {
    labels: feeData.map(d => d.month),
    datasets: [{
      label: 'Fees Collected (₹)',
      data: feeData.map(d => d.total),
      backgroundColor: 'rgba(59,130,246,0.7)',
      borderColor: '#2563eb',
      borderWidth: 1.5,
      borderRadius: 6
    }]
  },
  options: {
    responsive: true,
    maintainAspectRatio: true,
    plugins: {
      legend: { display: false },
      tooltip: {
        callbacks: {
          label: function(ctx) {
            return ' ₹ ' + Number(ctx.raw || 0).toLocaleString('en-IN');
          }
        }
      }
    },
    scales: {
      y: {
        beginAtZero: true,
        ticks: {
          callback: function(val) {
            return '₹' + Number(val).toLocaleString('en-IN');
          }
        }
      }
    }
  }
});

// Attendance Chart
const attData = <%- JSON.stringify(attendanceData) %>;
const attMap = {};
let totalAtt = 0;
attData.forEach(a => {
  attMap[a.status] = Number(a.count) || 0;
  totalAtt += Number(a.count) || 0;
});

const attCanvasWrapper = document.getElementById('attCanvasWrapper');
const attEmptyState = document.getElementById('attEmptyState');

if (totalAtt === 0) {
  attCanvasWrapper.classList.add('d-none');
  attEmptyState.classList.remove('d-none');
} else {
  new Chart(document.getElementById('attChart'), {
    type: 'doughnut',
    data: {
      labels: ['Present', 'Absent', 'Late', 'Leave'],
      datasets: [{
        data: [attMap['Present']||0, attMap['Absent']||0, attMap['Late']||0, attMap['Leave']||0],
        backgroundColor: ['#22c55e','#ef4444','#f59e0b','#6366f1'],
        borderWidth: 2,
        borderColor: '#ffffff'
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { position: 'bottom' }
      }
    }
  });
}
</script>
