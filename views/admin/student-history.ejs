<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2 d-print-none">
  <div>
    <h5 class="fw-bold mb-1">
      <i class="fa-solid fa-clock-rotate-left text-primary me-2"></i>Student Academic &amp; Fee History
    </h5>
    <small class="text-muted">Permanent historical archive of classes attended, past exam marks, report cards, and fee receipts.</small>
  </div>
  <div class="d-flex gap-2">
    <button onclick="window.print()" class="btn btn-outline-secondary">
      <i class="fa-solid fa-print me-1"></i>Print Academic Record
    </button>
    <a href="/admin/fees/collect?student_id=<%- student.id %>" class="btn btn-outline-success">
      <i class="fa-solid fa-hand-holding-dollar me-1"></i>Collect Fee
    </a>
    <a href="/admin/students/edit/<%- student.id %>" class="btn btn-outline-primary">
      <i class="fa-solid fa-pen me-1"></i>Edit Profile
    </a>
    <a href="/admin/students" class="btn btn-secondary">
      <i class="fa-solid fa-arrow-left me-1"></i>Back to Students
    </a>
  </div>
</div>

<!-- ==================== STUDENT PROFILE SUMMARY CARD ==================== -->
<div class="card shadow-sm border-0 mb-4 overflow-hidden">
  <div class="bg-primary text-white p-4">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
      <div class="d-flex align-items-center gap-3">
        <% if(student.profile_photo && student.profile_photo !== 'default.png') { %>
          <img src="/uploads/students/<%- student.profile_photo %>" alt="<%- student.student_name %>" 
               class="rounded-circle border border-3 border-white shadow" 
               style="width: 80px; height: 80px; object-fit: cover;">
        <% } else { %>
          <div class="avatar-circle border border-3 border-white shadow" style="width: 80px; height: 80px; font-size: 2rem;">
            <%- student.student_name.charAt(0) %>
          </div>
        <% } %>
        <div>
          <h4 class="fw-bold mb-1"><%- student.student_name %></h4>
          <div class="d-flex flex-wrap gap-2 align-items-center small opacity-90">
            <span><strong>Adm No:</strong> <%- student.admission_no %></span>
            <span>&bull;</span>
            <span><strong>Current Class:</strong> <%- student.current_class_name ? student.current_class_name + ' - ' + student.current_section : 'Unassigned' %></span>
            <span>&bull;</span>
            <span><strong>Roll No:</strong> <%- student.roll_number || '-' %></span>
            <% if(student.optional_subject) { %>
              <span>&bull;</span>
              <span class="badge bg-warning text-dark fw-bold">UP Board: <%- student.optional_subject %></span>
            <% } %>
          </div>
        </div>
      </div>
      <div class="text-end d-print-none">
        <span class="badge bg-white text-primary fs-6 px-3 py-2 fw-bold shadow-sm">
          Active Student &bull; <%- student.current_academic_year || '2026-27' %>
        </span>
      </div>
    </div>
  </div>

  <!-- Key Metrics Strip -->
  <div class="card-body bg-light border-bottom py-3">
    <div class="row g-3 text-center">
      <div class="col-md-3 col-6 border-end">
        <small class="text-muted text-uppercase fw-semibold" style="font-size:0.75rem;">Lifetime Fee Paid</small>
        <h5 class="fw-bold text-success mb-0 mt-1">₹<%- lifetimeFeePaid.toLocaleString('en-IN') %></h5>
      </div>
      <div class="col-md-3 col-6 border-end">
        <small class="text-muted text-uppercase fw-semibold" style="font-size:0.75rem;">Current Pending Dues</small>
        <h5 class="fw-bold <%- feeData.balance > 0 ? 'text-danger' : 'text-success' %> mb-0 mt-1">
          ₹<%- parseFloat(feeData.balance || 0).toLocaleString('en-IN') %>
        </h5>
      </div>
      <div class="col-md-3 col-6 border-end">
        <small class="text-muted text-uppercase fw-semibold" style="font-size:0.75rem;">Classes Attended</small>
        <h5 class="fw-bold text-dark mb-0 mt-1"><%- historyRows.length + (student.current_class_name ? 1 : 0) %> Sessions</h5>
      </div>
      <div class="col-md-3 col-6">
        <small class="text-muted text-uppercase fw-semibold" style="font-size:0.75rem;">Total Exams Recorded</small>
        <h5 class="fw-bold text-primary mb-0 mt-1"><%- examsList.length %> Exams</h5>
      </div>
    </div>
  </div>

  <!-- Profile Details Summary Grid -->
  <div class="card-body p-4">
    <div class="row g-3 small">
      <div class="col-md-3 col-sm-6">
        <span class="text-muted d-block">Father's Name:</span>
        <strong class="text-dark"><%- student.father_name || '-' %></strong>
      </div>
      <div class="col-md-3 col-sm-6">
        <span class="text-muted d-block">Mother's Name:</span>
        <strong class="text-dark"><%- student.mother_name || '-' %></strong>
      </div>
      <div class="col-md-3 col-sm-6">
        <span class="text-muted d-block">Contact Phone:</span>
        <strong class="text-dark"><%- student.phone || student.guardian_phone || '-' %></strong>
      </div>
      <div class="col-md-3 col-sm-6">
        <span class="text-muted d-block">Date of Birth:</span>
        <strong class="text-dark"><%- student.date_of_birth ? new Date(student.date_of_birth).toLocaleDateString('en-IN') : '-' %></strong>
      </div>
      <div class="col-md-3 col-sm-6">
        <span class="text-muted d-block">Aadhaar Card:</span>
        <strong class="text-dark"><%- student.aadhaar_no || 'Not provided' %></strong>
      </div>
      <div class="col-md-3 col-sm-6">
        <span class="text-muted d-block">Blood Group:</span>
        <strong class="text-dark"><%- student.blood_group || '-' %></strong>
      </div>
      <div class="col-md-3 col-sm-6">
        <span class="text-muted d-block">School Transport:</span>
        <% if(student.uses_transport) { %>
          <span class="badge bg-info-subtle text-info-emphasis border border-info">
            <i class="fa-solid fa-van-shuttle me-1"></i><%- student.transport_route || 'Adopted' %> (₹<%- parseFloat(student.transport_fee || 0).toFixed(0) %>/mo)
          </span>
        <% } else { %>
          <span class="text-muted">Self / Walk</span>
        <% } %>
      </div>
      <div class="col-md-3 col-sm-6">
        <span class="text-muted d-block">Admission Date:</span>
        <strong class="text-dark"><%- student.admission_date ? new Date(student.admission_date).toLocaleDateString('en-IN') : '-' %></strong>
      </div>
    </div>
  </div>
</div>

<!-- ==================== TABS NAVIGATION ==================== -->
<ul class="nav nav-pills nav-fill mb-4 bg-white p-2 rounded shadow-sm border d-print-none" id="historyTab" role="tablist">
  <li class="nav-item" role="presentation">
    <button class="nav-link active fw-bold" id="results-tab" data-bs-toggle="tab" data-bs-target="#resultsPane" type="button" role="tab">
      <i class="fa-solid fa-file-pen me-2"></i>Exam Results &amp; Marksheets (<%- examsList.length %>)
    </button>
  </li>
  <li class="nav-item" role="presentation">
    <button class="nav-link fw-bold" id="fees-tab" data-bs-toggle="tab" data-bs-target="#feesPane" type="button" role="tab">
      <i class="fa-solid fa-receipt me-2"></i>Fee Payments &amp; Receipts (<%- payments.length %>)
    </button>
  </li>
  <li class="nav-item" role="presentation">
    <button class="nav-link fw-bold" id="timeline-tab" data-bs-toggle="tab" data-bs-target="#timelinePane" type="button" role="tab">
      <i class="fa-solid fa-graduation-cap me-2"></i>Academic Class Journey (<%- historyRows.length + 1 %>)
    </button>
  </li>
  <li class="nav-item" role="presentation">
    <button class="nav-link fw-bold" id="attendance-tab" data-bs-toggle="tab" data-bs-target="#attendancePane" type="button" role="tab">
      <i class="fa-solid fa-clipboard-check me-2"></i>Attendance Summary
    </button>
  </li>
</ul>

<!-- ==================== TAB CONTENT PANES ==================== -->
<div class="tab-content" id="historyTabContent">

  <!-- ==================== TAB 1: EXAM RESULTS & MARKSHEETS ==================== -->
  <div class="tab-pane fade show active" id="resultsPane" role="tabpanel">
    <% const classKeys = Object.keys(classExamsGrouped); %>
    <% if(classKeys.length > 0) { %>
      <% classKeys.forEach((classKey, cIdx) => { %>
        <% const classExams = classExamsGrouped[classKey]; %>
        <div class="card shadow-sm border-0 mb-4">
          <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
              <h6 class="mb-0 fw-bold">
                <i class="fa-solid fa-book-open-reader text-warning me-2"></i><%- classKey %>
              </h6>
              <small class="opacity-75">All term and annual examination results recorded for this class session</small>
            </div>
            <span class="badge bg-primary px-3 py-1"><%- classExams.length %> Exams</span>
          </div>

          <div class="card-body p-4">
            <div class="accordion" id="accordionClass_<%- cIdx %>">
              <% classExams.forEach((ex, eIdx) => { %>
                <% const collapseId = `collapse_${cIdx}_${eIdx}`; %>
                <div class="accordion-item border mb-3 rounded overflow-hidden shadow-xs">
                  <h2 class="accordion-header" id="heading_<%- collapseId %>">
                    <button class="accordion-button <%- eIdx > 0 ? 'collapsed' : '' %> bg-light py-3" type="button" 
                            data-bs-toggle="collapse" data-bs-target="#<%- collapseId %>" aria-expanded="<%- eIdx === 0 ? 'true' : 'false' %>">
                      <div class="d-flex justify-content-between align-items-center w-100 me-3 flex-wrap gap-2">
                        <div>
                          <strong class="text-dark fs-6"><%- ex.exam_name %></strong>
                          <small class="text-muted ms-2">
                            <i class="fa-regular fa-calendar me-1"></i><%- ex.exam_date ? new Date(ex.exam_date).toLocaleDateString('en-IN') : 'Date not set' %>
                          </small>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                          <% if(ex.rankInfo && ex.rankInfo.rank <= 3 && ex.rankInfo.isPassed) { %>
                            <% if(ex.rankInfo.rank === 1) { %>
                              <span class="badge bg-warning text-dark fw-bold px-2 py-1 shadow-sm">
                                🥇 1st Position
                              </span>
                            <% } else if(ex.rankInfo.rank === 2) { %>
                              <span class="badge bg-secondary text-white fw-bold px-2 py-1 shadow-sm">
                                🥈 2nd Position
                              </span>
                            <% } else if(ex.rankInfo.rank === 3) { %>
                              <span class="badge bg-danger text-white fw-bold px-2 py-1 shadow-sm" style="background-color: #cd7f32 !important;">
                                🥉 3rd Position
                              </span>
                            <% } %>
                          <% } %>

                          <% if(ex.isPass) { %>
                            <span class="badge bg-success-subtle text-success border border-success px-2 py-1">
                              <i class="fa-solid fa-circle-check me-1"></i>Passed (<%- ex.percentage %>%)
                            </span>
                          <% } else { %>
                            <span class="badge bg-danger-subtle text-danger border border-danger px-2 py-1">
                              <i class="fa-solid fa-triangle-exclamation me-1"></i>Failed (<%- ex.percentage %>%)
                            </span>
                          <% } %>
                        </div>
                      </div>
                    </button>
                  </h2>

                  <div id="<%- collapseId %>" class="accordion-collapse collapse <%- eIdx === 0 ? 'show' : '' %>" data-bs-parent="#accordionClass_<%- cIdx %>">
                    <div class="accordion-body p-0">
                      <!-- Subject Marks Table -->
                      <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                          <thead class="table-light small">
                            <tr>
                              <th class="ps-3" style="width: 40px;">#</th>
                              <th>Subject Name</th>
                              <th class="text-center" style="width: 120px;">Max Marks</th>
                              <th class="text-center" style="width: 140px;">Marks Obtained</th>
                              <th class="text-center" style="width: 100px;">Percentage</th>
                              <th class="text-center" style="width: 90px;">Grade</th>
                              <th class="text-center" style="width: 100px;">Result</th>
                            </tr>
                          </thead>
                          <tbody>
                            <% ex.results.forEach((r, rIdx) => { %>
                              <% 
                                const obt = parseFloat(r.marks_obtained) || 0;
                                const max = parseFloat(r.max_marks) || 100;
                                const subPct = max > 0 ? (obt / max) * 100 : 0;
                                const isSubPass = max > 0 && subPct >= 33;
                              %>
                              <tr>
                                <td class="ps-3 text-muted"><%- rIdx + 1 %></td>
                                <td>
                                  <span class="fw-bold text-dark"><%- r.subject_name %></span>
                                  <% if(r.subject_code) { %>
                                    <small class="text-muted ms-1">(<%- r.subject_code %>)</small>
                                  <% } %>
                                </td>
                                <td class="text-center fw-semibold text-secondary"><%- max %></td>
                                <td class="text-center">
                                  <span class="fw-bold fs-6 <%- isSubPass ? 'text-dark' : 'text-danger' %>"><%- obt %></span>
                                </td>
                                <td class="text-center small"><%- subPct.toFixed(1) %>%</td>
                                <td class="text-center">
                                  <span class="badge bg-light text-dark border"><%- r.grade || (subPct >= 75 ? 'A' : subPct >= 60 ? 'B' : subPct >= 33 ? 'C' : 'F') %></span>
                                </td>
                                <td class="text-center">
                                  <% if(isSubPass) { %>
                                    <span class="badge bg-success-subtle text-success">Pass</span>
                                  <% } else { %>
                                    <span class="badge bg-danger-subtle text-danger">Fail</span>
                                  <% } %>
                                </td>
                              </tr>
                            <% }) %>
                          </tbody>
                          <tfoot class="table-light fw-bold border-top">
                            <tr>
                              <td colspan="2" class="ps-3 text-uppercase">Total Aggregate</td>
                              <td class="text-center"><%- ex.totalMax %></td>
                              <td class="text-center text-primary fs-6"><%- ex.totalObtained %></td>
                              <td class="text-center text-primary"><%- ex.percentage %>%</td>
                              <td class="text-center">-</td>
                              <td class="text-center">
                                <% if(ex.isPass) { %>
                                  <span class="badge bg-success">Passed</span>
                                <% } else { %>
                                  <span class="badge bg-danger">Failed</span>
                                <% } %>
                              </td>
                            </tr>
                          </tfoot>
                        </table>
                      </div>

                      <!-- Report Card Download Bar -->
                      <div class="bg-light p-3 d-flex justify-content-between align-items-center flex-wrap gap-2 border-top">
                        <div class="small text-muted">
                          Exam Date: <strong><%- ex.exam_date ? new Date(ex.exam_date).toLocaleDateString('en-IN') : 'N/A' %></strong> &bull; Class: <strong><%- ex.class_name %> - <%- ex.class_section %></strong>
                        </div>
                        <div class="d-flex gap-2">
                          <a href="/admin/results/report-card/<%- student.id %>/<%- ex.exam_id %>" target="_blank" class="btn btn-sm btn-outline-danger">
                            <i class="fa-solid fa-file-pdf me-1"></i>Download Official Report Card PDF
                          </a>
                          <% if(/annual|3rd|third|final/i.test(ex.exam_name)) { %>
                            <a href="/admin/results/report-card/<%- student.id %>/<%- ex.exam_id %>?consolidated=1" target="_blank" class="btn btn-sm btn-primary">
                              <i class="fa-solid fa-certificate me-1"></i>Consolidated Annual Marksheet
                            </a>
                          <% } %>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="card shadow-sm border-0 py-5 text-center">
        <div class="card-body">
          <i class="fa-solid fa-file-lines fa-3x text-muted opacity-25 mb-3"></i>
          <h5 class="fw-bold text-dark">No Exam Results Recorded Yet</h5>
          <p class="text-muted small mx-auto" style="max-width: 450px;">
            Exam results and marks uploaded by teachers or administrative staff will appear here permanently grouped by class session.
          </p>
        </div>
      </div>
    <% } %>
  </div>

  <!-- ==================== TAB 2: FEE PAYMENTS & RECEIPTS ==================== -->
  <div class="tab-pane fade" id="feesPane" role="tabpanel">
    <!-- Fee Summary Bar -->
    <div class="row g-3 mb-4">
      <div class="col-md-4">
        <div class="card border-0 shadow-sm bg-success text-white p-3">
          <small class="opacity-75 text-uppercase fw-semibold" style="font-size:0.75rem;">Lifetime Fee Collected</small>
          <h4 class="fw-bold mb-0 mt-1">₹<%- lifetimeFeePaid.toLocaleString('en-IN') %></h4>
          <small class="opacity-75"><%- payments.length %> Payment receipts issued</small>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card border-0 shadow-sm bg-light border p-3">
          <small class="text-muted text-uppercase fw-semibold" style="font-size:0.75rem;">Current Session Dues</small>
          <h4 class="fw-bold <%- feeData.balance > 0 ? 'text-danger' : 'text-success' %> mb-0 mt-1">
            ₹<%- parseFloat(feeData.balance || 0).toLocaleString('en-IN') %>
          </h4>
          <small class="text-muted"><%- feeData.pending_months_text ? 'Months: ' + feeData.pending_months_text : 'All cleared' %></small>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card border-0 shadow-sm bg-light border p-3">
          <small class="text-muted text-uppercase fw-semibold" style="font-size:0.75rem;">Carried-Forward Balance</small>
          <h4 class="fw-bold text-dark mb-0 mt-1">
            ₹<%- parseFloat(student.previous_balance || 0).toLocaleString('en-IN') %>
          </h4>
          <small class="text-muted"><%- student.previous_balance_remarks || 'No previous dues carried' %></small>
        </div>
      </div>
    </div>

    <!-- Payment Records Table -->
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-bold">
          <i class="fa-solid fa-receipt me-2"></i>Complete Chronological Payment History (<%- payments.length %> Receipts)
        </h6>
        <a href="/admin/fees/collect?student_id=<%- student.id %>" class="btn btn-sm btn-success fw-semibold">
          <i class="fa-solid fa-plus me-1"></i>Collect New Fee
        </a>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="ps-3">Receipt No</th>
                <th>Payment Date</th>
                <th>Months Covered</th>
                <th class="text-end">Amount Paid</th>
                <th class="text-center">Mode</th>
                <th>Fee Breakdown / Remarks</th>
                <th>Collector</th>
                <th class="text-end pe-3">Action</th>
              </tr>
            </thead>
            <tbody>
              <% if(payments.length > 0) { %>
                <% payments.forEach(p => { %>
                  <tr>
                    <td class="ps-3">
                      <span class="fw-bold text-primary"><%- p.receipt_no || ('RCP-' + p.id) %></span>
                    </td>
                    <td>
                      <small class="text-dark fw-semibold">
                        <%- p.payment_date ? new Date(p.payment_date).toLocaleDateString('en-IN') : '-' %>
                      </small>
                    </td>
                    <td>
                      <% if(p.months_paid) { %>
                        <span class="badge bg-light text-dark border"><%- p.months_paid %></span>
                      <% } else { %>
                        <span class="text-muted small">Standard Fee</span>
                      <% } %>
                    </td>
                    <td class="text-end">
                      <strong class="text-success fs-6">₹<%- parseFloat(p.amount_paid).toLocaleString('en-IN') %></strong>
                    </td>
                    <td class="text-center">
                      <span class="badge bg-secondary-subtle text-secondary border"><%- p.payment_mode %></span>
                    </td>
                    <td>
                      <% if(p.breakdown_json) { %>
                        <% try { 
                             const bList = JSON.parse(p.breakdown_json);
                        %>
                          <div class="d-flex flex-wrap gap-1">
                            <% bList.slice(0, 3).forEach(b => { %>
                              <span class="badge bg-light text-secondary border small" style="font-size: 0.68rem;">
                                <%- b.name %>: ₹<%- b.amount %>
                              </span>
                            <% }) %>
                            <% if(bList.length > 3) { %>
                              <span class="text-muted small">+<%- bList.length - 3 %> more</span>
                            <% } %>
                          </div>
                        <% } catch(e) { %>
                          <span class="small text-muted"><%- p.remarks || '-' %></span>
                        <% } %>
                      <% } else { %>
                        <span class="small text-muted"><%- p.remarks || p.fee_type || '-' %></span>
                      <% } %>
                    </td>
                    <td>
                      <small class="text-muted"><%- p.collected_by_name || 'Admin' %></small>
                    </td>
                    <td class="text-end pe-3">
                      <a href="/admin/fees/receipt/<%- p.id %>" target="_blank" class="btn btn-sm btn-outline-primary" title="Print Fee Receipt PDF">
                        <i class="fa-solid fa-receipt me-1"></i>Print Receipt
                      </a>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="8" class="text-center py-5 text-muted">
                    <i class="fa-solid fa-receipt fa-2x mb-2 d-block opacity-25"></i>
                    No fee payments recorded for this student yet.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- ==================== TAB 3: ACADEMIC CLASS JOURNEY & PROMOTION TIMELINE ==================== -->
  <div class="tab-pane fade" id="timelinePane" role="tabpanel">
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-header bg-dark text-white py-3">
        <h6 class="mb-0 fw-bold">
          <i class="fa-solid fa-timeline me-2"></i>Academic Progression &amp; Promotion Journey
        </h6>
      </div>
      <div class="card-body p-4">
        <!-- Current Active Class Milestone -->
        <div class="d-flex gap-3 mb-4">
          <div class="d-flex flex-column align-items-center">
            <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center shadow" style="width: 44px; height: 44px;">
              <i class="fa-solid fa-user-graduate"></i>
            </div>
            <div class="bg-success-subtle flex-grow-1" style="width: 3px; min-height: 40px;"></div>
          </div>
          <div class="flex-grow-1">
            <div class="card border-success border-2 shadow-sm p-3">
              <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                <span class="badge bg-success fs-6 px-3 py-1">Current Active Enrollment</span>
                <span class="text-muted small">Session: <strong><%- student.current_academic_year || '2026-27' %></strong></span>
              </div>
              <h5 class="fw-bold text-dark mb-1">
                <%- student.current_class_name ? student.current_class_name + ' - Section ' + student.current_section : 'Class Not Assigned' %>
              </h5>
              <div class="row g-2 text-muted small mt-1">
                <div class="col-md-3">Roll Number: <strong class="text-dark"><%- student.roll_number || 'Unassigned' %></strong></div>
                <% if(student.optional_subject) { %>
                  <div class="col-md-4">UP Board Optional: <strong class="text-primary"><%- student.optional_subject %></strong></div>
                <% } %>
                <div class="col-md-5">Current Pending Due: <strong class="<%- feeData.balance > 0 ? 'text-danger' : 'text-success' %>">₹<%- parseFloat(feeData.balance || 0).toLocaleString('en-IN') %></strong></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Historical Promotion Milestones -->
        <% if(historyRows.length > 0) { %>
          <% historyRows.forEach((h, hIdx) => { %>
            <div class="d-flex gap-3 mb-4">
              <div class="d-flex flex-column align-items-center">
                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center shadow-xs" style="width: 44px; height: 44px;">
                  <i class="fa-solid fa-graduation-cap"></i>
                </div>
                <% if(hIdx < historyRows.length - 1) { %>
                  <div class="bg-secondary-subtle flex-grow-1" style="width: 3px; min-height: 40px;"></div>
                <% } %>
              </div>
              <div class="flex-grow-1">
                <div class="card border shadow-sm p-3 bg-light">
                  <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                    <span class="badge bg-primary px-2 py-1"><%- h.final_result_status || 'Promoted' %></span>
                    <span class="text-muted small">
                      Promoted on: <strong><%- h.promoted_at ? new Date(h.promoted_at).toLocaleDateString('en-IN') : '-' %></strong>
                      <% if(h.promoted_by_name) { %>by <%- h.promoted_by_name %><% } %>
                    </span>
                  </div>
                  <h5 class="fw-bold text-dark mb-1">
                    Completed: <%- h.class_name %> - Section <%- h.section %> (<%- h.academic_year %>)
                  </h5>
                  <div class="row g-2 text-muted small mt-2">
                    <div class="col-md-3">
                      Roll Number in Class: <strong class="text-dark"><%- h.roll_number || '-' %></strong>
                    </div>
                    <% if(h.optional_subject) { %>
                      <div class="col-md-3">
                        Optional Subject: <strong class="text-dark"><%- h.optional_subject %></strong>
                      </div>
                    <% } %>
                    <% if(h.final_percentage) { %>
                      <div class="col-md-3">
                        Final Score: <strong class="text-success"><%- h.final_percentage %>%</strong>
                        <% if(h.total_marks_obtained) { %>
                          (<%- h.total_marks_obtained %>/<%- h.total_max_marks %>)
                        <% } %>
                      </div>
                    <% } %>
                    <div class="col-md-3">
                      Fee Carried: <strong class="text-danger">₹<%- parseFloat(h.fee_balance_carried || 0).toLocaleString('en-IN') %></strong>
                    </div>
                  </div>
                  <% if(h.remarks) { %>
                    <div class="alert alert-light border py-1 px-2 mb-0 mt-2 small text-muted">
                      <i class="fa-solid fa-quote-left me-1 small"></i><%- h.remarks %>
                    </div>
                  <% } %>
                </div>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="alert alert-info py-2 small mb-0 ms-5">
            <i class="fa-solid fa-circle-info me-1"></i>
            This student has not yet undergone any class promotions. Promotion snapshots will automatically populate here whenever promoted.
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- ==================== TAB 4: ATTENDANCE RECORDS ==================== -->
  <div class="tab-pane fade" id="attendancePane" role="tabpanel">
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-header bg-dark text-white py-3">
        <h6 class="mb-0 fw-bold">
          <i class="fa-solid fa-calendar-check me-2"></i>Multi-Session Attendance Record
        </h6>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="ps-3">Class &amp; Section</th>
                <th>Year</th>
                <th class="text-center">Total Working Days</th>
                <th class="text-center text-success">Present</th>
                <th class="text-center text-danger">Absent</th>
                <th class="text-center text-warning">Late</th>
                <th class="text-center text-info">Leave</th>
                <th class="text-center">Attendance %</th>
              </tr>
            </thead>
            <tbody>
              <% if(attendanceSummary && attendanceSummary.length > 0) { %>
                <% attendanceSummary.forEach(att => { %>
                  <% 
                    const total = parseInt(att.total_days, 10) || 0;
                    const present = parseInt(att.present_days, 10) || 0;
                    const pct = total > 0 ? (present / total) * 100 : 0;
                  %>
                  <tr>
                    <td class="ps-3 fw-bold text-dark"><%- att.class_name %> - <%- att.class_section %></td>
                    <td><%- att.yr %></td>
                    <td class="text-center fw-semibold"><%- total %></td>
                    <td class="text-center text-success fw-bold"><%- present %></td>
                    <td class="text-center text-danger fw-bold"><%- att.absent_days %></td>
                    <td class="text-center text-warning fw-bold"><%- att.late_days %></td>
                    <td class="text-center text-info fw-bold"><%- att.leave_days %></td>
                    <td class="text-center">
                      <span class="badge <%- pct >= 75 ? 'bg-success' : pct >= 50 ? 'bg-warning text-dark' : 'bg-danger' %> px-2 py-1">
                        <%- pct.toFixed(1) %>%
                      </span>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="8" class="text-center py-5 text-muted">
                    <i class="fa-solid fa-calendar-xmark fa-2x mb-2 d-block opacity-25"></i>
                    No attendance records logged for this student yet.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

</div>
