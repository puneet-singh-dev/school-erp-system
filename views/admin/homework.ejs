<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h5 class="fw-bold mb-1"><i class="fa-solid fa-book-open text-primary me-2"></i>Homework &amp; Assignments Management</h5>
    <small class="text-muted">Post class-wise daily homework, tasks, and project assignments</small>
  </div>
  <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addHomeworkModal">
    <i class="fa-solid fa-plus me-1"></i>Assign Homework
  </button>
</div>

<!-- Modal: Assign Homework -->
<div class="modal fade" id="addHomeworkModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h6 class="modal-title fw-bold"><i class="fa-solid fa-file-circle-plus me-2"></i>Post New Homework</h6>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <form action="/admin/homework/add" method="POST">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label fw-semibold">Class *</label>
            <select name="class_id" class="form-select" required>
              <option value="">-- Select Class --</option>
              <% classes.forEach(c => { %>
                <option value="<%- c.id %>"><%- c.name %> - <%- c.section %></option>
              <% }) %>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Subject</label>
            <select name="subject_id" class="form-select">
              <option value="">-- General / Optional --</option>
              <% subjects.forEach(s => { %>
                <option value="<%- s.id %>"><%- s.name %></option>
              <% }) %>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Homework Title *</label>
            <input type="text" name="title" class="form-control" placeholder="e.g. Chapter 5 Exercises, Science Practical Report" required>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Instructions / Description *</label>
            <textarea name="description" rows="3" class="form-control" placeholder="Detailed homework questions or guidelines..." required></textarea>
          </div>
          <div class="row g-2">
            <div class="col-6">
              <label class="form-label fw-semibold">Assigned Date</label>
              <input type="date" name="assigned_date" class="form-control" value="<%- new Date().toISOString().split('T')[0] %>">
            </div>
            <div class="col-6">
              <label class="form-label fw-semibold">Due Date *</label>
              <input type="date" name="due_date" class="form-control" required min="<%- new Date().toISOString().split('T')[0] %>">
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary"><i class="fa-solid fa-check me-1"></i>Publish Homework</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Class Filter -->
<div class="card shadow-sm border-0 mb-4">
  <div class="card-body py-3">
    <form method="GET" class="row g-2 align-items-center">
      <div class="col-auto">
        <label class="fw-semibold small">Filter by Class:</label>
      </div>
      <div class="col-md-4">
        <select name="class_id" class="form-select form-select-sm" onchange="this.form.submit()">
          <option value="">All Classes</option>
          <% classes.forEach(c => { %>
            <option value="<%- c.id %>" <%- classId == c.id ? 'selected' : '' %>><%- c.name %> - <%- c.section %></option>
          <% }) %>
        </select>
      </div>
      <% if(classId) { %>
        <div class="col-auto">
          <a href="/admin/homework" class="btn btn-sm btn-outline-secondary">Clear Filter</a>
        </div>
      <% } %>
    </form>
  </div>
</div>

<!-- Homework List Table -->
<div class="card shadow-sm border-0">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Class</th>
            <th>Subject &amp; Title</th>
            <th>Instructions</th>
            <th>Assigned Date</th>
            <th>Due Date</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if(homeworkList && homeworkList.length > 0) { %>
            <% homeworkList.forEach(hw => { %>
              <tr>
                <td><span class="badge bg-primary"><%- hw.class_name %> - <%- hw.section %></span></td>
                <td>
                  <div class="fw-bold text-dark"><%- hw.title %></div>
                  <small class="text-muted"><%- hw.subject_name || 'General' %></small>
                </td>
                <td class="small" style="max-width: 300px;"><%- hw.description %></td>
                <td><small class="text-muted"><%- new Date(hw.assigned_date).toLocaleDateString('en-IN') %></small></td>
                <td>
                  <strong class="text-danger small"><%- new Date(hw.due_date).toLocaleDateString('en-IN') %></strong>
                </td>
                <td class="text-end">
                  <form action="/admin/homework/delete/<%- hw.id %>" method="POST" onsubmit="return confirm('Delete this assignment?');" class="d-inline">
                    <button type="submit" class="btn btn-sm btn-outline-danger">
                      <i class="fa-solid fa-trash"></i>
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="6" class="text-center text-muted py-5">
                No homework assignments found.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
