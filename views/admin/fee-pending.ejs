<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h5 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-circle-exclamation text-danger me-2"></i>Pending Fees & Defaulters</h5>
    <small class="text-muted">Calculates unpaid tuition & van fees month-by-month against the ongoing academic calendar.</small>
  </div>
</div>

<div class="card shadow-sm mb-4 border-0">
  <div class="card-body bg-light rounded-3 p-3">
    <form method="GET" class="row g-3 align-items-end" id="pendingFilterForm">
      <div class="col-md-5">
        <label class="form-label fw-semibold small text-secondary mb-1">Select Class</label>
        <select name="class_id" class="form-select" onchange="this.form.submit()">
          <option value="">-- Select Class --</option>
          <% classes.forEach(c => { %>
            <option value="<%- c.id %>" <%- class_id == c.id ? 'selected' : '' %>><%- c.name %> - <%- c.section %></option>
          <% }) %>
        </select>
      </div>

      <div class="col-md-5">
        <label class="form-label fw-semibold small text-secondary mb-1">
          Check Pending Fee Up To Month:
        </label>
        <select name="up_to_month" class="form-select" onchange="this.form.submit()">
          <% sessionMonthsOrder.forEach(m => { 
               const isCurrent = (m === currentOngoingMonth);
               const isSelected = (m === targetMonth);
          %>
            <option value="<%- m %>" <%- isSelected ? 'selected' : '' %>>
              <%- m %> <%- isCurrent ? '(Ongoing Month)' : '' %>
            </option>
          <% }) %>
        </select>
      </div>

      <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100 shadow-sm">
          <i class="fa-solid fa-filter me-1"></i>Filter
        </button>
      </div>
    </form>
  </div>
</div>

<% if (class_id && pendingFees.length > 0) { %>
<div class="card shadow-sm border-0">
  <div class="card-header bg-white py-3 d-flex flex-wrap justify-content-between align-items-center gap-2 border-bottom">
    <div>
      <h6 class="mb-0 fw-bold d-inline text-dark">Pending Fees up to <span class="text-primary"><%- targetMonth %></span></h6>
      <span class="badge bg-danger ms-2"><%- pendingFees.length %> Students with Dues</span>
      <div class="small text-muted mt-1">
        Session Months Checked: <strong><%- expectedMonths.join(', ') %></strong>
      </div>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <button type="button" class="btn btn-success btn-sm shadow-sm fw-semibold" data-bs-toggle="modal" data-bs-target="#bulkMarkPaidModal">
        <i class="fa-solid fa-check-double me-1"></i>Bulk Mark Months as Paid (Pre-ERP)
      </button>
      <a href="/admin/fees/reminder-class/<%- class_id %>?up_to_month=<%- targetMonth %>" target="_blank" class="btn btn-warning btn-sm shadow-sm fw-semibold">
        <i class="fa-solid fa-file-pdf me-1"></i>Print Fee Notices (4 per A4 Sheet)
      </a>
    </div>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-dark">
          <tr>
            <th>Roll / Name</th>
            <th>Adm. No</th>
            <th>Monthly Rate</th>
            <th>Paid Months</th>
            <th>Pending Months</th>
            <th>Prev. Balance</th>
            <th>Total Balance Due</th>
            <th class="text-end pe-3">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% pendingFees.forEach(f => { %>
          <tr>
            <td>
              <div class="fw-bold text-dark"><%- f.name %></div>
              <small class="text-muted">Roll No: <strong><%- f.roll_number || 'N/A' %></strong> | <%- f.class_name %> - <%- f.section %></small>
              <% if (f.uses_transport == 1) { %>
                <div class="badge bg-info text-dark" style="font-size: 0.68rem;">
                  <i class="fa-solid fa-van-shuttle me-1"></i>Van: <%- f.transport_route || 'Active' %> (₹<%- f.monthly_van %>/mo)
                </div>
              <% } %>
            </td>
            <td><code><%- f.admission_no %></code></td>
            <td>
              <div class="fw-semibold">₹<%- parseFloat(f.monthly_rate).toLocaleString('en-IN') %>/mo</div>
              <small class="text-muted" style="font-size: 0.72rem;">Tuition: ₹<%- f.monthly_tuition %><% if(f.monthly_van > 0) { %> + Van: ₹<%- f.monthly_van %><% } %></small>
            </td>
            <td>
              <% if (f.paid_months && f.paid_months !== 'None') { %>
                <span class="badge bg-success bg-opacity-75 text-white" style="white-space: normal; max-width: 130px; display: inline-block;">
                  <%- f.paid_months %>
                </span>
              <% } else { %>
                <span class="text-muted small">No payments yet</span>
              <% } %>
            </td>
            <td>
              <% if (f.pending_months_count > 0) { %>
                <span class="badge bg-danger fs-7">
                  <%- f.pending_months_count === 1 ? '1 Month: ' + f.pending_months_text : f.pending_months_count + ' Months: ' + f.pending_months_text %>
                </span>
                <div class="small text-danger fw-semibold mt-1">₹<%- parseFloat(f.session_due).toLocaleString('en-IN') %></div>
              <% } else { %>
                <span class="badge bg-success">Current Months Paid</span>
              <% } %>
            </td>
            <td>
              <% if (parseFloat(f.previous_balance || 0) > 0) { %>
                <span class="badge bg-warning text-dark">₹<%- parseFloat(f.previous_balance).toLocaleString('en-IN') %></span>
                <% if(f.previous_balance_remarks) { %>
                  <div class="small text-muted" style="font-size: 0.70rem;"><%- f.previous_balance_remarks %></div>
                <% } %>
              <% } else { %>
                <span class="text-muted">-</span>
              <% } %>
            </td>
            <td>
              <span class="badge bg-danger fs-6 py-2 px-2 shadow-sm">₹<%- parseFloat(f.balance).toLocaleString('en-IN') %></span>
            </td>
            <td class="text-end pe-3">
              <div class="btn-group">
                <button type="button" class="btn btn-sm btn-outline-success" 
                        data-student-id="<%- f.student_id %>"
                        data-student-name="<%- f.name %>"
                        data-admission-no="<%- f.admission_no %>"
                        data-unpaid-months="<%- (f.unpaid_months || []).join(',') %>"
                        data-previous-balance="<%- f.previous_balance || 0 %>"
                        onclick="handleMarkPaidClick(this)" 
                        title="Mark Pre-ERP / Offline Fees as Paid">
                  <i class="fa-solid fa-circle-check"></i> Mark Paid
                </button>
                <a href="/admin/fees/reminder/<%- f.student_id %>?up_to_month=<%- targetMonth %>" target="_blank" class="btn btn-sm btn-outline-warning" title="Print Fee Reminder Notice (A4 Slip)">
                  <i class="fa-solid fa-file-pdf"></i> Notice
                </a>
                <a href="/admin/fees/collect?class_id=<%- f.class_id %>&student_id=<%- f.student_id %>" class="btn btn-sm btn-primary" title="Collect Fee">
                  <i class="fa-solid fa-hand-holding-dollar me-1"></i>Collect
                </a>
              </div>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<% } else if (class_id) { %>
<div class="alert alert-success border-0 shadow-sm d-flex align-items-center p-3">
  <i class="fa-solid fa-circle-check fs-4 text-success me-3"></i>
  <div>
    <h6 class="fw-bold mb-1">All Clear!</h6>
    <div>All fees for this class are fully cleared up to <strong><%- targetMonth %></strong> (Session Months: <%- expectedMonths.join(', ') %>).</div>
  </div>
</div>
<% } else { %>
<div class="card border-0 shadow-sm text-center py-5">
  <div class="card-body">
    <i class="fa-solid fa-hand-pointer text-muted fs-1 mb-3"></i>
    <h6 class="fw-bold text-dark">Please select a Class above</h6>
    <p class="text-secondary small mb-0">Select a class to calculate and view pending fees up to the selected ongoing month.</p>
  </div>
</div>
<% } %>

<!-- ==================== MODAL: INDIVIDUAL STUDENT MARK AS PAID ==================== -->
<div class="modal fade" id="studentMarkPaidModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <form action="/admin/fees/mark-paid" method="POST">
        <input type="hidden" name="student_id" id="modalStudentId">
        <input type="hidden" name="class_id" value="<%- class_id || '' %>">
        <input type="hidden" name="return_to" value="/admin/fees/pending?class_id=<%- class_id || '' %>&up_to_month=<%- targetMonth || '' %>">

        <div class="modal-header bg-success text-white py-3">
          <h6 class="modal-title fw-bold">
            <i class="fa-solid fa-circle-check me-2"></i>Mark Pre-ERP / Offline Fees as Paid
          </h6>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body p-4">
          <div class="p-3 bg-light rounded border mb-3">
            <div class="fw-bold text-dark fs-6" id="modalStudentName">-</div>
            <div class="small text-muted">Admission No: <strong id="modalStudentAdm">-</strong></div>
          </div>

          <label class="form-label fw-bold small text-dark mb-2">
            Select Months to Mark as Paid:
          </label>
          <div class="d-flex flex-wrap gap-1 mb-2">
            <button type="button" class="btn btn-xs btn-outline-primary" onclick="selectQuickMonths('pre_erp')">
              Apr to Sep (Pre-ERP)
            </button>
            <button type="button" class="btn btn-xs btn-outline-secondary" onclick="selectQuickMonths('all')">
              All Pending
            </button>
            <button type="button" class="btn btn-xs btn-outline-dark" onclick="selectQuickMonths('none')">
              Clear All
            </button>
          </div>

          <div class="row g-2 mb-3 border rounded p-2 bg-white" id="modalMonthsContainer">
            <% sessionMonthsOrder.forEach(m => { %>
              <div class="col-4 col-sm-3">
                <div class="form-check">
                  <input class="form-check-input single-month-cb" type="checkbox" name="months_paid" value="<%- m %>" id="mcb_<%- m %>">
                  <label class="form-check-label small fw-semibold" for="mcb_<%- m %>"><%- m %></label>
                </div>
              </div>
            <% }) %>
          </div>

          <!-- Clear Previous Balance Option -->
          <div class="form-check mb-3 p-2 bg-light rounded border" id="modalPrevBalWrapper" style="display: none;">
            <input class="form-check-input ms-1" type="checkbox" name="clear_previous_balance" value="1" id="modalClearPrevBal">
            <label class="form-check-label small fw-bold text-danger ms-2" for="modalClearPrevBal">
              Also mark Previous Balance as Paid / Settled (<span id="modalPrevBalAmount">₹0</span>)
            </label>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Payment / Settlement Date:</label>
            <input type="date" name="payment_date" class="form-control form-control-sm" value="<%- new Date().toISOString().split('T')[0] %>">
          </div>

          <div class="mb-0">
            <label class="form-label small fw-semibold">Remarks:</label>
            <input type="text" name="remarks" class="form-control form-control-sm" value="Pre-ERP Fee Paid (Settled Offline prior to ERP implementation)">
          </div>
        </div>

        <div class="modal-footer bg-light py-2">
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-success btn-sm fw-bold px-4">
            <i class="fa-solid fa-check me-1"></i>Confirm &amp; Mark as Paid
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- ==================== MODAL: BULK CLASS MARK AS PAID (PRE-ERP) ==================== -->
<div class="modal fade" id="bulkMarkPaidModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <form action="/admin/fees/mark-paid-bulk" method="POST">
        <input type="hidden" name="class_id" value="<%- class_id || '' %>">

        <div class="modal-header bg-success text-white py-3">
          <h6 class="modal-title fw-bold">
            <i class="fa-solid fa-check-double me-2"></i>Bulk Mark Months as Paid for Entire Class
          </h6>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body p-4">
          <div class="alert alert-info py-2 small mb-3">
            <i class="fa-solid fa-circle-info me-1"></i>
            Use this tool when students paid their school fees offline before the ERP started in October. Selected months will be recorded as paid for all enrolled students in this class.
          </div>

          <label class="form-label fw-bold small text-dark mb-2">
            Select Pre-ERP Months to Mark as Paid:
          </label>
          <div class="d-flex flex-wrap gap-1 mb-2">
            <button type="button" class="btn btn-xs btn-outline-primary" onclick="setBulkMonths('pre_erp')">
              Apr to Sep (Pre-ERP Months)
            </button>
            <button type="button" class="btn btn-xs btn-outline-secondary" onclick="setBulkMonths('all')">
              All 12 Months
            </button>
            <button type="button" class="btn btn-xs btn-outline-dark" onclick="setBulkMonths('none')">
              Clear All
            </button>
          </div>

          <div class="row g-2 mb-3 border rounded p-2 bg-white">
            <% sessionMonthsOrder.forEach(m => { 
                 const isPreErp = ['APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP'].includes(m);
            %>
              <div class="col-4 col-sm-3">
                <div class="form-check">
                  <input class="form-check-input bulk-month-cb" type="checkbox" name="months_paid" value="<%- m %>" id="bmcb_<%- m %>" <%- isPreErp ? 'checked' : '' %>>
                  <label class="form-check-label small fw-semibold" for="bmcb_<%- m %>"><%- m %></label>
                </div>
              </div>
            <% }) %>
          </div>

          <div class="form-check mb-3 p-2 bg-light rounded border">
            <input class="form-check-input ms-1" type="checkbox" name="clear_previous_balance" value="1" id="bulkClearPrevBal">
            <label class="form-check-label small fw-bold text-dark ms-2" for="bulkClearPrevBal">
              Also clear / settle Previous Balance for all students in this class
            </label>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Settlement Date:</label>
            <input type="date" name="payment_date" class="form-control form-control-sm" value="<%- new Date().toISOString().split('T')[0] %>">
          </div>

          <div class="mb-0">
            <label class="form-label small fw-semibold">Remarks:</label>
            <input type="text" name="remarks" class="form-control form-control-sm" value="Pre-ERP Fee Paid Offline (Class Bulk Update)">
          </div>
        </div>

        <div class="modal-footer bg-light py-2">
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-success btn-sm fw-bold px-4">
            <i class="fa-solid fa-check-double me-1"></i>Apply to Entire Class
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  let currentUnpaidMonths = [];

  function handleMarkPaidClick(btn) {
    const studentId = btn.getAttribute('data-student-id');
    const studentName = btn.getAttribute('data-student-name');
    const admissionNo = btn.getAttribute('data-admission-no');
    const unpaidMonthsStr = btn.getAttribute('data-unpaid-months');
    const prevBal = btn.getAttribute('data-previous-balance');
    openStudentMarkPaidModal(studentId, studentName, admissionNo, unpaidMonthsStr, prevBal);
  }

  function openStudentMarkPaidModal(studentId, studentName, admissionNo, unpaidMonthsStr, prevBal) {
    document.getElementById('modalStudentId').value = studentId;
    document.getElementById('modalStudentName').textContent = studentName;
    document.getElementById('modalStudentAdm').textContent = admissionNo;

    currentUnpaidMonths = unpaidMonthsStr ? unpaidMonthsStr.split(',').map(m => m.trim().toUpperCase()) : [];

    const checkboxes = document.querySelectorAll('.single-month-cb');
    checkboxes.forEach(cb => {
      cb.checked = currentUnpaidMonths.includes(cb.value.toUpperCase());
    });

    const prevBalFloat = parseFloat(prevBal) || 0;
    const prevWrapper = document.getElementById('modalPrevBalWrapper');
    const prevCb = document.getElementById('modalClearPrevBal');
    const prevAmt = document.getElementById('modalPrevBalAmount');
    if (prevBalFloat > 0) {
      prevWrapper.style.display = 'block';
      prevCb.checked = true;
      prevAmt.textContent = '₹' + prevBalFloat.toLocaleString('en-IN');
    } else {
      prevWrapper.style.display = 'none';
      prevCb.checked = false;
    }

    const modal = new bootstrap.Modal(document.getElementById('studentMarkPaidModal'));
    modal.show();
  }

  function selectQuickMonths(mode) {
    const preErpList = ['APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP'];
    const checkboxes = document.querySelectorAll('.single-month-cb');
    checkboxes.forEach(cb => {
      const val = cb.value.toUpperCase();
      if (mode === 'pre_erp') {
        cb.checked = preErpList.includes(val) && currentUnpaidMonths.includes(val);
      } else if (mode === 'all') {
        cb.checked = currentUnpaidMonths.includes(val);
      } else if (mode === 'none') {
        cb.checked = false;
      }
    });
  }

  function setBulkMonths(mode) {
    const preErpList = ['APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP'];
    const checkboxes = document.querySelectorAll('.bulk-month-cb');
    checkboxes.forEach(cb => {
      const val = cb.value.toUpperCase();
      if (mode === 'pre_erp') {
        cb.checked = preErpList.includes(val);
      } else if (mode === 'all') {
        cb.checked = true;
      } else if (mode === 'none') {
        cb.checked = false;
      }
    });
  }
</script>

