<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h5 class="fw-bold mb-1"><i class="fa-solid fa-hand-holding-dollar text-success me-2"></i>Fee Collection</h5>
    <small class="text-muted">Collect month-wise tuition and add individual components (ID Card, Annual, Diary, Development, etc.)</small>
  </div>
  <a href="/admin/fees" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-arrow-left me-1"></i>Back to Fees</a>
</div>

<!-- Success Banner for Newly Generated Receipt -->
<% if (typeof new_receipt_id !== 'undefined' && new_receipt_id) { %>
<div class="alert alert-success d-flex justify-content-between align-items-center shadow-sm mb-4">
  <div>
    <i class="fa-solid fa-circle-check fs-4 text-success me-2 align-middle"></i>
    <strong class="align-middle">Fee payment successfully recorded!</strong>
    <span class="ms-2 text-muted align-middle">You can print the A4 dual-copy fee receipt now.</span>
  </div>
  <a href="/admin/fees/receipt/<%- new_receipt_id %>" target="_blank" class="btn btn-success">
    <i class="fa-solid fa-print me-1"></i>Print Fee Receipt
  </a>
</div>
<% } %>

<!-- Step 1: Select Class & Student -->
<div class="card shadow-sm mb-4">
  <div class="card-body">
    <form method="GET" class="row g-3 align-items-end">
      <div class="col-md-5">
        <label class="form-label fw-semibold">Select Class *</label>
        <select name="class_id" class="form-select" onchange="this.form.submit()">
          <option value="">-- Choose Class --</option>
          <% classes.forEach(c => { %>
            <option value="<%- c.id %>" <%- class_id == c.id ? 'selected' : '' %>><%- c.name %> - <%- c.section %> (Session <%- c.academic_year || '2026-27' %>)</option>
          <% }) %>
        </select>
      </div>
      <% if(students.length > 0) { %>
      <div class="col-md-5">
        <label class="form-label fw-semibold">Select Student *</label>
        <select name="student_id" class="form-select" onchange="this.form.submit()">
          <option value="">-- Choose Student --</option>
          <% students.forEach(s => { %>
            <option value="<%- s.id %>" <%- student_id == s.id ? 'selected' : '' %>><%- s.name %> (Adm: <%- s.admission_no %> | Roll: <%- s.roll_number || '-' %>)</option>
          <% }) %>
        </select>
      </div>
      <input type="hidden" name="class_id" value="<%- class_id %>">
      <% } else if(class_id) { %>
      <div class="col-md-5">
        <div class="alert alert-warning py-2 mb-0 small">No students found in this class.</div>
      </div>
      <% } %>
    </form>
  </div>
</div>

<% if(selectedStudent) { %>
<div class="row g-4">
  <!-- Collect Form -->
  <div class="col-lg-6">
    <div class="card shadow-sm border-0">
      <div class="card-header bg-success text-white py-3">
        <div class="d-flex justify-content-between align-items-center">
          <h6 class="mb-0 fw-bold"><i class="fa-solid fa-receipt me-2"></i>Collect Student Fee</h6>
          <span class="badge bg-light text-success fw-bold">Session 2026-27</span>
        </div>
      </div>
      <div class="card-body p-4">
        <!-- Student Details Brief -->
        <div class="p-3 bg-light rounded-3 mb-4 border">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <h5 class="fw-bold text-dark mb-1"><%- selectedStudent.name %></h5>
              <div class="small text-muted mb-1">
                <span class="me-3"><strong>Adm No:</strong> <%- selectedStudent.admission_no %></span>
                <span><strong>Class:</strong> <%- selectedStudent.class_name %> - <%- selectedStudent.section %></span>
              </div>
              <div class="small text-muted">
                <% if(selectedStudent.father_name) { %><span class="me-3"><strong>Father:</strong> <%- selectedStudent.father_name %></span><% } %>
                <% if(selectedStudent.mother_name) { %><span><strong>Mother:</strong> <%- selectedStudent.mother_name %></span><% } %>
              </div>
            </div>
            <span class="badge bg-primary px-3 py-2">Roll No: <%- selectedStudent.roll_number || 'N/A' %></span>
          </div>
        </div>

        <form action="/admin/fees/collect" method="POST" id="feeCollectForm">
          <input type="hidden" name="student_id" value="<%- student_id %>">
          <input type="hidden" name="class_id" value="<%- class_id %>">
          <input type="hidden" name="months_paid" id="monthsPaidInput" value="">

          <!-- Month-Wise Fee Selection -->
          <div class="mb-4">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <label class="form-label fw-bold mb-0 text-dark">
                <i class="fa-solid fa-calendar-days text-primary me-1"></i>Select Fee Month(s)
              </label>
              <div class="btn-group btn-group-sm">
                <button type="button" class="btn btn-outline-secondary py-0 px-2" id="selectAllMonthsBtn">All 12</button>
                <button type="button" class="btn btn-outline-secondary py-0 px-2" id="clearMonthsBtn">Clear</button>
              </div>
            </div>

            <!-- Quarter Quick Selectors -->
            <div class="mb-2 d-flex flex-wrap gap-1">
              <button type="button" class="btn btn-xs btn-outline-info py-0 px-2 small quarter-btn" data-months="APR,MAY,JUN">Q1 (Apr-Jun)</button>
              <button type="button" class="btn btn-xs btn-outline-info py-0 px-2 small quarter-btn" data-months="JUL,AUG,SEP">Q2 (Jul-Sep)</button>
              <button type="button" class="btn btn-xs btn-outline-info py-0 px-2 small quarter-btn" data-months="OCT,NOV,DEC">Q3 (Oct-Dec)</button>
              <button type="button" class="btn btn-xs btn-outline-info py-0 px-2 small quarter-btn" data-months="JAN,FEB,MAR">Q4 (Jan-Mar)</button>
            </div>

            <!-- Month Chips -->
            <div class="month-chips-container d-flex flex-wrap gap-1 p-2 bg-light rounded border">
              <% const allMonths = ['APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC', 'JAN', 'FEB', 'MAR']; %>
              <% allMonths.forEach((m, idx) => { %>
                <label class="btn btn-sm btn-outline-primary month-chip mb-0 <%- idx < 3 ? 'active' : '' %>" style="cursor: pointer;">
                  <input type="checkbox" class="month-checkbox d-none" value="<%- m %>" <%- idx < 3 ? 'checked' : '' %>>
                  <%- m %>
                </label>
              <% }) %>
            </div>
            <div class="mt-2 d-flex justify-content-between align-items-center">
              <small class="text-muted">Selected: <strong id="selectedMonthsText" class="text-primary">APR, MAY, JUN</strong></small>
              <span class="badge bg-secondary" id="monthsCountBadge">3 Months</span>
            </div>
          </div>

          <!-- Base Fee (Tuition Fee) -->
          <div class="card mb-4 border bg-white shadow-none">
            <div class="card-header bg-light py-2">
              <div class="d-flex justify-content-between align-items-center">
                <span class="fw-bold small text-dark"><i class="fa-solid fa-graduation-cap text-success me-1"></i>Primary Fee (Tuition)</span>
                <span class="small text-muted">Monthly Rate: ₹<span id="monthlyRateDisplay">0</span></span>
              </div>
            </div>
            <div class="card-body p-3">
              <div class="row g-2">
                <div class="col-md-7">
                  <label class="form-label small text-muted mb-1">Fee Structure / Type</label>
                  <select name="fee_structure_id" id="feeStructureSelect" class="form-select form-select-sm">
                    <option value="" data-amount="0">-- Custom Tuition Fee --</option>
                    <% feeStructures.forEach(fs => { %>
                      <option value="<%- fs.id %>" data-name="<%- fs.fee_type %>" data-amount="<%- fs.amount %>" <%- fs.fee_type.toLowerCase().includes('tuition') ? 'selected' : '' %>>
                        <%- fs.fee_type %> (₹<%- fs.amount %>/mo)
                      </option>
                    <% }) %>
                  </select>
                  <input type="hidden" name="primary_fee_name" id="primaryFeeName" value="Tuition Fee">
                </div>
                <div class="col-md-5">
                  <label class="form-label small text-muted mb-1">Tuition Total (₹) *</label>
                  <div class="input-group input-group-sm">
                    <span class="input-group-text">₹</span>
                    <input type="number" step="0.01" name="primary_fee_amount" id="primaryFeeAmount" class="form-control fw-bold" placeholder="0.00" value="0.00" required>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Other Fee Components -->
          <div class="mb-4">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <label class="form-label fw-bold mb-0 text-dark">
                <i class="fa-solid fa-layer-group text-primary me-1"></i>Other Fee Components
              </label>
              <button type="button" class="btn btn-sm btn-outline-primary" id="addComponentBtn">
                <i class="fa-solid fa-plus me-1"></i>Add Row
              </button>
            </div>

            <!-- Quick Add Pills -->
            <div class="mb-2 d-flex flex-wrap gap-1">
              <button type="button" class="btn btn-xs btn-outline-secondary py-1 px-2 small quick-add-pill" data-name="ID Card Fee" data-amt="100">+ ID Card Fee</button>
              <button type="button" class="btn btn-xs btn-outline-secondary py-1 px-2 small quick-add-pill" data-name="Annual Fee" data-amt="500">+ Annual Fee</button>
              <button type="button" class="btn btn-xs btn-outline-secondary py-1 px-2 small quick-add-pill" data-name="Diary Fee" data-amt="150">+ Diary Fee</button>
              <button type="button" class="btn btn-xs btn-outline-secondary py-1 px-2 small quick-add-pill" data-name="Development Fee" data-amt="500">+ Development Fee</button>
              <button type="button" class="btn btn-xs btn-outline-secondary py-1 px-2 small quick-add-pill" data-name="Exam Fee" data-amt="300">+ Exam Fee</button>
              <button type="button" class="btn btn-xs btn-outline-secondary py-1 px-2 small quick-add-pill" data-name="Admission Fee" data-amt="1000">+ Admission Fee</button>
              <button type="button" class="btn btn-xs btn-outline-secondary py-1 px-2 small quick-add-pill" data-name="Conveyance Fee" data-amt="0">+ Conveyance Fee</button>
            </div>

            <!-- Dynamic Components Container -->
            <div id="componentsContainer" class="d-flex flex-column gap-2">
              <!-- Dynamically populated rows -->
            </div>
          </div>

          <!-- Total Calculation Card -->
          <div class="p-3 bg-light rounded-3 mb-4 border border-success">
            <div class="d-flex justify-content-between align-items-center mb-1">
              <span class="text-muted small">Base Tuition Fee:</span>
              <span class="fw-semibold" id="tuitionSummary">₹0.00</span>
            </div>
            <div class="d-flex justify-content-between align-items-center mb-2">
              <span class="text-muted small">Other Components Total:</span>
              <span class="fw-semibold" id="componentsSummary">₹0.00</span>
            </div>
            <hr class="my-2">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <span class="fw-bold fs-6 text-dark">Total Amount to Collect:</span>
                <div class="small text-muted" id="inWordsPreview">Zero Rupees Only</div>
              </div>
              <div class="text-end">
                <span class="fs-4 fw-bold text-success" id="grandTotalDisplay">₹0.00</span>
                <input type="hidden" name="amount_paid" id="amountPaidInput" value="0.00">
              </div>
            </div>
          </div>

          <!-- Payment Mode & Date -->
          <div class="row g-3 mb-4">
            <div class="col-md-6">
              <label class="form-label fw-semibold">Payment Mode</label>
              <select name="payment_mode" class="form-select">
                <option value="Cash" selected>Cash</option>
                <option value="Online">Online / UPI</option>
                <option value="Cheque">Cheque</option>
                <option value="DD">Demand Draft (DD)</option>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Payment Date</label>
              <input type="date" name="payment_date" class="form-control" value="<%- new Date().toISOString().slice(0, 10) %>">
            </div>
            <div class="col-12">
              <label class="form-label fw-semibold">Remarks / Note (Optional)</label>
              <input type="text" name="remarks" class="form-control" placeholder="e.g. Paid in cash at counter, slip issued">
            </div>
          </div>

          <button type="submit" class="btn btn-success btn-lg w-100 shadow-sm py-2">
            <i class="fa-solid fa-receipt me-2"></i>Collect Fee & Generate Receipt
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Right: Payment History -->
  <div class="col-lg-6">
    <div class="card shadow-sm border-0">
      <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-bold"><i class="fa-solid fa-clock-rotate-left text-primary me-2"></i>Payment History (<%- selectedStudent.name %>)</h6>
        <a href="/admin/fees/reminder/<%- student_id %>" target="_blank" class="btn btn-sm btn-outline-warning">
          <i class="fa-solid fa-bell me-1"></i>Fee Notice (Hindi)
        </a>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>Receipt / Date</th>
                <th>Fee Details & Months</th>
                <th class="text-end">Amount</th>
                <th class="text-center">Receipt</th>
              </tr>
            </thead>
            <tbody>
              <% if(payments.length > 0) { %>
                <% payments.forEach(p => { %>
                <tr>
                  <td>
                    <span class="badge bg-secondary mb-1"><%- p.receipt_no %></span>
                    <div class="small text-muted"><%- new Date(p.payment_date).toLocaleDateString('en-IN') %></div>
                    <span class="badge bg-light text-dark border small"><%- p.payment_mode %></span>
                  </td>
                  <td>
                    <% if(p.months_paid) { %>
                      <div class="mb-1"><span class="badge bg-primary-subtle text-primary border border-primary"><i class="fa-solid fa-calendar-check me-1"></i><%- p.months_paid %></span></div>
                    <% } %>
                    
                    <% let items = [];
                       if (p.breakdown_json) {
                         try { items = JSON.parse(p.breakdown_json); } catch(e){}
                       }
                    %>
                    <% if(items.length > 0) { %>
                      <div class="small">
                        <% items.forEach(it => { %>
                          <span class="badge bg-light text-dark border me-1 mb-1"><%- it.name %>: ₹<%- parseFloat(it.amount || 0).toLocaleString('en-IN') %></span>
                        <% }) %>
                      </div>
                    <% } else { %>
                      <div class="small text-dark fw-semibold"><%- p.fee_type || 'Tuition Fee' %></div>
                    <% } %>
                    
                    <% if(p.remarks) { %><div class="small text-muted fst-italic mt-1"><%- p.remarks %></div><% } %>
                  </td>
                  <td class="text-end">
                    <strong class="text-success fs-6">₹<%- parseFloat(p.amount_paid).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></strong>
                  </td>
                  <td class="text-center">
                    <a href="/admin/fees/receipt/<%- p.id %>" target="_blank" class="btn btn-sm btn-outline-primary" title="Print Fee Receipt (Student Copy & College Copy)">
                      <i class="fa-solid fa-print me-1"></i>Print
                    </a>
                  </td>
                </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="4" class="text-center text-muted py-4">
                    <i class="fa-solid fa-receipt fs-2 mb-2 d-block opacity-25"></i>
                    No previous fee records found for this student.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
<% } %>

<style>
.month-chip {
  min-width: 58px;
  text-align: center;
  font-weight: 600;
  transition: all 0.2s ease;
}
.month-chip.active {
  background-color: #0d6efd;
  color: white;
  border-color: #0d6efd;
}
.quarter-btn {
  font-size: 0.75rem;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const monthChips = document.querySelectorAll('.month-chip');
  const monthsPaidInput = document.getElementById('monthsPaidInput');
  const selectedMonthsText = document.getElementById('selectedMonthsText');
  const monthsCountBadge = document.getElementById('monthsCountBadge');
  const selectAllBtn = document.getElementById('selectAllMonthsBtn');
  const clearBtn = document.getElementById('clearMonthsBtn');
  const quarterBtns = document.querySelectorAll('.quarter-btn');

  const feeStructureSelect = document.getElementById('feeStructureSelect');
  const primaryFeeName = document.getElementById('primaryFeeName');
  const primaryFeeAmount = document.getElementById('primaryFeeAmount');
  const monthlyRateDisplay = document.getElementById('monthlyRateDisplay');

  const componentsContainer = document.getElementById('componentsContainer');
  const addComponentBtn = document.getElementById('addComponentBtn');
  const quickAddPills = document.querySelectorAll('.quick-add-pill');

  const tuitionSummary = document.getElementById('tuitionSummary');
  const componentsSummary = document.getElementById('componentsSummary');
  const grandTotalDisplay = document.getElementById('grandTotalDisplay');
  const amountPaidInput = document.getElementById('amountPaidInput');
  const inWordsPreview = document.getElementById('inWordsPreview');

  // Helper to convert number to words INR
  function numToWords(n) {
    if (!n || n <= 0) return 'Zero Rupees Only';
    const a = ['','One ','Two ','Three ','Four ','Five ','Six ','Seven ','Eight ','Nine ','Ten ','Eleven ','Twelve ','Thirteen ','Fourteen ','Fifteen ','Sixteen ','Seventeen ','Eighteen ','Nineteen '];
    const b = ['', '', 'Twenty','Thirty','Forty','Fifty','Sixty','Seventy','Eighty','Ninety'];
    function inWords(num) {
      if ((num = num.toString()).length > 9) return 'overflow';
      const n = ('000000000' + num).substr(-9).match(/^(\d{2})(\d{2})(\d{2})(\d{1})(\d{2})$/);
      if (!n) return '';
      let str = '';
      str += (n[1] != 0) ? (a[Number(n[1])] || b[n[1][0]] + ' ' + a[n[1][1]]) + 'Crore ' : '';
      str += (n[2] != 0) ? (a[Number(n[2])] || b[n[2][0]] + ' ' + a[n[2][1]]) + 'Lakh ' : '';
      str += (n[3] != 0) ? (a[Number(n[3])] || b[n[3][0]] + ' ' + a[n[3][1]]) + 'Thousand ' : '';
      str += (n[4] != 0) ? (a[Number(n[4])] || b[n[4][0]] + ' ' + a[n[4][1]]) + 'Hundred ' : '';
      str += (n[5] != 0) ? ((str != '') ? 'and ' : '') + (a[Number(n[5])] || b[n[5][0]] + ' ' + a[n[5][1]]) : '';
      return str.trim();
    }
    return inWords(Math.floor(n)) + ' Rupees Only';
  }

  function getSelectedMonths() {
    const selected = [];
    document.querySelectorAll('.month-checkbox:checked').forEach(cb => {
      selected.push(cb.value);
    });
    return selected;
  }

  function updateMonthsUI() {
    const months = getSelectedMonths();
    const monthsStr = months.join(', ');
    if (monthsPaidInput) monthsPaidInput.value = monthsStr;
    if (selectedMonthsText) selectedMonthsText.innerText = monthsStr || 'None selected';
    if (monthsCountBadge) monthsCountBadge.innerText = `${months.length} Month${months.length === 1 ? '' : 's'}`;

    // Auto-update base tuition fee if fee structure is selected
    if (feeStructureSelect) {
      const selectedOpt = feeStructureSelect.options[feeStructureSelect.selectedIndex];
      const monthlyRate = parseFloat(selectedOpt.getAttribute('data-amount')) || 0;
      if (monthlyRateDisplay) monthlyRateDisplay.innerText = monthlyRate.toLocaleString('en-IN');
      if (primaryFeeName) primaryFeeName.value = selectedOpt.getAttribute('data-name') || 'Tuition Fee';

      if (monthlyRate > 0) {
        const count = months.length > 0 ? months.length : 1;
        const autoAmt = monthlyRate * count;
        if (primaryFeeAmount) primaryFeeAmount.value = autoAmt.toFixed(2);
      }
    }
    recalculateTotals();
  }

  // Month Chips click handler
  monthChips.forEach(chip => {
    chip.addEventListener('click', function (e) {
      const cb = this.querySelector('.month-checkbox');
      if (e.target !== cb) {
        cb.checked = !cb.checked;
      }
      if (cb.checked) {
        this.classList.add('active');
      } else {
        this.classList.remove('active');
      }
      updateMonthsUI();
    });
  });

  if (selectAllBtn) {
    selectAllBtn.addEventListener('click', function () {
      monthChips.forEach(chip => {
        chip.querySelector('.month-checkbox').checked = true;
        chip.classList.add('active');
      });
      updateMonthsUI();
    });
  }

  if (clearBtn) {
    clearBtn.addEventListener('click', function () {
      monthChips.forEach(chip => {
        chip.querySelector('.month-checkbox').checked = false;
        chip.classList.remove('active');
      });
      updateMonthsUI();
    });
  }

  quarterBtns.forEach(btn => {
    btn.addEventListener('click', function () {
      const qMonths = this.getAttribute('data-months').split(',');
      monthChips.forEach(chip => {
        const cb = chip.querySelector('.month-checkbox');
        const match = qMonths.includes(cb.value);
        cb.checked = match;
        if (match) chip.classList.add('active');
        else chip.classList.remove('active');
      });
      updateMonthsUI();
    });
  });

  if (feeStructureSelect) {
    feeStructureSelect.addEventListener('change', updateMonthsUI);
  }

  if (primaryFeeAmount) {
    primaryFeeAmount.addEventListener('input', recalculateTotals);
  }

  // Dynamic Component Rows
  function addComponentRow(name = '', amount = 0) {
    const rowId = 'comp_' + Date.now() + '_' + Math.floor(Math.random() * 1000);
    const div = document.createElement('div');
    div.className = 'row g-2 align-items-center component-row';
    div.id = rowId;
    div.innerHTML = `
      <div class="col-7">
        <div class="input-group input-group-sm">
          <span class="input-group-text bg-white"><i class="fa-solid fa-tag text-muted"></i></span>
          <input type="text" name="component_name[]" class="form-control" value="${name}" placeholder="Component Name (e.g. ID Card)" required>
        </div>
      </div>
      <div class="col-4">
        <div class="input-group input-group-sm">
          <span class="input-group-text">₹</span>
          <input type="number" step="0.01" name="component_amount[]" class="form-control comp-amount fw-semibold" value="${amount > 0 ? amount.toFixed(2) : ''}" placeholder="0.00" required>
        </div>
      </div>
      <div class="col-1 text-end">
        <button type="button" class="btn btn-sm btn-outline-danger p-1 remove-comp-btn" title="Remove"><i class="fa-solid fa-xmark"></i></button>
      </div>
    `;

    componentsContainer.appendChild(div);

    div.querySelector('.remove-comp-btn').addEventListener('click', function () {
      div.remove();
      recalculateTotals();
    });

    div.querySelector('.comp-amount').addEventListener('input', recalculateTotals);
    
    // Focus amount if name is provided, else focus name
    const amtInput = div.querySelector('.comp-amount');
    const nameInput = div.querySelector('input[name="component_name[]"]');
    if (name) {
      amtInput.focus();
      amtInput.select();
    } else {
      nameInput.focus();
    }

    recalculateTotals();
  }

  if (addComponentBtn) {
    addComponentBtn.addEventListener('click', function () {
      addComponentRow('', 0);
    });
  }

  quickAddPills.forEach(pill => {
    pill.addEventListener('click', function () {
      const name = this.getAttribute('data-name');
      const amt = parseFloat(this.getAttribute('data-amt')) || 0;
      addComponentRow(name, amt);
    });
  });

  function recalculateTotals() {
    const pAmt = parseFloat(primaryFeeAmount ? primaryFeeAmount.value : 0) || 0;
    let compTotal = 0;
    document.querySelectorAll('.comp-amount').forEach(inp => {
      compTotal += parseFloat(inp.value) || 0;
    });

    const grandTotal = pAmt + compTotal;

    if (tuitionSummary) tuitionSummary.innerText = `₹${pAmt.toLocaleString('en-IN', { minimumFractionDigits: 2 })}`;
    if (componentsSummary) componentsSummary.innerText = `₹${compTotal.toLocaleString('en-IN', { minimumFractionDigits: 2 })}`;
    if (grandTotalDisplay) grandTotalDisplay.innerText = `₹${grandTotal.toLocaleString('en-IN', { minimumFractionDigits: 2 })}`;
    if (amountPaidInput) amountPaidInput.value = grandTotal.toFixed(2);
    if (inWordsPreview) inWordsPreview.innerText = numToWords(grandTotal);
  }

  // Initial calculations
  updateMonthsUI();
});
</script>
