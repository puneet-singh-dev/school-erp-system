<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <div>
    <h5 class="fw-bold mb-1"><i class="fa-solid fa-hand-holding-dollar text-success me-2"></i>Fee Collection</h5>
    <small class="text-muted">Fast & easy fee collection with automated monthly tuition and simplified van fee system</small>
  </div>
  <a href="/admin/fees" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-arrow-left me-1"></i>Back to Fees</a>
</div>

<!-- Success Banner for Newly Generated Receipt -->
<% if (typeof new_receipt_id !== 'undefined' && new_receipt_id) { %>
<div class="alert alert-success d-flex justify-content-between align-items-center shadow-sm mb-4">
  <div>
    <i class="fa-solid fa-circle-check fs-4 text-success me-2 align-middle"></i>
    <strong class="align-middle">Fee payment successfully recorded!</strong>
    <span class="ms-2 text-muted align-middle">Dual-copy fee receipt is ready to print.</span>
  </div>
  <a href="/admin/fees/receipt/<%- new_receipt_id %>" target="_blank" class="btn btn-success">
    <i class="fa-solid fa-print me-1"></i>Print Fee Receipt
  </a>
</div>
<% } %>

<!-- Step 1: Select Class & Student -->
<div class="card shadow-sm mb-4 border-0">
  <div class="card-body p-3">
    <form method="GET" class="row g-3 align-items-end">
      <div class="col-md-5">
        <label class="form-label fw-bold small text-muted">1. Select Class *</label>
        <select name="class_id" class="form-select" onchange="this.form.submit()">
          <option value="">-- Choose Class --</option>
          <% classes.forEach(c => { %>
            <option value="<%- c.id %>" <%- class_id == c.id ? 'selected' : '' %>><%- c.name %> - <%- c.section %> (<%- c.academic_year || '2026-27' %>)</option>
          <% }) %>
        </select>
      </div>
      <% if(students.length > 0) { %>
      <div class="col-md-5">
        <label class="form-label fw-bold small text-muted">2. Select Student *</label>
        <select name="student_id" class="form-select" onchange="this.form.submit()">
          <option value="">-- Choose Student --</option>
          <% students.forEach(s => { %>
            <option value="<%- s.id %>" <%- student_id == s.id ? 'selected' : '' %>>
              <%- s.name %> (Roll: <%- s.roll_number || '-' %> | Adm: <%- s.admission_no %>)
            </option>
          <% }) %>
        </select>
      </div>
      <input type="hidden" name="class_id" value="<%- class_id %>">
      <% } else if(class_id) { %>
      <div class="col-md-5">
        <div class="alert alert-warning py-2 mb-0 small"><i class="fa-solid fa-triangle-exclamation me-1"></i>No students found in this class.</div>
      </div>
      <% } %>
    </form>
  </div>
</div>

<% if(selectedStudent) { %>
<div class="row g-4">
  <!-- Left Column: The Simplified Fee Collection Form -->
  <div class="col-lg-7">
    <div class="card shadow-sm border-0">
      <div class="card-header bg-success text-white py-3 d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-bold"><i class="fa-solid fa-receipt me-2"></i>Collect Student Fee</h6>
        <span class="badge bg-light text-success fw-bold"><%- selectedStudent.class_name %> - <%- selectedStudent.section %></span>
      </div>
      <div class="card-body p-4">
        
        <!-- Student Info Header -->
        <div class="p-3 bg-light rounded-3 mb-4 border d-flex justify-content-between align-items-center flex-wrap gap-2">
          <div>
            <h5 class="fw-bold mb-1 text-dark"><%- selectedStudent.name %></h5>
            <div class="small text-muted">
              <span class="me-3"><strong>Adm No:</strong> <%- selectedStudent.admission_no %></span>
              <span class="me-3"><strong>Father:</strong> <%- selectedStudent.father_name || selectedStudent.guardian_name || '-' %></span>
              <% if(selectedStudent.phone || selectedStudent.guardian_phone) { %>
                <span><strong>Phone:</strong> <%- selectedStudent.phone || selectedStudent.guardian_phone %></span>
              <% } %>
            </div>
          </div>
          <div class="text-end">
            <span class="badge bg-primary px-3 py-2 fs-6">Roll No: <%- selectedStudent.roll_number || 'N/A' %></span>
          </div>
        </div>

        <form action="/admin/fees/collect" method="POST" id="easyFeeForm">
          <input type="hidden" name="student_id" value="<%- student_id %>">
          <input type="hidden" name="class_id" value="<%- class_id %>">
          <input type="hidden" name="months_paid" id="monthsPaidInput" value="">

          <!-- ==================== SECTION 1: MONTH SELECTION ==================== -->
          <div class="mb-4">
            <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
              <label class="form-label fw-bold mb-0 text-dark">
                <i class="fa-solid fa-calendar-days text-primary me-1"></i>Select Fee Month(s):
              </label>
              <div class="btn-group btn-group-sm">
                <button type="button" class="btn btn-outline-primary py-0 px-2 quick-m-btn active" data-count="1">1 Month</button>
                <button type="button" class="btn btn-outline-primary py-0 px-2 quick-m-btn" data-count="2">2 Months</button>
                <button type="button" class="btn btn-outline-primary py-0 px-2 quick-m-btn" data-count="3">3 Months</button>
                <button type="button" class="btn btn-outline-secondary py-0 px-2" id="clearMonthsBtn">Clear</button>
                <button type="button" class="btn btn-outline-secondary py-0 px-2" id="selectAllMonthsBtn">All 12</button>
              </div>
            </div>

            <!-- Month Chips -->
            <% 
              const paidMonths = new Set();
              if (payments && payments.length > 0) {
                payments.forEach(p => {
                  if (p.months_paid) {
                    p.months_paid.split(',').forEach(m => {
                      const t = m.trim().toUpperCase();
                      if (t) paidMonths.add(t);
                    });
                  }
                });
              }
              const allMonths = ['APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC', 'JAN', 'FEB', 'MAR'];
              let defaultSelectedMonth = null;
              for (const m of allMonths) {
                if (!paidMonths.has(m)) {
                  defaultSelectedMonth = m;
                  break;
                }
              }
              if (!defaultSelectedMonth) defaultSelectedMonth = 'APR';
            %>
            <div class="d-flex flex-wrap gap-1 p-2 bg-light rounded border">
              <% allMonths.forEach((m) => { 
                   const isPaid = paidMonths.has(m);
                   const isDefault = (m === defaultSelectedMonth && !isPaid);
              %>
                <div>
                  <input type="checkbox" class="btn-check month-checkbox" id="m_<%- m %>" value="<%- m %>" autocomplete="off" <%- isDefault ? 'checked' : '' %>>
                  <label class="btn btn-sm <%- isPaid ? 'btn-outline-success border-success' : 'btn-outline-primary' %>" for="m_<%- m %>" style="min-width: 50px;">
                    <%- m %>
                    <% if (isPaid) { %><i class="fa-solid fa-check small ms-1" title="Already Paid"></i><% } %>
                  </label>
                </div>
              <% }) %>
            </div>
            <div class="mt-2 d-flex justify-content-between align-items-center">
              <small class="text-muted">Selected Months: <strong id="selectedMonthsLabel" class="text-primary"><%- defaultSelectedMonth %></strong></small>
              <span class="badge bg-primary" id="monthsBadge">1 Month</span>
            </div>
          </div>

          <!-- ==================== SECTION 2: TUITION FEE ==================== -->
          <div class="card mb-3 border shadow-none bg-white">
            <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
              <span class="fw-bold small text-dark"><i class="fa-solid fa-graduation-cap text-primary me-1"></i>1. Monthly Tuition Fee</span>
              <span class="small text-muted">Monthly Rate: ₹<span id="tuitionRateDisplay">0</span></span>
            </div>
            <div class="card-body p-3">
              <div class="row g-2 align-items-center">
                <div class="col-md-7">
                  <label class="form-label small text-muted mb-1">Fee Type / Structure</label>
                  <select name="fee_structure_id" id="tuitionStructureSelect" class="form-select form-select-sm">
                    <% feeStructures.forEach(fs => { %>
                      <option value="<%- fs.id %>" data-name="<%- fs.fee_type %>" data-amount="<%- fs.amount %>" <%- fs.fee_type.toLowerCase().includes('tuition') ? 'selected' : '' %>>
                        <%- fs.fee_type %> (₹<%- fs.amount %>/mo)
                      </option>
                    <% }) %>
                    <option value="" data-amount="0">-- Custom Tuition Fee --</option>
                  </select>
                  <input type="hidden" name="primary_fee_name" id="primaryFeeName" value="Tuition Fee">
                </div>
                <div class="col-md-5">
                  <label class="form-label small text-muted mb-1">Tuition Total Amount (₹)</label>
                  <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light">₹</span>
                    <input type="number" step="0.01" name="primary_fee_amount" id="tuitionAmountInput" class="form-control fw-bold fs-6" value="0.00">
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- ==================== SECTION 3: SIMPLIFIED VAN / TRANSPORT FEE ==================== -->
          <% const studentHasVan = (selectedStudent.uses_transport == 1 || selectedStudent.uses_transport === true); %>
          <div class="card mb-3 border border-success shadow-none bg-white">
            <div class="card-header bg-success-subtle py-2 d-flex justify-content-between align-items-center">
              <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" role="switch" name="van_fee_enabled" id="vanFeeSwitch" value="1" <%- studentHasVan ? 'checked' : '' %>>
                <label class="form-check-label fw-bold text-success" for="vanFeeSwitch">
                  <i class="fa-solid fa-van-shuttle me-1"></i>2. Collect School Van / Transport Fee
                </label>
              </div>
              <span class="badge <%- studentHasVan ? 'bg-success' : 'bg-secondary' %>" id="vanStatusBadge">
                <%- studentHasVan ? 'Van Subscribed' : 'Own Transport' %>
              </span>
            </div>

            <div class="card-body p-3" id="vanFeeBody" style="<%- studentHasVan ? '' : 'display: none;' %>">
              <div class="row g-2 mb-2">
                <div class="col-md-5">
                  <label class="form-label small text-muted mb-1">Pickup / Drop Route / Stop</label>
                  <input type="text" name="van_route" id="vanRouteInput" class="form-control form-control-sm"
                    value="<%- selectedStudent.transport_route || 'Karma Bazar' %>"
                    placeholder="e.g. Karma Bazar / Vijay Nagar">
                </div>
                <div class="col-md-4">
                  <label class="form-label small text-muted mb-1">Van Fee Per Month (₹)</label>
                  <div class="input-group input-group-sm">
                    <span class="input-group-text">₹</span>
                    <input type="number" step="0.01" min="0" name="van_monthly_rate" id="vanMonthlyRateInput" class="form-control form-control-sm fw-semibold"
                      value="<%- selectedStudent.transport_fee ? parseFloat(selectedStudent.transport_fee).toFixed(2) : '500.00' %>">
                  </div>
                </div>
                <div class="col-md-3">
                  <label class="form-label small text-muted mb-1">Van Months</label>
                  <div class="input-group input-group-sm">
                    <input type="number" min="1" max="12" name="van_months_count" id="vanMonthsCountInput" class="form-control form-control-sm text-center fw-bold" value="1">
                    <span class="input-group-text small">mo</span>
                  </div>
                </div>
              </div>

              <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                <div class="form-check mb-0">
                  <input class="form-check-input" type="checkbox" name="update_van_settings" id="updateVanSettings" value="1" checked>
                  <label class="form-check-label small text-muted" for="updateVanSettings">
                    Save this route &amp; monthly fee to student's profile
                  </label>
                </div>
                <div class="text-end">
                  <span class="small text-muted me-2">Van Total:</span>
                  <strong class="text-success fs-6">₹<span id="vanTotalText">0.00</span></strong>
                  <input type="hidden" name="van_fee_total" id="vanFeeTotalInput" value="0.00">
                </div>
              </div>
            </div>
          </div>

          <!-- ==================== SECTION 4: PREVIOUS BALANCE ARREARS (IF ANY) ==================== -->
          <% const hasPrevDue = (selectedStudent.previous_balance && parseFloat(selectedStudent.previous_balance) > 0); %>
          <% if(hasPrevDue) { %>
          <div class="card mb-3 border border-danger shadow-none bg-white">
            <div class="card-header bg-danger-subtle py-2 d-flex justify-content-between align-items-center">
              <div class="form-check mb-0">
                <input class="form-check-input" type="checkbox" id="prevBalanceCheck" checked>
                <label class="form-check-label fw-bold text-danger" for="prevBalanceCheck">
                  <i class="fa-solid fa-clock-rotate-left me-1"></i>3. Collect Previous Class Balance
                </label>
              </div>
              <span class="badge bg-danger">Pending: ₹<%- parseFloat(selectedStudent.previous_balance).toFixed(2) %></span>
            </div>
            <div class="card-body p-3" id="prevBalanceBody">
              <div class="row g-2 align-items-center">
                <div class="col-md-7">
                  <span class="small text-muted d-block">Student has pending dues from previous class/session.</span>
                  <% if(selectedStudent.previous_balance_remarks) { %>
                    <small class="text-secondary fst-italic"><%- selectedStudent.previous_balance_remarks %></small>
                  <% } %>
                </div>
                <div class="col-md-5">
                  <label class="form-label small text-muted mb-1">Amount to Pay (₹)</label>
                  <div class="input-group input-group-sm">
                    <span class="input-group-text bg-danger text-white">₹</span>
                    <input type="number" step="0.01" min="0" max="<%- parseFloat(selectedStudent.previous_balance) %>" 
                           name="prev_balance_collected" id="prevBalanceAmount" class="form-control fw-bold" 
                           value="<%- parseFloat(selectedStudent.previous_balance).toFixed(2) %>">
                  </div>
                </div>
              </div>
            </div>
          </div>
          <% } %>

          <!-- ==================== SECTION 5: OTHER OPTIONAL FEES ==================== -->
          <div class="card mb-4 border shadow-none bg-white">
            <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
              <span class="fw-bold small text-dark"><i class="fa-solid fa-layer-group text-primary me-1"></i>4. Other Fee Charges (Optional)</span>
              <button type="button" class="btn btn-xs btn-outline-primary py-0 px-2" id="addCustomFeeBtn">
                <i class="fa-solid fa-plus me-1"></i>Add Item
              </button>
            </div>
            <div class="card-body p-3">
              <!-- Quick Add Buttons -->
              <div class="d-flex flex-wrap gap-1 mb-2">
                <button type="button" class="btn btn-xs btn-outline-secondary py-1 px-2 small quick-item-pill" data-name="Admission Fee" data-amt="1000">+ Admission Fee</button>
                <button type="button" class="btn btn-xs btn-outline-secondary py-1 px-2 small quick-item-pill" data-name="Exam Fee" data-amt="300">+ Exam Fee</button>
                <button type="button" class="btn btn-xs btn-outline-secondary py-1 px-2 small quick-item-pill" data-name="ID Card Fee" data-amt="100">+ ID Card Fee</button>
                <button type="button" class="btn btn-xs btn-outline-secondary py-1 px-2 small quick-item-pill" data-name="Diary Fee" data-amt="150">+ Diary Fee</button>
                <button type="button" class="btn btn-xs btn-outline-secondary py-1 px-2 small quick-item-pill" data-name="Annual Charge" data-amt="500">+ Annual Charge</button>
              </div>

              <!-- Container for other components -->
              <div id="otherComponentsList" class="d-flex flex-column gap-2"></div>
            </div>
          </div>

          <!-- ==================== TOTAL SUMMARY & PAYMENT ==================== -->
          <div class="p-3 bg-light rounded-3 mb-4 border border-success">
            <div class="d-flex justify-content-between align-items-center mb-1">
              <span class="text-muted small">Tuition Fee:</span>
              <span class="fw-semibold" id="sumTuition">₹0.00</span>
            </div>
            <div class="d-flex justify-content-between align-items-center mb-1">
              <span class="text-muted small">School Van Fee:</span>
              <span class="fw-semibold text-success" id="sumVan">₹0.00</span>
            </div>
            <% if(hasPrevDue) { %>
            <div class="d-flex justify-content-between align-items-center mb-1">
              <span class="text-muted small">Previous Balance:</span>
              <span class="fw-semibold text-danger" id="sumPrev">₹0.00</span>
            </div>
            <% } %>
            <div class="d-flex justify-content-between align-items-center mb-2">
              <span class="text-muted small">Other Charges:</span>
              <span class="fw-semibold" id="sumOther">₹0.00</span>
            </div>
            <hr class="my-2">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <span class="fw-bold fs-6 text-dark">Total Fee to Collect:</span>
                <div class="small text-muted" id="inWordsLabel">Zero Rupees Only</div>
              </div>
              <div class="text-end">
                <span class="fs-3 fw-bold text-success" id="grandTotalLabel">₹0.00</span>
                <input type="hidden" name="amount_paid" id="grandTotalInput" value="0.00">
              </div>
            </div>
          </div>

          <!-- Payment Details -->
          <div class="row g-3 mb-4">
            <div class="col-md-6">
              <label class="form-label fw-bold small">Payment Mode</label>
              <select name="payment_mode" class="form-select">
                <option value="Cash" selected>Cash</option>
                <option value="Online">Online / UPI / QR</option>
                <option value="Cheque">Cheque</option>
                <option value="DD">Demand Draft</option>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-bold small">Payment Date</label>
              <input type="date" name="payment_date" class="form-control" value="<%- new Date().toISOString().slice(0, 10) %>">
            </div>
            <div class="col-12">
              <label class="form-label fw-bold small">Remarks (Optional)</label>
              <input type="text" name="remarks" class="form-control" placeholder="e.g. Paid at counter, dual-copy receipt issued">
            </div>
          </div>

          <button type="submit" class="btn btn-success btn-lg w-100 shadow py-2 fw-bold">
            <i class="fa-solid fa-receipt me-2"></i>Collect Fee &amp; Print Receipt
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Right Column: Student Payment History -->
  <div class="col-lg-5">
    <div class="card shadow-sm border-0">
      <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-bold"><i class="fa-solid fa-clock-rotate-left text-primary me-2"></i>Payment History</h6>
        <a href="/admin/fees/reminder/<%- student_id %>" target="_blank" class="btn btn-sm btn-outline-warning">
          <i class="fa-solid fa-bell me-1"></i>Fee Notice
        </a>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>Receipt / Date</th>
                <th>Fee Details</th>
                <th class="text-end pe-3">Amount</th>
                <th class="text-center">Action</th>
              </tr>
            </thead>
            <tbody>
              <% if(payments && payments.length > 0) { %>
                <% payments.forEach(p => { %>
                <tr>
                  <td>
                    <span class="badge bg-secondary mb-1"><%- p.receipt_no %></span>
                    <div class="small text-muted"><%- new Date(p.payment_date).toLocaleDateString('en-IN') %></div>
                    <span class="badge bg-light text-dark border small"><%- p.payment_mode %></span>
                  </td>
                  <td>
                    <% if(p.months_paid) { %>
                      <span class="badge bg-primary-subtle text-primary border border-primary d-inline-block mb-1">
                        <i class="fa-solid fa-calendar me-1"></i><%- p.months_paid %>
                      </span>
                    <% } %>
                    
                    <% let items = [];
                       if (p.breakdown_json) {
                         try { items = JSON.parse(p.breakdown_json); } catch(e){}
                       }
                    %>
                    <% if(items.length > 0) { %>
                      <div class="small">
                        <% items.forEach(it => { %>
                          <span class="badge bg-light text-dark border me-1 mb-1"><%- it.name %>: ₹<%- parseFloat(it.amount || 0).toLocaleString('en-IN') %></span>
                        <% }) %>
                      </div>
                    <% } else { %>
                      <div class="small text-dark fw-semibold"><%- p.fee_type || 'Tuition Fee' %></div>
                    <% } %>
                  </td>
                  <td class="text-end pe-3">
                    <strong class="text-success fs-6">₹<%- parseFloat(p.amount_paid).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></strong>
                  </td>
                  <td class="text-center">
                    <a href="/admin/fees/receipt/<%- p.id %>" target="_blank" class="btn btn-sm btn-outline-primary" title="Print Fee Receipt">
                      <i class="fa-solid fa-print"></i>
                    </a>
                  </td>
                </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="4" class="text-center text-muted py-5">
                    <i class="fa-solid fa-receipt fs-2 mb-2 d-block opacity-25"></i>
                    No previous fee records for this student.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
<% } %>

<!-- ==================== JAVASCRIPT LOGIC ==================== -->
<script>
document.addEventListener('DOMContentLoaded', function () {
  // Elements
  const monthCheckboxes = document.querySelectorAll('.month-checkbox');
  const monthsPaidInput = document.getElementById('monthsPaidInput');
  const selectedMonthsLabel = document.getElementById('selectedMonthsLabel');
  const monthsBadge = document.getElementById('monthsBadge');
  const quickMBtns = document.querySelectorAll('.quick-m-btn');
  const clearMonthsBtn = document.getElementById('clearMonthsBtn');
  const selectAllMonthsBtn = document.getElementById('selectAllMonthsBtn');

  const tuitionStructureSelect = document.getElementById('tuitionStructureSelect');
  const tuitionRateDisplay = document.getElementById('tuitionRateDisplay');
  const tuitionAmountInput = document.getElementById('tuitionAmountInput');
  const primaryFeeName = document.getElementById('primaryFeeName');

  // Van Elements
  const vanFeeSwitch = document.getElementById('vanFeeSwitch');
  const vanFeeBody = document.getElementById('vanFeeBody');
  const vanMonthlyRateInput = document.getElementById('vanMonthlyRateInput');
  const vanMonthsCountInput = document.getElementById('vanMonthsCountInput');
  const vanTotalText = document.getElementById('vanTotalText');
  const vanFeeTotalInput = document.getElementById('vanFeeTotalInput');
  const vanStatusBadge = document.getElementById('vanStatusBadge');

  // Previous Balance Elements
  const prevBalanceCheck = document.getElementById('prevBalanceCheck');
  const prevBalanceAmount = document.getElementById('prevBalanceAmount');
  const prevBalanceBody = document.getElementById('prevBalanceBody');

  // Other components
  const otherComponentsList = document.getElementById('otherComponentsList');
  const addCustomFeeBtn = document.getElementById('addCustomFeeBtn');
  const quickItemPills = document.querySelectorAll('.quick-item-pill');

  // Summary Elements
  const sumTuition = document.getElementById('sumTuition');
  const sumVan = document.getElementById('sumVan');
  const sumPrev = document.getElementById('sumPrev');
  const sumOther = document.getElementById('sumOther');
  const grandTotalLabel = document.getElementById('grandTotalLabel');
  const grandTotalInput = document.getElementById('grandTotalInput');
  const inWordsLabel = document.getElementById('inWordsLabel');

  // Helper: Number to Words
  function numToWords(n) {
    if (!n || n <= 0) return 'Zero Rupees Only';
    const a = ['','One ','Two ','Three ','Four ','Five ','Six ','Seven ','Eight ','Nine ','Ten ','Eleven ','Twelve ','Thirteen ','Fourteen ','Fifteen ','Sixteen ','Seventeen ','Eighteen ','Nineteen '];
    const b = ['', '', 'Twenty','Thirty','Forty','Fifty','Sixty','Seventy','Eighty','Ninety'];
    function inWords(num) {
      if ((num = num.toString()).length > 9) return 'overflow';
      const n = ('000000000' + num).substr(-9).match(/^(\d{2})(\d{2})(\d{2})(\d{1})(\d{2})$/);
      if (!n) return '';
      let str = '';
      str += (n[1] != 0) ? (a[Number(n[1])] || b[n[1][0]] + ' ' + a[n[1][1]]) + 'Crore ' : '';
      str += (n[2] != 0) ? (a[Number(n[2])] || b[n[2][0]] + ' ' + a[n[2][1]]) + 'Lakh ' : '';
      str += (n[3] != 0) ? (a[Number(n[3])] || b[n[3][0]] + ' ' + a[n[3][1]]) + 'Thousand ' : '';
      str += (n[4] != 0) ? (a[Number(n[4])] || b[n[4][0]] + ' ' + a[n[4][1]]) + 'Hundred ' : '';
      str += (n[5] != 0) ? ((str != '') ? 'and ' : '') + (a[Number(n[5])] || b[n[5][0]] + ' ' + a[n[5][1]]) : '';
      return str.trim();
    }
    return inWords(Math.floor(n)) + ' Rupees Only';
  }

  function getSelectedMonths() {
    const list = [];
    document.querySelectorAll('.month-checkbox:checked').forEach(cb => {
      list.push(cb.value);
    });
    return list;
  }

  // 1. Month Selector Handler
  function updateMonths() {
    const months = getSelectedMonths();
    const str = months.join(', ');
    if (monthsPaidInput) monthsPaidInput.value = str;
    if (selectedMonthsLabel) selectedMonthsLabel.innerText = str || 'None selected';
    if (monthsBadge) {
      monthsBadge.innerText = `${months.length} Month${months.length === 1 ? '' : 's'}`;
      monthsBadge.className = months.length > 0 ? 'badge bg-primary' : 'badge bg-secondary';
    }

    // Auto-update tuition total based on count of months
    if (tuitionStructureSelect) {
      const opt = tuitionStructureSelect.options[tuitionStructureSelect.selectedIndex];
      const rate = parseFloat(opt ? opt.getAttribute('data-amount') : 0) || 0;
      if (tuitionRateDisplay) tuitionRateDisplay.innerText = rate.toLocaleString('en-IN');
      if (primaryFeeName) primaryFeeName.value = (opt ? opt.getAttribute('data-name') : 'Tuition Fee') || 'Tuition Fee';

      if (tuitionAmountInput && rate > 0) {
        tuitionAmountInput.value = (rate * months.length).toFixed(2);
      }
    }

    // Auto-sync van months count with selected months count (if user hasn't manually set something else)
    if (vanMonthsCountInput) {
      const targetCount = months.length > 0 ? months.length : 1;
      vanMonthsCountInput.value = targetCount;
    }
    updateVanFee();
    recalculateTotals();
  }

  monthCheckboxes.forEach(cb => {
    cb.addEventListener('change', updateMonths);
  });

  quickMBtns.forEach(btn => {
    btn.addEventListener('click', function () {
      const count = parseInt(this.getAttribute('data-count'), 10) || 1;
      monthCheckboxes.forEach(cb => { cb.checked = false; });
      quickMBtns.forEach(b => b.classList.remove('active'));
      this.classList.add('active');

      let checked = 0;
      for (const cb of monthCheckboxes) {
        const lbl = document.querySelector(`label[for="${cb.id}"]`);
        const isPaid = lbl && lbl.querySelector('.fa-check');
        if (!isPaid && checked < count) {
          cb.checked = true;
          checked++;
        }
      }
      if (checked < count) {
        for (const cb of monthCheckboxes) {
          if (!cb.checked && checked < count) {
            cb.checked = true;
            checked++;
          }
        }
      }
      updateMonths();
    });
  });

  if (clearMonthsBtn) {
    clearMonthsBtn.addEventListener('click', function () {
      monthCheckboxes.forEach(cb => { cb.checked = false; });
      quickMBtns.forEach(b => b.classList.remove('active'));
      updateMonths();
    });
  }

  if (selectAllMonthsBtn) {
    selectAllMonthsBtn.addEventListener('click', function () {
      monthCheckboxes.forEach(cb => { cb.checked = true; });
      updateMonths();
    });
  }

  if (tuitionStructureSelect) {
    tuitionStructureSelect.addEventListener('change', updateMonths);
  }
  if (tuitionAmountInput) {
    tuitionAmountInput.addEventListener('input', recalculateTotals);
  }

  // 2. Van / Transport Fee Handler
  function updateVanFee() {
    if (!vanFeeSwitch) return;
    const isEnabled = vanFeeSwitch.checked;
    if (vanFeeBody) vanFeeBody.style.display = isEnabled ? 'block' : 'none';
    if (vanStatusBadge) {
      vanStatusBadge.className = isEnabled ? 'badge bg-success' : 'badge bg-secondary';
      vanStatusBadge.innerText = isEnabled ? 'Van Active' : 'No Van';
    }

    let vanTotal = 0;
    if (isEnabled) {
      const rate = parseFloat(vanMonthlyRateInput ? vanMonthlyRateInput.value : 0) || 0;
      const count = parseInt(vanMonthsCountInput ? vanMonthsCountInput.value : 1, 10) || 1;
      vanTotal = rate * count;
    }

    if (vanTotalText) vanTotalText.innerText = vanTotal.toLocaleString('en-IN', { minimumFractionDigits: 2 });
    if (vanFeeTotalInput) vanFeeTotalInput.value = vanTotal.toFixed(2);
    recalculateTotals();
  }

  if (vanFeeSwitch) {
    vanFeeSwitch.addEventListener('change', updateVanFee);
  }
  if (vanMonthlyRateInput) {
    vanMonthlyRateInput.addEventListener('input', updateVanFee);
  }
  if (vanMonthsCountInput) {
    vanMonthsCountInput.addEventListener('input', updateVanFee);
  }

  // 3. Previous Balance Handler
  if (prevBalanceCheck) {
    prevBalanceCheck.addEventListener('change', function () {
      if (prevBalanceBody) prevBalanceBody.style.display = this.checked ? 'block' : 'none';
      if (!this.checked && prevBalanceAmount) {
        prevBalanceAmount.setAttribute('data-prev-val', prevBalanceAmount.value);
        prevBalanceAmount.value = '0.00';
      } else if (this.checked && prevBalanceAmount) {
        const prev = prevBalanceAmount.getAttribute('data-prev-val');
        if (prev) prevBalanceAmount.value = prev;
      }
      recalculateTotals();
    });
  }
  if (prevBalanceAmount) {
    prevBalanceAmount.addEventListener('input', recalculateTotals);
  }

  // 4. Other Components
  function addOtherFeeRow(name = '', amount = 0) {
    const div = document.createElement('div');
    div.className = 'row g-2 align-items-center other-row';
    div.innerHTML = `
      <div class="col-7">
        <input type="text" name="component_name[]" class="form-control form-control-sm" value="${name}" placeholder="Component Name" required>
      </div>
      <div class="col-4">
        <div class="input-group input-group-sm">
          <span class="input-group-text">₹</span>
          <input type="number" step="0.01" name="component_amount[]" class="form-control form-control-sm other-amt fw-semibold" value="${amount > 0 ? amount.toFixed(2) : ''}" placeholder="0.00" required>
        </div>
      </div>
      <div class="col-1 text-end">
        <button type="button" class="btn btn-sm btn-outline-danger p-1 remove-other-btn"><i class="fa-solid fa-xmark"></i></button>
      </div>
    `;

    otherComponentsList.appendChild(div);

    div.querySelector('.remove-other-btn').addEventListener('click', function () {
      div.remove();
      recalculateTotals();
    });

    div.querySelector('.other-amt').addEventListener('input', recalculateTotals);
    
    const amtInp = div.querySelector('.other-amt');
    if (name) amtInp.focus();
    recalculateTotals();
  }

  if (addCustomFeeBtn) {
    addCustomFeeBtn.addEventListener('click', () => addOtherFeeRow('', 0));
  }

  quickItemPills.forEach(pill => {
    pill.addEventListener('click', function () {
      const name = this.getAttribute('data-name');
      const amt = parseFloat(this.getAttribute('data-amt')) || 0;
      addOtherFeeRow(name, amt);
    });
  });

  // 5. Grand Total Calculation
  function recalculateTotals() {
    const tAmt = parseFloat(tuitionAmountInput ? tuitionAmountInput.value : 0) || 0;
    const vAmt = parseFloat(vanFeeTotalInput ? vanFeeTotalInput.value : 0) || 0;
    
    let pAmt = 0;
    if (prevBalanceCheck && prevBalanceCheck.checked && prevBalanceAmount) {
      pAmt = parseFloat(prevBalanceAmount.value) || 0;
    }

    let oAmt = 0;
    document.querySelectorAll('.other-amt').forEach(inp => {
      oAmt += parseFloat(inp.value) || 0;
    });

    const total = tAmt + vAmt + pAmt + oAmt;

    if (sumTuition) sumTuition.innerText = `₹${tAmt.toLocaleString('en-IN', { minimumFractionDigits: 2 })}`;
    if (sumVan) sumVan.innerText = `₹${vAmt.toLocaleString('en-IN', { minimumFractionDigits: 2 })}`;
    if (sumPrev) sumPrev.innerText = `₹${pAmt.toLocaleString('en-IN', { minimumFractionDigits: 2 })}`;
    if (sumOther) sumOther.innerText = `₹${oAmt.toLocaleString('en-IN', { minimumFractionDigits: 2 })}`;

    if (grandTotalLabel) grandTotalLabel.innerText = `₹${total.toLocaleString('en-IN', { minimumFractionDigits: 2 })}`;
    if (grandTotalInput) grandTotalInput.value = total.toFixed(2);
    if (inWordsLabel) inWordsLabel.innerText = numToWords(total);
  }

  // Initial Calculation
  updateMonths();
});
</script>
