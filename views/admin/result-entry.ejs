<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <div>
    <h5 class="fw-bold mb-1"><i class="fa-solid fa-pen text-primary me-2"></i>Enter Marks: <%- exam.name %></h5>
    <span class="text-muted small">Passing Criteria: <strong>Minimum 33%</strong> in each subject &bull; Session 2026-27</span>
  </div>
  <div class="d-flex gap-2">
    <a href="/admin/results/class-marks?class_id=<%- exam.class_id %>&exam_id=<%- exam.id %>" class="btn btn-outline-primary btn-sm">
      <i class="fa-solid fa-table-list me-1"></i>View Class Broadsheet & Positions
    </a>
    <a href="/admin/results" class="btn btn-outline-secondary btn-sm">Back</a>
  </div>
</div>

<div class="alert alert-info py-2 d-flex justify-content-between align-items-center flex-wrap gap-2">
  <div>
    <strong>Class:</strong> <%- exam.class_name %> &nbsp;|&nbsp;
    <strong>Exam:</strong> <%- exam.name %> &nbsp;|&nbsp;
    <strong>Date:</strong> <%- exam.exam_date ? new Date(exam.exam_date).toLocaleDateString('en-IN') : 'N/A' %>
  </div>
  <span class="badge bg-warning text-dark"><i class="fa-solid fa-circle-exclamation me-1"></i>Min Passing: 33% of Max Marks</span>
</div>

<form action="/admin/results/save/<%- exam.id %>" method="POST">
  <div class="card shadow-sm border-0">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-bordered align-middle mb-0 text-center" style="font-size: 0.88rem;">
          <thead class="table-dark">
            <tr>
              <th style="min-width:160px" class="text-start">Student Name</th>
              <% subjects.forEach(sub => { %>
              <th style="min-width:130px">
                <div><%- sub.name %></div>
                <small class="text-warning fw-normal" style="font-size: 0.72rem;">Max: <%- sub.max_marks %> &bull; Pass: <%- Math.ceil(sub.max_marks * 0.33) %></small>
              </th>
              <% }) %>
              <th style="width: 130px;">Report Cards</th>
            </tr>
          </thead>
          <tbody>
            <% students.forEach(s => { %>
            <tr>
              <td class="text-start">
                <div class="fw-semibold"><%- s.name %></div>
                <small class="text-muted">Adm: <%- s.admission_no %> | Roll: <%- s.roll_number || '-' %></small>
              </td>
              <% subjects.forEach(sub => { %>
              <% 
                const existingResult = resultsMap[`${s.id}_${sub.id}`]; 
                const marksVal = existingResult ? existingResult.marks_obtained : '';
                const isFail = marksVal !== '' && (parseFloat(marksVal) / sub.max_marks) < 0.33;
              %>
              <td>
                <input type="number" name="marks[<%- s.id %>_<%- sub.id %>]"
                  class="form-control form-control-sm text-center marks-input <%- isFail ? 'border-danger text-danger bg-danger-subtle' : '' %>"
                  value="<%- marksVal %>"
                  min="0" max="<%- sub.max_marks %>" step="0.5"
                  data-max="<%- sub.max_marks %>"
                  placeholder="0-<%- sub.max_marks %>"
                  oninput="validateMarksInput(this)">
                <div class="mt-1 grade-tag">
                  <% if(existingResult) { %>
                    <small class="badge <%- isFail ? 'bg-danger' : 'bg-success' %>" style="font-size: 0.7rem;">
                      <%- isFail ? 'Fail (<33%)' : existingResult.grade %>
                    </small>
                  <% } %>
                </div>
              </td>
              <% }) %>
              <td>
                <div class="btn-group btn-group-sm">
                  <a href="/admin/results/report-card/<%- s.id %>/<%- exam.id %>" target="_blank" class="btn btn-sm btn-outline-primary" title="Print Current Exam Report Card">
                    <i class="fa-solid fa-file-pdf"></i>
                  </a>
                  <a href="/admin/results/report-card/<%- s.id %>/<%- exam.id %>?consolidated=1" target="_blank" class="btn btn-sm btn-outline-success" title="Print Annual Consolidated Report Card (1st, 2nd, 3rd Terms)">
                    <i class="fa-solid fa-layer-group"></i>
                  </a>
                </div>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
    <div class="card-footer d-flex justify-content-between align-items-center">
      <span class="text-muted small"><i class="fa-solid fa-info-circle me-1"></i>Students scoring &lt; 33% in any subject are automatically flagged as Fail.</span>
      <button type="submit" class="btn btn-primary px-4 fw-semibold"><i class="fa-solid fa-save me-1"></i>Save All Results</button>
    </div>
  </div>
</form>

<script>
function validateMarksInput(input) {
  const max = parseFloat(input.getAttribute('data-max')) || 100;
  const val = parseFloat(input.value);
  const tagDiv = input.parentElement.querySelector('.grade-tag');
  
  if (isNaN(val) || input.value === '') {
    input.classList.remove('border-danger', 'text-danger', 'bg-danger-subtle', 'border-success');
    if (tagDiv) tagDiv.innerHTML = '';
    return;
  }
  
  const pct = (val / max) * 100;
  if (pct < 33) {
    input.classList.add('border-danger', 'text-danger', 'bg-danger-subtle');
    input.classList.remove('border-success');
    if (tagDiv) tagDiv.innerHTML = '<small class="badge bg-danger" style="font-size: 0.7rem;">Fail (<33%)</small>';
  } else {
    input.classList.remove('border-danger', 'text-danger', 'bg-danger-subtle');
    input.classList.add('border-success');
    const gr = pct >= 90 ? 'A+' : pct >= 80 ? 'A' : pct >= 70 ? 'B' : pct >= 60 ? 'C' : pct >= 50 ? 'D' : 'E';
    if (tagDiv) tagDiv.innerHTML = '<small class="badge bg-success" style="font-size: 0.7rem;">Grade: ' + gr + '</small>';
  }
}
</script>
