<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <div>
    <h5 class="fw-bold mb-1"><i class="fa-solid fa-gear text-primary me-2"></i>School & System Settings</h5>
    <span class="text-muted small">Manage school branding, examination rules, fee preferences, and print configuration</span>
  </div>
  <div class="d-flex gap-2">
    <a href="/admin/backup/download" class="btn btn-outline-success btn-sm shadow-sm">
      <i class="fa-solid fa-database me-1"></i>Download Database Backup (.sql)
    </a>
    <a href="/admin" class="btn btn-outline-secondary btn-sm">
      <i class="fa-solid fa-arrow-left me-1"></i>Back to Dashboard
    </a>
  </div>
</div>

<form action="/admin/settings/save" method="POST">
  <div class="row g-4">
    <!-- Settings Navigation Tabs -->
    <div class="col-lg-3">
      <div class="card shadow-sm border-0 sticky-top" style="top: 20px;">
        <div class="card-body p-2">
          <div class="nav flex-column nav-pills" id="settings-tabs" role="tablist">
            <button class="nav-link active text-start py-2.5 px-3 mb-1" id="tab-general-btn" data-bs-toggle="pill" data-bs-target="#tab-general" type="button" role="tab">
              <i class="fa-solid fa-school me-2 text-primary"></i>School Identity
            </button>
            <button class="nav-link text-start py-2.5 px-3 mb-1" id="tab-academics-btn" data-bs-toggle="pill" data-bs-target="#tab-academics" type="button" role="tab">
              <i class="fa-solid fa-graduation-cap me-2 text-success"></i>Academic &amp; Exams
            </button>
            <button class="nav-link text-start py-2.5 px-3 mb-1" id="tab-fees-btn" data-bs-toggle="pill" data-bs-target="#tab-fees" type="button" role="tab">
              <i class="fa-solid fa-receipt me-2 text-warning"></i>Fee &amp; Receipts
            </button>
            <button class="nav-link text-start py-2.5 px-3 mb-1" id="tab-signatures-btn" data-bs-toggle="pill" data-bs-target="#tab-signatures" type="button" role="tab">
              <i class="fa-solid fa-file-signature me-2 text-info"></i>Report Cards &amp; Signs
            </button>
            <button class="nav-link text-start py-2.5 px-3 mb-1" id="tab-system-btn" data-bs-toggle="pill" data-bs-target="#tab-system" type="button" role="tab">
              <i class="fa-solid fa-server me-2 text-danger"></i>System &amp; Maintenance
            </button>
          </div>
        </div>
        <div class="card-footer bg-light p-3 border-0">
          <button type="submit" class="btn btn-primary w-100 fw-bold shadow-sm">
            <i class="fa-solid fa-floppy-disk me-1"></i>Save All Settings
          </button>
        </div>
      </div>
    </div>

    <!-- Settings Tab Panes -->
    <div class="col-lg-9">
      <div class="tab-content" id="settings-tab-content">

        <!-- TAB 1: SCHOOL IDENTITY -->
        <div class="tab-pane fade show active" id="tab-general" role="tabpanel">
          <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 border-bottom">
              <h6 class="mb-0 fw-bold text-primary"><i class="fa-solid fa-school me-2"></i>School Profile &amp; Contact Details</h6>
              <small class="text-muted">These details appear on all official PDF receipts, student report cards, broadsheets, and portal headers.</small>
            </div>
            <div class="card-body p-4">
              <div class="row g-3">
                <div class="col-md-12">
                  <label class="form-label fw-semibold">School Name *</label>
                  <input type="text" name="school_name" class="form-control" value="<%- settings.school_name %>" required>
                  <div class="form-text">Official registered name of the institution.</div>
                </div>

                <div class="col-md-6">
                  <label class="form-label fw-semibold">Tagline / Slogan</label>
                  <input type="text" name="school_tagline" class="form-control" value="<%- settings.school_tagline || '' %>" placeholder="e.g. Empowering Minds, Enriching Lives">
                </div>

                <div class="col-md-6">
                  <label class="form-label fw-semibold">Affiliation / Board Details</label>
                  <input type="text" name="school_affiliation" class="form-control" value="<%- settings.school_affiliation || '' %>" placeholder="e.g. Affiliated to CBSE / State Board">
                </div>

                <div class="col-md-12">
                  <label class="form-label fw-semibold">Full School Address *</label>
                  <textarea name="school_address" class="form-control" rows="2" required><%- settings.school_address %></textarea>
                </div>

                <div class="col-md-6">
                  <label class="form-label fw-semibold">Primary Contact Phone *</label>
                  <div class="input-group">
                    <span class="input-group-text"><i class="fa-solid fa-phone"></i></span>
                    <input type="text" name="school_phone" class="form-control" value="<%- settings.school_phone %>" required>
                  </div>
                </div>

                <div class="col-md-6">
                  <label class="form-label fw-semibold">Alternate Phone / WhatsApp</label>
                  <div class="input-group">
                    <span class="input-group-text"><i class="fa-brands fa-whatsapp"></i></span>
                    <input type="text" name="school_alt_phone" class="form-control" value="<%- settings.school_alt_phone || '' %>" placeholder="e.g. 9876543210">
                  </div>
                </div>

                <div class="col-md-6">
                  <label class="form-label fw-semibold">Official Email</label>
                  <div class="input-group">
                    <span class="input-group-text"><i class="fa-solid fa-envelope"></i></span>
                    <input type="email" name="school_email" class="form-control" value="<%- settings.school_email || '' %>">
                  </div>
                </div>

                <div class="col-md-6">
                  <label class="form-label fw-semibold">School Website URL</label>
                  <div class="input-group">
                    <span class="input-group-text"><i class="fa-solid fa-globe"></i></span>
                    <input type="text" name="school_website" class="form-control" value="<%- settings.school_website || '' %>">
                  </div>
                </div>

                <div class="col-md-6">
                  <label class="form-label fw-semibold">Principal / Director Name</label>
                  <input type="text" name="principal_name" class="form-control" value="<%- settings.principal_name || 'Principal' %>">
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- TAB 2: ACADEMIC & EXAMS -->
        <div class="tab-pane fade" id="tab-academics" role="tabpanel">
          <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 border-bottom">
              <h6 class="mb-0 fw-bold text-success"><i class="fa-solid fa-graduation-cap me-2"></i>Academic Session &amp; Examination Rules</h6>
              <small class="text-muted">Configure active academic year and grade passing criteria across report cards.</small>
            </div>
            <div class="card-body p-4">
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label fw-semibold">Current Academic Year / Session *</label>
                  <input type="text" name="academic_year" class="form-control" value="<%- settings.academic_year || '2026-27' %>" placeholder="2026-27" required>
                  <div class="form-text">Active academic session across student enrollments and fee billing.</div>
                </div>

                <div class="col-md-6">
                  <label class="form-label fw-semibold">Minimum Passing Percentage (%) *</label>
                  <div class="input-group">
                    <input type="number" name="passing_percentage" class="form-control" value="<%- settings.passing_percentage || 33 %>" min="1" max="100" required>
                    <span class="input-group-text">%</span>
                  </div>
                  <div class="form-text">Students scoring below this threshold in any subject are flagged as Fail.</div>
                </div>

                <div class="col-md-6">
                  <label class="form-label fw-semibold">Default Subject Max Marks</label>
                  <input type="number" name="default_max_marks" class="form-control" value="<%- settings.default_max_marks || 100 %>" min="10" max="500">
                </div>

                <div class="col-md-6">
                  <label class="form-label fw-semibold">Standard Term Structure</label>
                  <input type="text" class="form-control" value="1st Term, 2nd Term, 3rd Term/Annual, Pre-Board" readonly disabled>
                  <div class="form-text">Standard 3-term system with Pre-Board for Class 10 &amp; 12.</div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- TAB 3: FEE & RECEIPTS -->
        <div class="tab-pane fade" id="tab-fees" role="tabpanel">
          <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 border-bottom">
              <h6 class="mb-0 fw-bold text-warning"><i class="fa-solid fa-receipt me-2"></i>Fee Collection &amp; Receipt Configuration</h6>
              <small class="text-muted">Configure currency symbols, payment due day, and receipt disclaimers.</small>
            </div>
            <div class="card-body p-4">
              <div class="row g-3">
                <div class="col-md-4">
                  <label class="form-label fw-semibold">Currency Symbol / Prefix</label>
                  <input type="text" name="currency_symbol" class="form-control" value="<%- settings.currency_symbol || 'Rs.' %>">
                  <div class="form-text">e.g. Rs. or ₹</div>
                </div>

                <div class="col-md-4">
                  <label class="form-label fw-semibold">Monthly Fee Due Day</label>
                  <input type="number" name="fee_due_day" class="form-control" value="<%- settings.fee_due_day || 10 %>" min="1" max="28">
                  <div class="form-text">Day of month (e.g. 10th of every month).</div>
                </div>

                <div class="col-md-4">
                  <label class="form-label fw-semibold">Default Monthly Tuition Fee</label>
                  <input type="number" name="default_monthly_fee" class="form-control" value="<%- settings.default_monthly_fee || 500 %>">
                  <div class="form-text">Fallback rate if class fee structure is unconfigured.</div>
                </div>

                <div class="col-md-12">
                  <label class="form-label fw-semibold">Fee Receipt Header Title</label>
                  <input type="text" name="receipt_title" class="form-control" value="<%- settings.receipt_title || 'FEE RECEIPT / PAYMENT VOUCHER' %>">
                </div>

                <div class="col-md-12">
                  <label class="form-label fw-semibold">Receipt Terms &amp; Footer Notes</label>
                  <textarea name="receipt_footer_note" class="form-control" rows="2"><%- settings.receipt_footer_note || 'Fees once deposited will not be refunded. Please preserve this receipt for future reference.' %></textarea>
                  <div class="form-text">Printed at the bottom of official PDF fee receipts.</div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- TAB 4: REPORT CARDS & SIGNATURES -->
        <div class="tab-pane fade" id="tab-signatures" role="tabpanel">
          <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 border-bottom">
              <h6 class="mb-0 fw-bold text-info"><i class="fa-solid fa-file-signature me-2"></i>Report Cards &amp; Signature Designations</h6>
              <small class="text-muted">Customize titles and signatory titles printed on student progress report cards.</small>
            </div>
            <div class="card-body p-4">
              <div class="row g-3">
                <div class="col-md-12">
                  <label class="form-label fw-semibold">Report Card Title</label>
                  <input type="text" name="report_card_title" class="form-control" value="<%- settings.report_card_title || 'STUDENT PROGRESS REPORT CARD' %>">
                </div>

                <div class="col-md-4">
                  <label class="form-label fw-semibold">Signatory 1 (Left)</label>
                  <input type="text" name="sig_teacher_label" class="form-control" value="<%- settings.sig_teacher_label || 'Class Teacher\'s Signature' %>">
                </div>

                <div class="col-md-4">
                  <label class="form-label fw-semibold">Signatory 2 (Center)</label>
                  <input type="text" name="sig_incharge_label" class="form-control" value="<%- settings.sig_incharge_label || 'Exam Incharge Signature' %>">
                </div>

                <div class="col-md-4">
                  <label class="form-label fw-semibold">Signatory 3 (Right)</label>
                  <input type="text" name="sig_principal_label" class="form-control" value="<%- settings.sig_principal_label || 'Principal\'s Signature' %>">
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- TAB 5: SYSTEM & MAINTENANCE -->
        <div class="tab-pane fade" id="tab-system" role="tabpanel">
          <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 border-bottom">
              <h6 class="mb-0 fw-bold text-danger"><i class="fa-solid fa-server me-2"></i>Database Backup &amp; Maintenance Tools</h6>
              <small class="text-muted">Critical admin administrative and security actions.</small>
            </div>
            <div class="card-body p-4">
              <div class="row g-4">
                <div class="col-md-6">
                  <div class="p-3 border rounded bg-light h-100">
                    <h6 class="fw-bold"><i class="fa-solid fa-database text-success me-2"></i>Database Full Backup</h6>
                    <p class="text-muted small">Generates a standard, downloadable SQL dump of all tables, schema, students, payments, and marks.</p>
                    <a href="/admin/backup/download" class="btn btn-success btn-sm fw-bold">
                      <i class="fa-solid fa-cloud-arrow-down me-1"></i>Download Full Backup (.sql)
                    </a>
                  </div>
                </div>

                <div class="col-md-6">
                  <div class="p-3 border rounded bg-light h-100">
                    <h6 class="fw-bold"><i class="fa-solid fa-key text-primary me-2"></i>Security &amp; Password</h6>
                    <p class="text-muted small">Update your administrator account password or credentials.</p>
                    <a href="/admin/change-password" class="btn btn-outline-primary btn-sm">
                      <i class="fa-solid fa-lock me-1"></i>Change Admin Password
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- Save Button Bar -->
      <div class="d-flex justify-content-end gap-2 mt-3">
        <a href="/admin" class="btn btn-outline-secondary px-4">Cancel</a>
        <button type="submit" class="btn btn-primary px-4 fw-bold">
          <i class="fa-solid fa-floppy-disk me-1"></i>Save All Settings
        </button>
      </div>
    </div>
  </div>
</form>
