<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h5 class="fw-bold mb-1"><i class="fa-solid fa-user-pen text-primary me-2"></i>Update Contact Information</h5>
    <small class="text-muted">Submit official requests to change mobile number, emergency contact, or address (Requires Admin Approval)</small>
  </div>
  <a href="/student/profile" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-arrow-left me-1"></i>Back to Profile</a>
</div>

<div class="row g-4">
  <!-- Request Form -->
  <div class="col-lg-5">
    <div class="card shadow-sm border-0">
      <div class="card-header bg-primary text-white py-3">
        <h6 class="mb-0 fw-bold"><i class="fa-solid fa-file-pen me-2"></i>Submit Change Request</h6>
      </div>
      <div class="card-body p-4">
        <!-- Current info preview -->
        <div class="p-3 bg-light rounded mb-3 border small">
          <div class="fw-bold text-dark mb-1">Current Active Records:</div>
          <div><strong>Mobile:</strong> <%- student.phone || 'None' %></div>
          <div><strong>Emergency:</strong> <%- student.emergency_contact || 'None' %></div>
          <div><strong>Address:</strong> <%- student.address || 'None' %></div>
        </div>

        <form action="/student/contact-update" method="POST">
          <div class="mb-3">
            <label class="form-label fw-semibold">New Mobile Number</label>
            <input type="text" name="new_phone" class="form-control" placeholder="10-digit mobile number" value="<%- student.phone || '' %>">
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">New Emergency Contact</label>
            <input type="text" name="new_emergency_contact" class="form-control" placeholder="Alternate/Emergency phone" value="<%- student.emergency_contact || '' %>">
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">New Residential Address</label>
            <textarea name="new_address" rows="3" class="form-control" placeholder="Full residential address..."><%- student.address || '' %></textarea>
          </div>
          <div class="mb-4">
            <label class="form-label fw-semibold">Reason for Change / Note</label>
            <input type="text" name="message" class="form-control" placeholder="e.g. Relocated to new address, changed SIM card">
          </div>
          <button type="submit" class="btn btn-primary w-100 py-2">
            <i class="fa-solid fa-paper-plane me-2"></i>Submit for Administrative Approval
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Request Status History -->
  <div class="col-lg-7">
    <div class="card shadow-sm border-0">
      <div class="card-header bg-white py-3 border-bottom">
        <h6 class="mb-0 fw-bold text-dark"><i class="fa-solid fa-clock-rotate-left text-secondary me-2"></i>Request Approval Tracking</h6>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>Submitted Date</th>
                <th>Requested Changes</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% if(requests && requests.length > 0) { %>
                <% requests.forEach(r => { %>
                  <tr>
                    <td>
                      <small class="text-muted"><%- new Date(r.created_at).toLocaleDateString('en-IN') %></small>
                    </td>
                    <td>
                      <div class="small">
                        <% if(r.new_phone) { %><div><strong>Phone:</strong> <%- r.new_phone %></div><% } %>
                        <% if(r.new_emergency_contact) { %><div><strong>Emergency:</strong> <%- r.new_emergency_contact %></div><% } %>
                        <% if(r.new_address) { %><div><strong>Address:</strong> <%- r.new_address %></div><% } %>
                        <% if(r.message) { %><div class="text-muted fst-italic">Note: <%- r.message %></div><% } %>
                      </div>
                      <% if(r.admin_notes) { %>
                        <div class="small text-primary mt-1 border-top pt-1">
                          <i class="fa-solid fa-circle-info me-1"></i>Admin: <%- r.admin_notes %>
                        </div>
                      <% } %>
                    </td>
                    <td>
                      <% if(r.status === 'Approved') { %>
                        <span class="badge bg-success"><i class="fa-solid fa-check me-1"></i>Approved &amp; Updated</span>
                      <% } else if(r.status === 'Rejected') { %>
                        <span class="badge bg-danger"><i class="fa-solid fa-xmark me-1"></i>Rejected</span>
                      <% } else { %>
                        <span class="badge bg-warning text-dark"><i class="fa-solid fa-hourglass-half me-1"></i>Pending Review</span>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="3" class="text-center text-muted py-4">
                    No contact update requests submitted.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
