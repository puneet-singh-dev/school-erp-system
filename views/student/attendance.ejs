<div class="d-flex justify-content-between mb-4">
  <h5 class="fw-bold mb-0"><i class="fa-solid fa-clipboard-check text-primary me-2"></i>My Attendance</h5>
</div>

<div class="card shadow-sm mb-4">
  <div class="card-body">
    <form method="GET" class="row g-3 align-items-end">
      <div class="col-md-3"><label class="form-label">Month</label><select name="month" class="form-select"><% for(let m=1;m<=12;m++){%><option value="<%- m%>" <%- month==m?'selected':''%>><%- new Date(2000,m-1).toLocaleString('en',{month:'long'}) %></option><%}%></select></div>
      <div class="col-md-3"><label class="form-label">Year</label><input type="number" name="year" class="form-control" value="<%- year %>"></div>
      <div class="col-md-2"><button type="submit" class="btn btn-primary w-100">View</button></div>
    </form>
  </div>
</div>

<% if(summary) { %>
<div class="row g-3 mb-4">
  <div class="col-md-3"><div class="stat-card bg-success text-white"><div class="stat-icon"><i class="fa-solid fa-check"></i></div><div><div class="stat-num"><%- summary.present||0 %></div><div class="stat-label">Present</div></div></div></div>
  <div class="col-md-3"><div class="stat-card bg-danger text-white"><div class="stat-icon"><i class="fa-solid fa-times"></i></div><div><div class="stat-num"><%- summary.absent||0 %></div><div class="stat-label">Absent</div></div></div></div>
  <div class="col-md-3"><div class="stat-card bg-info text-white"><div class="stat-icon"><i class="fa-solid fa-calendar"></i></div><div><div class="stat-num"><%- summary.total||0 %></div><div class="stat-label">Total Days</div></div></div></div>
  <div class="col-md-3"><div class="stat-card bg-warning text-dark"><div class="stat-icon"><i class="fa-solid fa-percent"></i></div><div><div class="stat-num"><%- summary.total>0?((summary.present/summary.total)*100).toFixed(1):0 %>%</div><div class="stat-label">Percentage</div></div></div></div>
</div>
<% } %>

<div class="card shadow-sm">
  <div class="card-body p-0">
    <table class="table table-hover mb-0">
      <thead class="table-dark"><tr><th>Date</th><th>Day</th><th>Status</th></tr></thead>
      <tbody>
        <% attendance.forEach(a => { %>
        <% const d = new Date(a.date); %>
        <tr>
          <td><%- d.toLocaleDateString('en-IN') %></td>
          <td><%- d.toLocaleString('en',{weekday:'long'}) %></td>
          <td><span class="badge <%- a.status==='Present'?'bg-success':a.status==='Absent'?'bg-danger':a.status==='Late'?'bg-warning text-dark':'bg-secondary' %>"><%- a.status %></span></td>
        </tr>
        <% }) %>
        <% if(!attendance.length) { %><tr><td colspan="3" class="text-center py-4 text-muted">No attendance records found</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>
