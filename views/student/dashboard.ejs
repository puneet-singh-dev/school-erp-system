<% if(student) { %>
<!-- Stat Cards -->
<div class="row g-4 mb-4">
  <div class="col-md-3">
    <div class="stat-card bg-success text-white">
      <div class="stat-icon"><i class="fa-solid fa-clipboard-check"></i></div>
      <div><div class="stat-num"><%- attendance ? attendance.present : 0 %></div><div class="stat-label">Present This Month</div></div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="stat-card bg-danger text-white">
      <div class="stat-icon"><i class="fa-solid fa-circle-xmark"></i></div>
      <div><div class="stat-num"><%- attendance ? attendance.absent : 0 %></div><div class="stat-label">Absent This Month</div></div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="stat-card bg-warning text-dark">
      <div class="stat-icon"><i class="fa-solid fa-indian-rupee-sign"></i></div>
      <div><div class="stat-num">₹<%- fees ? parseFloat(fees.total_fees - fees.paid).toFixed(0) : '0' %></div><div class="stat-label">Fee Balance</div></div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="stat-card bg-primary text-white">
      <div class="stat-icon"><i class="fa-solid fa-trophy"></i></div>
      <div><div class="stat-num"><%- recentResults ? recentResults.length : 0 %></div><div class="stat-label">Exams Appeared</div></div>
    </div>
  </div>
</div>

<div class="row g-4">
  <!-- Profile Card -->
  <div class="col-md-4">
    <div class="card shadow-sm">
      <div class="card-header bg-primary text-white">
        <h6 class="mb-0 fw-bold"><i class="fa-solid fa-user me-2"></i>My Profile</h6>
      </div>
      <div class="card-body text-center">
        <div class="profile-avatar mb-3"><%- student.student_name ? student.student_name.charAt(0) : 'S' %></div>
        <h5 class="fw-bold"><%- student.student_name || user.name %></h5>
        <span class="badge bg-primary"><%- student.class_name %> - <%- student.section %></span>
        <div class="mt-3 text-start">
          <div class="info-row"><span>Admission No</span><strong><%- student.admission_no %></strong></div>
          <div class="info-row"><span>Roll Number</span><strong><%- student.roll_number || '-' %></strong></div>
          <div class="info-row"><span>Guardian</span><strong><%- student.guardian_name || '-' %></strong></div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-md-5">
    <!-- Recent Results -->
    <div class="card shadow-sm mb-3">
      <div class="card-header d-flex justify-content-between">
        <h6 class="mb-0 fw-bold"><i class="fa-solid fa-trophy me-1"></i>Recent Results</h6>
        <a href="/student/results" class="btn btn-sm btn-outline-primary">View All</a>
      </div>
      <div class="card-body p-0">
        <table class="table mb-0">
          <thead class="table-light"><tr><th>Exam</th><th>Obtained</th><th>%</th></tr></thead>
          <tbody>
            <% if(recentResults && recentResults.length) { %>
              <% recentResults.forEach(r => { %>
              <% const pct = r.max_marks > 0 ? ((r.obtained/r.max_marks)*100).toFixed(1) : 0; %>
              <tr><td><%- r.exam_name %></td><td><%- r.obtained || 0 %>/<%- r.max_marks || 0 %></td>
              <td><span class="badge <%- pct>=75?'bg-success':pct>=50?'bg-warning text-dark':'bg-danger'%>"><%- pct %>%</span></td></tr>
              <% }) %>
            <% } else { %><tr><td colspan="3" class="text-center text-muted py-3">No results yet</td></tr><% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Notices -->
  <div class="col-md-3">
    <div class="card shadow-sm">
      <div class="card-header"><h6 class="mb-0 fw-bold"><i class="fa-solid fa-bullhorn me-1"></i>Notices</h6></div>
      <div class="card-body">
        <% notices.forEach(n => { %>
        <div class="mb-2 pb-2 border-bottom">
          <div class="fw-semibold small"><%- n.title %></div>
          <small class="text-muted"><%- new Date(n.created_at).toLocaleDateString('en-IN') %></small>
        </div>
        <% }) %>
        <% if(!notices.length) { %><p class="text-center text-muted small">No notices</p><% } %>
      </div>
    </div>
  </div>
</div>
<% } else { %>
<div class="alert alert-warning"><i class="fa-solid fa-exclamation-triangle me-2"></i>Profile not set up yet. Contact admin.</div>
<% } %>
