<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h5 class="fw-bold mb-1"><i class="fa-solid fa-bullhorn text-warning me-2"></i>School Announcements &amp; Circulars</h5>
    <small class="text-muted">Important circulars, exam schedules, and holiday announcements from administration</small>
  </div>
  <a href="/student" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-arrow-left me-1"></i>Back</a>
</div>

<div class="row g-4">
  <div class="col-12">
    <% if(notices && notices.length > 0) { %>
      <div class="d-flex flex-column gap-3">
        <% notices.forEach(n => { %>
          <div class="card shadow-sm border-0 border-start border-4 border-warning">
            <div class="card-body p-4">
              <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning">
                  <i class="fa-solid fa-bell me-1"></i>Official Circular
                </span>
                <span class="text-muted small">
                  <i class="fa-regular fa-calendar me-1"></i><%- new Date(n.created_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                </span>
              </div>
              <h5 class="fw-bold text-dark mb-2"><%- n.title %></h5>
              <p class="text-muted mb-0" style="white-space: pre-line;"><%- n.content %></p>
              <% if(n.created_by_name) { %>
                <div class="text-end text-muted small mt-2">
                  <small>Issued by: <%- n.created_by_name %></small>
                </div>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="card shadow-sm border-0 text-center py-5">
        <div class="card-body">
          <i class="fa-solid fa-envelope-open text-muted fs-1 mb-3 opacity-50"></i>
          <h5 class="fw-bold text-muted">No announcements posted</h5>
          <p class="text-muted small">All latest school updates and notifications will appear here.</p>
        </div>
      </div>
    <% } %>
  </div>
</div>
