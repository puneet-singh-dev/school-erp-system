<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h5 class="fw-bold mb-1"><i class="fa-solid fa-envelope-open-text text-primary me-2"></i>Student Leave Application</h5>
    <small class="text-muted">Apply for leave of absence and track administrative approval status</small>
  </div>
  <a href="/student" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-arrow-left me-1"></i>Back</a>
</div>

<div class="row g-4">
  <!-- Leave Application Form -->
  <div class="col-lg-5">
    <div class="card shadow-sm border-0">
      <div class="card-header bg-primary text-white py-3">
        <h6 class="mb-0 fw-bold"><i class="fa-solid fa-pen-nib me-2"></i>New Leave Application</h6>
      </div>
      <div class="card-body p-4">
        <form action="/student/leaves" method="POST">
          <div class="mb-3">
            <label class="form-label fw-semibold">From Date *</label>
            <input type="date" name="from_date" class="form-control" required min="<%- new Date().toISOString().split('T')[0] %>">
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">To Date *</label>
            <input type="date" name="to_date" class="form-control" required min="<%- new Date().toISOString().split('T')[0] %>">
          </div>
          <div class="mb-4">
            <label class="form-label fw-semibold">Reason for Absence *</label>
            <textarea name="reason" rows="4" class="form-control" placeholder="Specify medical, family, or personal reasons..." required></textarea>
          </div>
          <button type="submit" class="btn btn-primary w-100 py-2">
            <i class="fa-solid fa-paper-plane me-2"></i>Submit Application
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Leave History Table -->
  <div class="col-lg-7">
    <div class="card shadow-sm border-0">
      <div class="card-header bg-white py-3 border-bottom">
        <h6 class="mb-0 fw-bold text-dark"><i class="fa-solid fa-clock-rotate-left text-secondary me-2"></i>Application History</h6>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>Applied Date</th>
                <th>Leave Period</th>
                <th>Reason</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% if(leaves && leaves.length > 0) { %>
                <% leaves.forEach(l => { %>
                  <tr>
                    <td>
                      <small class="text-muted"><%- new Date(l.created_at).toLocaleDateString('en-IN') %></small>
                    </td>
                    <td>
                      <div class="fw-semibold small">
                        <%- new Date(l.from_date).toLocaleDateString('en-IN') %> to <%- new Date(l.to_date).toLocaleDateString('en-IN') %>
                      </div>
                    </td>
                    <td>
                      <div class="small text-dark" style="max-width: 200px;"><%- l.reason %></div>
                      <% if(l.admin_remarks) { %>
                        <div class="small text-muted fst-italic mt-1"><i class="fa-solid fa-comment-dots me-1"></i><%- l.admin_remarks %></div>
                      <% } %>
                    </td>
                    <td>
                      <% if(l.status === 'Approved') { %>
                        <span class="badge bg-success"><i class="fa-solid fa-check me-1"></i>Approved</span>
                      <% } else if(l.status === 'Rejected') { %>
                        <span class="badge bg-danger"><i class="fa-solid fa-xmark me-1"></i>Rejected</span>
                      <% } else { %>
                        <span class="badge bg-warning text-dark"><i class="fa-solid fa-hourglass-half me-1"></i>Pending</span>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="4" class="text-center text-muted py-4">
                    No leave applications submitted yet.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
