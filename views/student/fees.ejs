<div class="d-flex justify-content-between mb-4">
  <h5 class="fw-bold mb-0"><i class="fa-solid fa-indian-rupee-sign text-success me-2"></i>My Fee Details</h5>
</div>

<!-- Summary Cards -->
<div class="row g-3 mb-4">
  <div class="col-md-4">
    <div class="stat-card bg-primary text-white">
      <div class="stat-icon"><i class="fa-solid fa-calendar-check"></i></div>
      <div>
        <div class="stat-num">₹<%- typeof feeData !== 'undefined' ? parseFloat(feeData.monthly_rate).toLocaleString('en-IN') : '0' %><small class="fs-6 fw-normal">/mo</small></div>
        <div class="stat-label">
          Monthly Rate (Tuition: ₹<%- typeof feeData !== 'undefined' ? feeData.monthly_tuition : '0' %><% if(typeof feeData !== 'undefined' && feeData.monthly_van > 0) { %> + Van: ₹<%- feeData.monthly_van %><% } %>)
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="stat-card bg-success text-white">
      <div class="stat-icon"><i class="fa-solid fa-receipt"></i></div>
      <div>
        <div class="stat-num">₹<%- summary ? parseFloat(summary.paid).toLocaleString('en-IN') : '0' %></div>
        <div class="stat-label">
          Total Paid to Date <% if(typeof feeData !== 'undefined' && feeData.paid_months && feeData.paid_months !== 'None') { %>(<%- feeData.paid_months %>)<% } %>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="stat-card <%- (typeof feeData !== 'undefined' && feeData.balance > 0) ? 'bg-danger text-white' : 'bg-success text-white' %>">
      <div class="stat-icon"><i class="fa-solid fa-circle-exclamation"></i></div>
      <div>
        <div class="stat-num">₹<%- typeof feeData !== 'undefined' ? parseFloat(feeData.balance).toLocaleString('en-IN') : (summary ? parseFloat(summary.balance).toLocaleString('en-IN') : '0') %></div>
        <div class="stat-label">
          <%- (typeof feeData !== 'undefined' && feeData.balance > 0) ? 'Total Balance Due (' + feeData.pending_months_count + ' Mo Pending)' : 'All Fees Cleared' %>
        </div>
      </div>
    </div>
  </div>
</div>

<% if (typeof feeData !== 'undefined' && feeData.pending_months_count > 0) { %>
<div class="alert alert-danger d-flex flex-wrap align-items-center justify-content-between mb-4 shadow-sm py-3">
  <div>
    <h6 class="fw-bold mb-1 text-danger"><i class="fa-solid fa-triangle-exclamation me-2"></i>Pending Fee Notice (Ongoing Month: <%- typeof feeReport !== 'undefined' ? feeReport.currentOngoingMonth : 'Current' %>)</h6>
    <div class="small text-dark">
      Unpaid Months: <strong class="text-danger"><%- feeData.pending_months_text %></strong> (<%- feeData.pending_months_count %> Month<%- feeData.pending_months_count > 1 ? 's' : '' %>) &bull;
      Monthly Dues: <strong>₹<%- parseFloat(feeData.session_due).toLocaleString('en-IN') %></strong>
      <% if (parseFloat(feeData.previous_balance || 0) > 0) { %>
        + Previous Balance: <strong>₹<%- parseFloat(feeData.previous_balance).toLocaleString('en-IN') %></strong>
      <% } %>
      = <strong>Total Due: ₹<%- parseFloat(feeData.balance).toLocaleString('en-IN') %></strong>
    </div>
  </div>
  <span class="badge bg-danger fs-6 px-3 py-2 mt-2 mt-md-0"><%- feeData.pending_months_count %> Month Pending</span>
</div>
<% } else { %>
<div class="alert alert-success d-flex align-items-center mb-4 shadow-sm py-3">
  <i class="fa-solid fa-circle-check text-success fs-4 me-3"></i>
  <div>
    <h6 class="fw-bold mb-0 text-success">Fee Cleared Up to Ongoing Month (<%- typeof feeReport !== 'undefined' ? feeReport.currentOngoingMonth : 'Current' %>)</h6>
    <small class="text-muted">You have no pending dues for the ongoing academic session. Thank you!</small>
  </div>
</div>
<% } %>

<% if (student && parseFloat(student.previous_balance || 0) > 0) { %>
<div class="alert alert-warning d-flex align-items-center justify-content-between mb-4 shadow-sm">
  <div>
    <i class="fa-solid fa-clock-rotate-left me-2 text-warning fs-5"></i>
    <strong>Previous Class Fee Balance:</strong>
    <span class="fs-6 fw-bold text-danger ms-1">₹<%- parseFloat(student.previous_balance).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></span>
    <% if(student.previous_balance_remarks) { %>
      <span class="text-muted ms-2 fst-italic">(<%- student.previous_balance_remarks %>)</span>
    <% } %>
  </div>
  <span class="badge bg-danger">Pending</span>
</div>
<% } %>

<% if (student && student.uses_transport) { %>
<div class="alert alert-success d-flex align-items-center justify-content-between mb-4 shadow-sm">
  <div>
    <i class="fa-solid fa-van-shuttle me-2 text-success fs-5"></i>
    <strong>School Transport / Van Facility:</strong>
    <span class="fs-6 fw-bold text-success ms-1">₹<%- parseFloat(student.transport_fee || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>/month</span>
    <% if (student.transport_route) { %>
      <span class="text-muted ms-2"><i class="fa-solid fa-route me-1"></i>Route: <strong><%- student.transport_route %></strong></span>
    <% } %>
  </div>
  <span class="badge bg-success"><i class="fa-solid fa-circle-check me-1"></i>Van Subscribed</span>
</div>
<% } %>

<div class="row g-4">
  <!-- Fee Structure -->
  <div class="col-md-5">
    <div class="card shadow-sm">
      <div class="card-header"><h6 class="mb-0 fw-bold">Fee Structure</h6></div>
      <div class="card-body p-0">
        <table class="table mb-0">
          <thead class="table-light"><tr><th>Fee Type</th><th>Amount</th><th>Due Date</th></tr></thead>
          <tbody>
            <% feeStructures.forEach(fs => { %>
            <tr>
              <td><%- fs.fee_type %></td>
              <td>₹<%- parseFloat(fs.amount).toLocaleString('en-IN') %></td>
              <td><%- fs.due_date ? new Date(fs.due_date).toLocaleDateString('en-IN') : '-' %></td>
            </tr>
            <% }) %>
            <% if(!feeStructures.length) { %><tr><td colspan="3" class="text-center text-muted py-3">No fee structure</td></tr><% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Payment History -->
  <div class="col-md-7">
    <div class="card shadow-sm">
      <div class="card-header"><h6 class="mb-0 fw-bold">Payment History</h6></div>
      <div class="card-body p-0">
        <table class="table mb-0">
          <thead class="table-light"><tr><th>Date</th><th>Fee Type</th><th>Amount</th><th>Mode</th><th>Receipt</th></tr></thead>
          <tbody>
            <% payments.forEach(p => { %>
            <tr>
              <td><%- new Date(p.payment_date).toLocaleDateString('en-IN') %></td>
              <td><%- p.fee_type %></td>
              <td><strong>₹<%- parseFloat(p.amount_paid).toLocaleString('en-IN') %></strong></td>
              <td><span class="badge bg-secondary"><%- p.payment_mode %></span></td>
              <td><a href="/student/fees/receipt/<%- p.id %>" target="_blank" class="btn btn-sm btn-outline-primary" title="Print Fee Receipt"><i class="fa-solid fa-print me-1"></i>Receipt</a></td>
            </tr>
            <% }) %>
            <% if(!payments.length) { %><tr><td colspan="5" class="text-center text-muted py-3">No payments yet</td></tr><% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
