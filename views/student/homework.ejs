<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h5 class="fw-bold mb-1"><i class="fa-solid fa-book-open text-primary me-2"></i>Homework &amp; Assignments</h5>
    <small class="text-muted">Daily assignments and homework for Class <%- student.class_name %> (<%- student.section %>)</small>
  </div>
  <a href="/student" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-arrow-left me-1"></i>Back</a>
</div>

<div class="row g-4">
  <div class="col-12">
    <% if(homeworkList && homeworkList.length > 0) { %>
      <div class="row g-3">
        <% homeworkList.forEach(hw => { %>
          <% 
            const isDueSoon = new Date(hw.due_date) >= new Date() && (new Date(hw.due_date) - new Date()) / (1000 * 60 * 60 * 24) <= 2;
            const isExpired = new Date(hw.due_date) < new Date();
          %>
          <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0 border-top border-4 <%- isExpired ? 'border-secondary' : (isDueSoon ? 'border-warning' : 'border-primary') %>">
              <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex justify-content-between align-items-start mb-2">
                  <span class="badge bg-primary-subtle text-primary border border-primary"><%- hw.subject_name || 'General' %></span>
                  <% if(isExpired) { %>
                    <span class="badge bg-secondary">Submission Closed</span>
                  <% } else if(isDueSoon) { %>
                    <span class="badge bg-warning text-dark"><i class="fa-solid fa-clock me-1"></i>Due Soon</span>
                  <% } else { %>
                    <span class="badge bg-success">Active</span>
                  <% } %>
                </div>

                <h6 class="fw-bold text-dark mb-2"><%- hw.title %></h6>
                <p class="text-muted small mb-3 flex-grow-1" style="white-space: pre-line;"><%- hw.description %></p>

                <div class="pt-3 border-top small text-muted">
                  <div class="d-flex justify-content-between mb-1">
                    <span><i class="fa-solid fa-calendar me-1"></i>Assigned:</span>
                    <strong><%- new Date(hw.assigned_date).toLocaleDateString('en-IN') %></strong>
                  </div>
                  <div class="d-flex justify-content-between">
                    <span><i class="fa-solid fa-calendar-check me-1 text-danger"></i>Due Date:</span>
                    <strong class="text-danger"><%- new Date(hw.due_date).toLocaleDateString('en-IN') %></strong>
                  </div>
                  <% if(hw.teacher_name) { %>
                    <div class="mt-2 text-end text-muted fst-italic">
                      <small>Teacher: <%- hw.teacher_name %></small>
                    </div>
                  <% } %>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="card shadow-sm border-0 text-center py-5">
        <div class="card-body">
          <i class="fa-solid fa-clipboard-check text-muted fs-1 mb-3 opacity-50"></i>
          <h5 class="fw-bold text-muted">No pending homework assignments!</h5>
          <p class="text-muted small">You are all caught up with your class assignments.</p>
        </div>
      </div>
    <% } %>
  </div>
</div>
