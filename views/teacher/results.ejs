<div class="mb-4"><h5 class="fw-bold mb-0"><i class="fa-solid fa-file-pen me-2"></i>Results Entry</h5></div>
<div class="card shadow-sm mb-4">
  <div class="card-body">
    <form method="GET" class="row g-3">
      <div class="col-md-4"><label class="form-label">Select Class</label>
        <select name="class_id" class="form-select" onchange="this.form.submit()">
          <option value="">My Classes</option>
          <% myClasses.forEach(c => { %><option value="<%- c.id %>" <%- class_id==c.id?'selected':'' %>><%- c.name %> - <%- c.section %></option><% }) %>
        </select>
      </div>
    </form>
  </div>
</div>
<% if(exams.length > 0) { %>
<div class="card shadow-sm">
  <div class="card-header"><h6 class="mb-0 fw-bold">Exams</h6></div>
  <div class="card-body p-0">
    <table class="table table-hover mb-0">
      <thead class="table-dark"><tr><th>Exam Name</th><th>Date</th><th>Action</th></tr></thead>
      <tbody>
        <% exams.forEach(e => { %>
        <tr>
          <td><strong><%- e.name %></strong></td>
          <td><%- e.exam_date ? new Date(e.exam_date).toLocaleDateString('en-IN') : '-' %></td>
          <td><a href="/teacher/results/enter/<%- e.id %>" class="btn btn-sm btn-primary"><i class="fa-solid fa-pen me-1"></i>Enter Marks</a></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<% } else if(class_id) { %>
<div class="alert alert-info">No exams for this class yet.</div>
<% } %>
