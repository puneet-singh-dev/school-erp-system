<!-- Teacher Dashboard -->
<div class="row g-4 mb-4">
  <div class="col-md-4">
    <div class="stat-card bg-primary text-white">
      <div class="stat-icon"><i class="fa-solid fa-door-open"></i></div>
      <div><div class="stat-num"><%- myClasses.length %></div><div class="stat-label">My Classes</div></div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="stat-card bg-info text-white">
      <div class="stat-icon"><i class="fa-solid fa-book"></i></div>
      <div><div class="stat-num"><%- mySubjects.length %></div><div class="stat-label">My Subjects</div></div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="stat-card bg-success text-white">
      <div class="stat-icon"><i class="fa-solid fa-clipboard-check"></i></div>
      <div><div class="stat-num"><%- todayAttendance %></div><div class="stat-label">Attendance Marked Today</div></div>
    </div>
  </div>
</div>

<div class="row g-4">
  <!-- My Classes & Subjects -->
  <div class="col-md-6">
    <div class="card shadow-sm">
      <div class="card-header"><h6 class="fw-bold mb-0"><i class="fa-solid fa-book me-2"></i>My Subjects</h6></div>
      <div class="card-body p-0">
        <table class="table mb-0">
          <thead class="table-light"><tr><th>Subject</th><th>Class</th></tr></thead>
          <tbody>
            <% mySubjects.forEach(s => { %>
            <tr><td><%- s.name %></td><td><%- s.class_name %> - <%- s.section %></td></tr>
            <% }) %>
            <% if(!mySubjects.length) { %><tr><td colspan="2" class="text-center text-muted py-3">No subjects assigned</td></tr><% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Quick Links -->
  <div class="col-md-3">
    <div class="card shadow-sm">
      <div class="card-header"><h6 class="fw-bold mb-0">Quick Actions</h6></div>
      <div class="card-body d-grid gap-2">
        <a href="/teacher/attendance" class="btn btn-primary"><i class="fa-solid fa-clipboard-check me-2"></i>Mark Attendance</a>
        <a href="/teacher/results" class="btn btn-success"><i class="fa-solid fa-file-pen me-2"></i>Enter Results</a>
        <a href="/teacher/students" class="btn btn-info text-white"><i class="fa-solid fa-users me-2"></i>View Students</a>
        <a href="/teacher/attendance/report" class="btn btn-outline-primary"><i class="fa-solid fa-chart-bar me-2"></i>Att. Report</a>
      </div>
    </div>
  </div>

  <!-- Notices -->
  <div class="col-md-3">
    <div class="card shadow-sm">
      <div class="card-header"><h6 class="fw-bold mb-0"><i class="fa-solid fa-bullhorn me-1"></i>Notices</h6></div>
      <div class="card-body">
        <% notices.forEach(n => { %>
        <div class="mb-2 pb-2 border-bottom">
          <div class="fw-semibold small"><%- n.title %></div>
          <small class="text-muted"><%- new Date(n.created_at).toLocaleDateString('en-IN') %></small>
        </div>
        <% }) %>
        <% if(!notices.length) { %><p class="text-muted text-center small">No notices</p><% } %>
      </div>
    </div>
  </div>
</div>
