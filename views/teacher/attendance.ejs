<div class="d-flex justify-content-between mb-4">
  <h5 class="fw-bold mb-0"><i class="fa-solid fa-clipboard-check text-primary me-2"></i>Mark Attendance</h5>
</div>

<div class="card shadow-sm mb-4">
  <div class="card-body">
    <form method="GET" class="row g-3 align-items-end">
      <div class="col-md-4">
        <label class="form-label">Select Class</label>
        <select name="class_id" class="form-select" onchange="this.form.submit()">
          <option value="">-- My Classes --</option>
          <% classes.forEach(c => { %><option value="<%- c.id %>" <%- class_id==c.id?'selected':'' %>><%- c.name %> - <%- c.section %></option><% }) %>
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label">Date</label>
        <input type="date" name="date" class="form-control" value="<%- selectedDate %>" max="<%- new Date().toISOString().split('T')[0] %>" onchange="this.form.submit()">
      </div>
    </form>
  </div>
</div>

<% if(students.length > 0) { %>
<form action="/teacher/attendance/save" method="POST">
  <input type="hidden" name="class_id" value="<%- class_id %>">
  <input type="hidden" name="date" value="<%- selectedDate %>">
  <div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between">
      <h6 class="mb-0 fw-bold">Students (<%- students.length %>)</h6>
      <div>
        <button type="button" class="btn btn-outline-success btn-sm" onclick="markAll('Present')">All Present</button>
        <button type="button" class="btn btn-outline-danger btn-sm" onclick="markAll('Absent')">All Absent</button>
      </div>
    </div>
    <div class="card-body p-0">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light"><tr><th>Roll No</th><th>Name</th><th>Attendance</th></tr></thead>
        <tbody>
          <% students.forEach(s => { %>
          <tr>
            <td><%- s.roll_number||'-' %></td>
            <td><strong><%- s.name %></strong></td>
            <td>
              <div class="att-buttons">
                <% ['Present','Absent','Late','Leave'].forEach(status => { %>
                <label class="att-label att-<%- status.toLowerCase() %> <%- (attendanceMap[s.id]||'Present')===status?'selected':'' %>">
                  <input type="radio" name="statuses[s_<%- s.id %>]" value="<%- status %>" <%- (attendanceMap[s.id]||'Present')===status?'checked':'' %> style="position:absolute;opacity:0;pointer-events:none;width:0;height:0;">
                  <%- status %>
                </label>
                <% }) %>
              </div>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <div class="card-footer d-flex justify-content-between align-items-center">
      <button type="submit" class="btn btn-primary px-4"><i class="fa-solid fa-save me-1"></i>Save Attendance</button>
      <small class="text-muted"><i class="fa-solid fa-circle-info me-1"></i>Default status is 'Present' unless changed.</small>
    </div>
  </div>
</form>
<% } else if(class_id) { %>
<div class="alert alert-info">No students in this class.</div>
<% } %>

<script>
function markAll(status) {
  document.querySelectorAll(`input[value="${status}"]`).forEach(r => {
    r.checked = true;
    r.closest('td').querySelectorAll('.att-label').forEach(l => l.classList.remove('selected'));
    r.parentElement.classList.add('selected');
  });
}

document.querySelectorAll('.att-label').forEach(l => {
  l.addEventListener('click', function(e) {
    const radio = this.querySelector('input[type="radio"]');
    if (radio) {
      radio.checked = true;
    }
    const group = this.closest('.att-buttons');
    if (group) {
      group.querySelectorAll('.att-label').forEach(x => x.classList.remove('selected'));
      this.classList.add('selected');
    }
  });
});
</script>
