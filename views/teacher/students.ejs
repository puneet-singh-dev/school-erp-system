<div class="mb-4"><h5 class="fw-bold mb-0"><i class="fa-solid fa-users me-2"></i>My Students</h5></div>
<div class="card shadow-sm">
  <div class="card-body p-0">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-dark"><tr><th>#</th><th>Name</th><th>Adm. No</th><th>Class</th><th>Phone</th></tr></thead>
      <tbody>
        <% students.forEach((s,i) => { %>
        <tr>
          <td><%- i+1 %></td>
          <td><div class="avatar-circle me-2"><%- s.name.charAt(0) %></div><%- s.name %></td>
          <td><%- s.admission_no %></td>
          <td><%- s.class_name %> - <%- s.section %></td>
          <td><%- s.phone||'-' %></td>
        </tr>
        <% }) %>
        <% if(!students.length) { %><tr><td colspan="5" class="text-center py-4 text-muted">No students in your classes</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>
