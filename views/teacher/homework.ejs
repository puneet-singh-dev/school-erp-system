<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h5 class="fw-bold mb-1"><i class="fa-solid fa-book-open text-primary me-2"></i>Homework &amp; Assignments</h5>
    <small class="text-muted">Assign homework to your classes and review existing tasks</small>
  </div>
  <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#teacherHomeworkModal">
    <i class="fa-solid fa-plus me-1"></i>Assign Homework
  </button>
</div>

<!-- Modal: Assign Homework -->
<div class="modal fade" id="teacherHomeworkModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h6 class="modal-title fw-bold"><i class="fa-solid fa-file-circle-plus me-2"></i>Post New Homework</h6>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <form action="/teacher/homework/add" method="POST">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label fw-semibold">Class *</label>
            <select name="class_id" class="form-select" required>
              <option value="">-- Select Class --</option>
              <% classes.forEach(c => { %>
                <option value="<%- c.id %>"><%- c.name %> - <%- c.section %></option>
              <% }) %>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Subject</label>
            <select name="subject_id" class="form-select">
              <option value="">-- General / Optional --</option>
              <% mySubjects.forEach(s => { %>
                <option value="<%- s.id %>"><%- s.name %></option>
              <% }) %>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Homework Title *</label>
            <input type="text" name="title" class="form-control" placeholder="e.g. Chapter 4 Practice Questions" required>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Instructions / Description *</label>
            <textarea name="description" rows="3" class="form-control" placeholder="Detailed guidelines for students..." required></textarea>
          </div>
          <div class="row g-2">
            <div class="col-6">
              <label class="form-label fw-semibold">Assigned Date</label>
              <input type="date" name="assigned_date" class="form-control" value="<%- new Date().toISOString().split('T')[0] %>">
            </div>
            <div class="col-6">
              <label class="form-label fw-semibold">Due Date *</label>
              <input type="date" name="due_date" class="form-control" required min="<%- new Date().toISOString().split('T')[0] %>">
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary"><i class="fa-solid fa-check me-1"></i>Publish Homework</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Homework List Table -->
<div class="card shadow-sm border-0">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Class</th>
            <th>Subject &amp; Title</th>
            <th>Instructions</th>
            <th>Assigned</th>
            <th>Due Date</th>
          </tr>
        </thead>
        <tbody>
          <% if(homeworkList && homeworkList.length > 0) { %>
            <% homeworkList.forEach(hw => { %>
              <tr>
                <td><span class="badge bg-primary"><%- hw.class_name %> - <%- hw.section %></span></td>
                <td>
                  <div class="fw-bold text-dark"><%- hw.title %></div>
                  <small class="text-muted"><%- hw.subject_name || 'General' %></small>
                </td>
                <td class="small" style="max-width: 320px;"><%- hw.description %></td>
                <td><small class="text-muted"><%- new Date(hw.assigned_date).toLocaleDateString('en-IN') %></small></td>
                <td>
                  <strong class="text-danger small"><%- new Date(hw.due_date).toLocaleDateString('en-IN') %></strong>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="5" class="text-center text-muted py-5">
                No homework assignments posted yet.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
