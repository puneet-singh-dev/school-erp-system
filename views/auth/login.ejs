<div class="auth-container">
  <div class="auth-card">
    <div class="auth-logo text-center">
      <img src="/img/logo.png" alt="<%- schoolName %>" class="rounded-circle bg-white p-2 shadow-sm mb-2" style="width: 80px; height: 80px; object-fit: contain;">
      <h4 class="mt-2 fw-bold text-dark"><%- schoolName %></h4>
      <p class="text-muted small">Vijay Nagar, Karma Bazar, Prayagraj &bull; Session 2026-27</p>
    </div>

    <% if(success_msg && success_msg.length > 0) { %>
    <div class="alert alert-success"><i class="fa-solid fa-check-circle me-2"></i><%- success_msg %></div>
    <% } %>
    <% if(error_msg && error_msg.length > 0) { %>
    <div class="alert alert-danger"><i class="fa-solid fa-circle-xmark me-2"></i><%- error_msg %></div>
    <% } %>

    <form action="/login" method="POST">
      <div class="mb-3">
        <label class="form-label fw-semibold"><i class="fa-solid fa-user me-1"></i> Email or Admission Number</label>
        <input type="text" name="email" class="form-control form-control-lg" placeholder="Email or Student Admission No (e.g. ADM2601)" required autofocus>
      </div>
      <div class="mb-4">
        <label class="form-label fw-semibold"><i class="fa-solid fa-lock me-1"></i> Password / Reg. Mobile No</label>
        <div class="input-group">
          <input type="password" name="password" id="passwordInput" class="form-control form-control-lg" placeholder="Enter password (Reg. Mobile No for students)" required>
          <button class="btn btn-outline-secondary" type="button" onclick="togglePass()"><i class="fa-solid fa-eye" id="eyeIcon"></i></button>
        </div>
        <div class="small text-muted mt-2">
          <i class="fa-solid fa-circle-info text-primary me-1"></i>Students can login with their <strong>Admission Number</strong> and <strong>Registered Mobile Number</strong>. No email required!
        </div>
      </div>
      <button type="submit" class="btn btn-primary btn-lg w-100">
        <i class="fa-solid fa-right-to-bracket me-2"></i>Login
      </button>
    </form>

    <div class="mt-4 p-3 bg-light rounded">
      <small class="text-muted">
        <strong>Login Help:</strong><br>
        &bull; <strong>Admin:</strong> admin@school.com / admin123<br>
        &bull; <strong>Students:</strong> Admission No (e.g. ADM2601) &amp; Mobile No
      </small>
    </div>
  </div>
</div>

<script>
function togglePass() {
  const input = document.getElementById('passwordInput');
  const icon = document.getElementById('eyeIcon');
  if (input.type === 'password') { input.type = 'text'; icon.className = 'fa-solid fa-eye-slash'; }
  else { input.type = 'password'; icon.className = 'fa-solid fa-eye'; }
}
</script>
